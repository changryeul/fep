---
title: PA 파생 주문/체결 흐름도
---
graph TD
    KRX["KRX (파생상품)\nIMECO/KTS"]

    subgraph ORDER["주문 경로"]
        TS["pa_2101_ts\n파생주문송신\nType: TS2\n:13170"]
        QR["pa_5011_qr\n파생주문큐관리"]
        QS["pa_5211_qs\n파생주문확인송신"]
    end

    subgraph RESPONSE["응답 경로"]
        TR["pa_2201_tr\n파생응답수신\nType: TR2\n:13171"]
        MP_RESP["pa_2201_mp\n응답처리"]
        MP_UNCH["pa_2291_mp\n미체결"]
    end

    subgraph EXECUTION["체결 경로"]
        MP_EXEC["pa_2401_mp\n체결처리"]
        MP_SUM["pa_2491_mp\n요약"]
        MP_CALC["pa_2492_mp\n연산"]
        QS_EXEC["pa_5411_qs\n파생체결송신"]
    end

    TS -->|"TCP :13170"| KRX
    KRX -->|"TCP :13171"| TR

    TR -->|"FIFO"| MP_RESP
    TR -->|"FIFO"| MP_EXEC
    MP_RESP --> MP_UNCH

    TS -->|"FIFO"| QS
    QR -->|"DSHM"| TS

    MP_EXEC --> MP_SUM
    MP_EXEC --> MP_CALC

    subgraph OUTPUT["출력"]
        CL_TX["pa_8101_ts\nClient송신\n:32001"]
        HANDO["pa_9001_mp\n한도관리"]
        AUTO["pa_50xxx_mp\nAuto전략 x40"]
    end

    MP_RESP -->|"FIFO"| CL_TX
    MP_EXEC -->|"FIFO"| CL_TX
    MP_EXEC -->|"FIFO"| HANDO
    MP_UNCH -->|"DSHM"| AUTO
    MP_EXEC -->|"DSHM"| AUTO
    QS --> CL_TX
    QS_EXEC --> CL_TX

    CL_RX["pa_8201_tr\nClient수신\n:32011"] -->|"DSHM"| QR
    AUTO -->|"DSHM"| QR
