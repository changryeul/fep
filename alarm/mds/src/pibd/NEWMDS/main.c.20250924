//#######################################################################*/
#include <sys/syscall.h>

#include "agfix.h"
#include "eaiinfo.h"

#include "comdef.h"
#include "wfaapi.h"    // 실시간전송(Client)
#include "axsnd.h"
#include "mymq.h"
#include "agxpi.h"
#include "agtrc.h"
#include "comrdb.h"
#include "comhdr.h"
#include "comfun.h"
#include "killmon.h"

#include "mds2.h"
#define		MDSDQ_IDX_MAST		1		// DQ INDEX FOR handler_master
#define		MDSDQ_IDX_APSND		2		// DQ INDEX FOR handler_apsend
#define		MDSDQ_IDX_DBTBL		3		// DQ INDEX FOR handler_dbtable

AG_FIX		s_afix;
Ag_Fix		s_xfix;
TFILE		s_trcf;
TFile	_trcf_	=  (TFile) &s_trcf;

KILLMON_T		*root;
KILL_SWITCH_T	*pk=NULL;

MARKET	*market=NULL;
pthread_t	main_tid;

pthread_mutex_t		gmutex = PTHREAD_MUTEX_INITIALIZER;		// 쓰레드 생성 시 아규먼트 보장용

void exitproc(int );
void *handler_master(void *);
void *handler_apsend(void *);
void *handler_dbtable(void *);
void *handler_alarm(void *);
int sise2mds(char *excode, char *pbuff, int dlen, MDSSISE *psise);

static int conv_CMBS(char *pbuff, int dlen, MDSSISE *psise);
static int conv_SMBS(char *pbuff, int dlen, MDSSISE *psise);
static int conv_KMB(char *pbuff, int dlen, MDSSISE *psise);
static int conv_EBS(char *pbuff, int dlen, MDSSISE *psise);
static int conv_REUT(char *pbuff, int dlen, MDSSISE *psise);

/*===============================================================
 * EXITPROC
===============================================================*/
void exitproc(int exitval)
{
	char		TZ[40];
	
	if (market)
	{
		mds_log(market, MLOG_ERROR, "Program Terminated.. exitval [%d]\n\n", exitval);

		//pthread_mutex_lock(&market->ctx.lock);
		shmdt(market->arch);
		//pthread_mutex_unlock(&market->ctx.lock);
		
		free(market);
	}

	pthread_mutex_unlock(&gmutex);
	pthread_mutex_destroy(&gmutex);

	sprintf(TZ, TZ_KST);
	putenv(TZ);
	tzset();
	
	printf("\nProgram Terminated.. exitval[%d]\n\n", exitval);
	
	exit(exitval);
}

/*===============================================================
 * MAIN PROCESS
===============================================================*/
int main(int argc, char *argv[])
{
	int		rc;	
	char	exnm[40];
	char	pdesc[40]; //화면표시명
	char	procnm[40];
	MARKET	m;
	MDARCH	*arch;
	INDEX	*indx;
	XCHG	*xchg;
	
	memset(exnm,	0x00, sizeof(exnm));
	memset(pdesc,	0x00, sizeof(pdesc));
	memset(procnm,	0x00, sizeof(procnm));
	memset(&m,		0x00, sizeof(MARKET));

	/*===============================================================
	 * PROCESS 초기화
	===============================================================*/
	if (argc < 2)
	{
		printf("\n\t Usage : %s [SMBS/KMB/CMBS/EBS/CUST/BEST] \n", argv[0]);
		exitproc(-1);
	}

	strcpy(m.procname, basename(argv[0]));
	strcpy(m.exnm, argv[1]);

	mds_log(&m, MLOG_MUST, "Start....!");

	root = InitKillMon();
	if(root == NULL) // 실패
	{
		mds_log(&m, MLOG_ERROR, "InitKillMon() Failed!");
		exitproc(-2);
	}
	sprintf(procnm, "%s %s", m.procname, m.exnm);
	pk = AddKillMon(root, procnm);
	if(pk == NULL) // 실패
	{
		mds_log(&m, MLOG_ERROR, "AddKillMon() %s Failed!", m.procname);
		exitproc(-3);
	}
	mds_log(&m, MLOG_MUST, "AddKillMon() %s Success!", m.procname);
	sprintf(pk->pdesc, "%s 시세수신", argv[1]);

	pk->priority = 8000;

	// MAIN THREAD TID
	main_tid = pthread_self();

	signal(SIGTERM, exitproc);
//	signal(SIGINT , exitproc);
//	signal(SIGQUIT, exitproc);

	/*===============================================================
	 * MARKET SHM 초기화 (LoadMaster 로직 포함)
	===============================================================*/
	strcpy(exnm, argv[1]);
	if ((market = mds_open2(exnm, O_RDWR|O_CREAT)) == NULL)
	{
		mds_log(&m, MLOG_ERROR, "Cannot open market '%s'", exnm);
		exitproc(-4);
	}

	mds_log(market, MLOG_MUST, "Start to receive market data for '%s'", exnm);
	
	arch = (MDARCH *)market->arch;
	indx = (INDEX  *)market->indx;
	xchg = (XCHG *)&arch->xchg;

	/*===============================================================
	 * FIX 전문 변환용 로컬메모리 초기화
	===============================================================*/
	// init log file
	rc = agxpi_tfile_vinit (_trcf_, LOG_DIR, AG_NULL, AG_HOME, TRC_DIR, AGINI_GID, AGINI_SGI, AGINI_MYI,TDAT, DALL);
	agtrc_open (AG_NULL, _trcf_);
	
	// start message
	agtrc_msg (_trcf_, AGINI_GID, AGINI_SGI, AGINI_MYI, 0, 0, TDBG, "fixgetval START\n");
	mxzinit(s_afix);
	s_xfix = (Ag_Fix) &s_afix;

	rc = agfix_at (s_xfix, AFIX_MAT_INIT);
	if (rc)
	{
		agtrc_msg (_trcf_, AGINI_GID, AGINI_SGI, AGINI_MYI, 0, 0, TERR, "agfix_at ERROR-R:%d E:%d ...\n", rc, errno);
		exitproc(-5);
	}

// ★TODO-04 : 실행 시 옵션에 따른 동작 구분
//  > DB처리는 CUST 만 
	/*===============================================================
	 * UDP 서버기동 : 수신준비
	  > ctx->sock 을 로컬변수로 변경
	===============================================================*/
	int		r_sock, bsize, options = 1;
	struct	sockaddr_in svrsock, clisock;
	struct	ip_mreq ip_mreq;
	socklen_t socklen = sizeof(svrsock);
	
	size_t	stacksize;
	in_addr_t addr, f, t;
	pthread_attr_t attr;

	memset(&svrsock, 0, sizeof(svrsock));
	memset(&clisock, 0, sizeof(clisock));	

	// use UDP direct
	f = ntohl(inet_addr(MULTICAST_F));
	t = ntohl(inet_addr(MULTICAST_T));

	addr = ntohl(inet_addr(xchg->from.ipad));
	if (addr >= f && addr <= t)
	{
		// multicasting
		if ((r_sock = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP)) < 0)
		{
			mds_log(market, MLOG_ERROR, "Cannot open a socket for %s.%d", xchg->from.ipad, xchg->from.port);
			exitproc(-6);
		}

		svrsock.sin_family = AF_INET;
		//sockin.sin_addr.s_addr = INADDR_ANY;
		svrsock.sin_addr.s_addr = inet_addr(xchg->from.ipad);
		svrsock.sin_port = htons(xchg->from.port);

		options = 1;
		setsockopt(r_sock, SOL_SOCKET, SO_REUSEADDR, &options, sizeof(options));
		
		if (bind(r_sock, (struct sockaddr *)&svrsock, sizeof(svrsock)) != 0)
		{
			mds_log(market, MLOG_ERROR, "Cannot bind a socket for %s.%d", xchg->from.ipad, xchg->from.port);
			close(r_sock);
			exitproc(-7);
		}
		ip_mreq.imr_multiaddr.s_addr = inet_addr(xchg->from.ipad);
		ip_mreq.imr_interface.s_addr = INADDR_ANY;
		if (setsockopt(r_sock, IPPROTO_IP, IP_ADD_MEMBERSHIP, (void *)&ip_mreq, sizeof(ip_mreq)) != 0)
		{
			mds_log(market, MLOG_ERROR, "Cannnot add a multicast member for %s.%d", xchg->from.ipad, xchg->from.port);
			close(r_sock);
			exitproc(-8);
		}
		mds_log(market, MLOG_MUST, "Start to receive from %s.%d", xchg->from.ipad, xchg->from.port);
	}
	else
	{
		// broadcasting or unicasting
		if ((r_sock = socket(AF_INET, SOCK_DGRAM, 0)) < 0)
		{
			mds_log(market, MLOG_ERROR, "Cannot open a socket for a port %d", xchg->from.port);
			exitproc(-9);
		}

		svrsock.sin_family = AF_INET;
		svrsock.sin_addr.s_addr = INADDR_ANY;
		svrsock.sin_port = htons(xchg->from.port);
		options = 1;
		setsockopt(r_sock, SOL_SOCKET, SO_REUSEADDR, &options, sizeof(options));

		if (bind(r_sock, (struct sockaddr *)&svrsock, sizeof(svrsock)) != 0)
		{
			mds_log(market, MLOG_ERROR, "Cannot bind a socket for a port %d", xchg->from.port);
			close(r_sock);
			exitproc(-10);
		}
		mds_log(market, MLOG_MUST, "Start to receive from UDP port %d", xchg->from.port);
	}

	bsize = 1024 * 1024;
	setsockopt(r_sock, SOL_SOCKET, SO_RCVBUF, &bsize, sizeof(int));

	// 소켓타임아웃 설정
	struct timeval	tmout;

	tmout.tv_sec  = 5;
	tmout.tv_usec = 0;
	if (setsockopt(r_sock, SOL_SOCKET, SO_RCVTIMEO, &tmout, sizeof(tmout)) != 0)
	{
		mds_log(market, MLOG_ERROR, "setsockopt timeout error [%s]", strerror(errno));
		close(r_sock);
		exitproc(-11);
	}

	/*===============================================================
	 * UDP 클라이언트 : 송신준비
	  > CUST, BEST 데이터 송신 용
	===============================================================*/
	int		csock, bsock;
	struct	sockaddr_in	bestsock, custsock;

	if (market->excode[0] != DF_EXCD_BEST && market->excode[0] != DF_EXCD_CUST)
	{
		memset(&bestsock, 0x00, sizeof(bestsock));
		memset(&custsock, 0x00, sizeof(custsock));

		custsock.sin_family       = AF_INET;
		custsock.sin_addr.s_addr  = inet_addr("127.0.0.1");	// 동일한 서버에 있음.
		custsock.sin_port         = htons(DF_CUSTPORT);
		if ((csock = socket(AF_INET, SOCK_DGRAM, 0)) < 0)
		{
			mds_log(market, MLOG_ERROR, "Cannot open a socket for a cust (%d) (%d:%s)", xchg->from.port, errno, strerror(errno));
			exitproc(-11);
		}

		bestsock.sin_family       = AF_INET;
		bestsock.sin_addr.s_addr  = inet_addr("127.0.0.1");	// 동일한 서버에 있음.
		bestsock.sin_port         = htons(DF_BESTPORT);
		if ((bsock = socket(AF_INET, SOCK_DGRAM, 0)) < 0)
		{
			mds_log(market, MLOG_ERROR, "Cannot open a socket for a best (%d) (%d:%s)", xchg->from.port, errno, strerror(errno));
			exitproc(-12);
		}
	}
	/*===============================================================
	 * QUEUE READ/WRITE COUNT RESET
	  > DQ API를 이용하여 카운트 리셋
	===============================================================*/
	struct msqid_ds		msg_ds;
	int		msqid;
	
	if ((msqid = msgget(IPCK(market->ipck, DF_SISEQ4MA), 0)) > 0)
		msgctl(msqid, IPC_RMID, &msg_ds);

	if ((msqid = msgget(IPCK(market->ipck, DF_SISEQ4AP), 0)) > 0)
		msgctl(msqid, IPC_RMID, &msg_ds);

	if ((msqid = msgget(IPCK(market->ipck, DF_SISEQ4DB), 0)) > 0)
		msgctl(msqid, IPC_RMID, &msg_ds);

	mds_log(market, MLOG_MUST, "(%s) message queue for (%s) is reset (0x%x/0x%x/0x%x)\n", __func__, market->exnm, 
		IPCK(market->ipck, DF_SISEQ4MA), IPCK(market->ipck, DF_SISEQ4AP), IPCK(market->ipck, DF_SISEQ4DB));

	/*===============================================================
	 * DB Connection
	===============================================================*/
	rc = l_db2connect();
	if (rc != 0)
	{
		mds_log(market, MLOG_ERROR, "[%s] DB connect failed : %d\n",__func__, rc);
		exitproc(-13);
	}
	char	ssid[128];
	memset(ssid, 0x00, sizeof(ssid));
//	_getDb2SessionID(ssid);

	mds_log(market, MLOG_MUST, "[%s] DB connect success ! [%s]", __func__, ssid);

	/*===============================================================
	 * THREAD CREATE
	  > REMOVE : syncer는 동작내용 없어 삭제.
	  > REMOVE : notifier에서 수신데이터 재전송할 ctx->posta.sock 는 호출부분 없어서 삭제

	  > handler_master() : MAST SHM 업데이트 및 실시간 패킷전송 전송
	  > handler_apsend() : AP서버용 실시간 패킷 생성 및 전송
	  > handler_dbtable() : DB 히스토리데이터 생성
	
	 * 핸들러별 시세큐 READ ID는 인자값이 아닌 define으로 정의
	===============================================================*/
	pthread_attr_init(&attr);
	pthread_attr_getstacksize(&attr, &stacksize);
	pthread_t	tid;
	int			ii, imod;

	if (stacksize < (2048*1024))
	{
		stacksize = 2048 * 1024;
		pthread_attr_setstacksize(&attr, stacksize);
	}

	for (ii = 0; ii < xchg->ma_pnum; ii++)
	{
		// 쓰레드 실행 후 ii++ 이 먼저 반영되어 쓰레드 안에서는 ++ 이 된 값을 받는 현상으로 인해 별도 변수를 둠.
		pthread_mutex_lock(&gmutex);
		pthread_create(&tid, &attr, handler_master, (void *)&ii);
//mds_log(market, MLOG_DEBUG, "(%s) pthread_create handler_master (%d/%d/%u)", __func__, ii, imod, tid);
//		usleep(500000);
	}

	// 체결데이터(35=X) 의 실시간, DB처리 용도로 변경되어 단수 실행만 해도 됨
	for (ii = 0; ii < xchg->ap_pnum; ii++)
	{
		pthread_mutex_lock(&gmutex);
		pthread_create(&tid, &attr, handler_apsend, (void *)&ii);
//mds_log(market, MLOG_DEBUG, "(%s) pthread_create handler_apsend (%d/%d/%u)", __func__, ii, imod, tid);
	}

	for (ii = 0; ii < xchg->db_pnum; ii++)
	{
		pthread_mutex_lock(&gmutex);
		pthread_create(&tid, &attr, handler_dbtable, (void *)&ii);
//mds_log(market, MLOG_DEBUG, "(%s) pthread_create handler_dbtable (%d/%d/%u)", __func__, ii, imod, tid);
		usleep(500000);
	}

	// 24.07.29) 이상호가 수신 감시 쓰레드 (LP 원천 수신 데몬만 실행)
	if (market->excode[0] != DF_EXCD_CUST && market->excode[0] != DF_EXCD_BEST)
		pthread_create(&tid, &attr, handler_alarm, (void *)NULL);

	/*===============================================================
	 * MAIN PROCESS (시세수신)
	  > UDP 수신 처리는 멀티쓰레드가 아니므로 main() 내에서 처리함
	===============================================================*/
	int		rtn, dlen;
	char	rbuff[MAX_PACKET_SIZE+512];	// FIX DATA
	char	sbuff[512];				// MDSSISE
	char	ctime [14], rejmsg[128];
	struct	timeval rtime;
	struct tm *lt;
	
	WFA_HDL wfah_sise  = {0,};		// 시세 전송  Queue
	WFA_HDL wfah_best  = {0,};		// BEST 전송  Queue
	WFA_HDL wfah_cust  = {0,};		// CUST 전송  Queue
	MDSSISE	*psise;
	MDFOLD	*pfold, *cfold=NULL;
	MDARCH	*carch=NULL;

	// CUST 전송 전 체크를 위한 CUST 마스트메모리 attach
	if (market->excode[0] != DF_EXCD_CUST)
	{
		if ((carch = mds_getarch(0, DF_EXNM_CUST, rejmsg)) == NULL)
		{
			mds_log(market, MLOG_ERROR, "### attach CUST mast error (%s) !!!!", rejmsg);
			exitproc(-14);
		}
	}
	psise = (MDSSISE *)sbuff;

	while (1)
	{
		/*===============================================================
		 * UDP 시세 수신
		===============================================================*/
		memset(rbuff, 0x00, sizeof(rbuff));
		
		dlen = recv(r_sock, rbuff, sizeof(rbuff), 0);
		if (dlen < 0)
		{
			if (errno == EINTR || errno == EAGAIN)		continue;

			break;
		}

		gettimeofday(&rtime, NULL);
		lt = localtime(&rtime.tv_sec);

//		arch->rtim = rtime.tv_sec;
//		arch->rsum++;

		// KILL SWITCH UPDATE
		pk->tot_count = arch->rsum;
		pk->tot_count_time = rtime.tv_sec;

//mds_log(market, 0, "[%s:%d] RECEIVE DATA (%d:%.*s)", __func__, arch->rsum, dlen, dlen, rbuff);

		/*===============================================================
		 * FIX FORMAT CONVERT
		===============================================================*/
		memset(sbuff, 0x00, sizeof(sbuff));

		rtn = sise2mds(xchg->excode, rbuff, dlen, psise);
		if (rtn != 0)
		{
			mds_log(market, MLOG_WARNING, "Receive Data Convert Error (%d)", rtn);
			continue;
		}

//============================================================
// USDCNH 수신 시 USDCNY 코드로 한번 더 송신하기 위해 사용 함
//============================================================
SendUSDCNY :

		/*===============================================================
		 * 시세 QUEUE PUSH
		===============================================================*/
		// 해당 통화쌍의 SHM(FOLD) GET, symb의 indx 에 따라 쓰레드별 msg.type 분배
		if ((pfold = mds_getfolder((MDARCH *)market->arch, psise->symb)) == NULL)
		{
			mds_log(market, MLOG_WARNING, "mds_getfolder error [%.7s]", psise->symb);
			continue;
		}

		// 해당 통화에 대한 거래불가 세팅되어 있는 경우, 모든 시세 SKIP
		// TSKEIAM88.TRNABIL_YN 컬럼 '0'=거래불가 인 경우 trdf=9 로 세팅됨(LoadMaster) trdf=0 은 시세수신여부의 대기 상태이므로 다름.
		if (pfold->trdf == 9)	continue;

		// ★TODO-19 : 기존 fetch.c:CheckQuotePrice()에 있던 BadTick 필터링 로직 추가 필요
		rtn = mds_sise_valid(market, pfold, psise);
		if (rtn != 0)
		{
			mds_log(market, MLOG_QLOG, "mds_sise_valid failed.. [%d] (%.30s) (%.1s/%.6s/%.8s/%.9s] bid:ask[%.6f:%.6f]", rtn, psise->quotid, 
						psise->excode, psise->symb, psise->date, psise->time, psise->bidprc, psise->offerprc);
			continue;
		}

		// CUST, BEST와 시세 카운트 합산을 위해 위치 이동 (USDCNY는 제외)
		if (memcmp(psise->symb, "USDCNY", 6) != 0) {
			arch->rtim = rtime.tv_sec;
			arch->rsum++;
		}

if (psise->excode[0] == DF_EXCD_HAND || pfold->filler[0] == DF_C_ON)
mds_log(market, MLOG_QLOG, "[%s:%s] RCV(%d:%.9s)=[%d:%.1s/%.6s/%.8s/%.9s/%.6f/%.f/%.6f/%.f]", __func__, xchg->exnm, arch->rsum, psise->quotid, pfold->seqn
			, psise->excode, psise->symb, psise->date, psise->time, psise->bidprc, psise->bidqty, psise->offerprc, psise->offerqty);

		// 24.08.09) 소스 위치. 하단에서 현위치로 이동
		/*===============================================================
		 * UDP SEND TO CUST/BEST
		  > BEST호가는 BEST SHM 처리 데몬이 비교 후 처리 함.
		  > 모든 원천의 시세가 BEST 로 전송
		  > 각 원천데몬에서 CUST에 세팅된 cust.excode 값이 일치하면 CUST로 송신
		===============================================================*/
		if (market->excode[0] != DF_EXCD_CUST && market->excode[0] != DF_EXCD_BEST)
		{
			// CUST 전송
			// CHECK : 설정된 시간이 지난 상태에서 호가가 한번 더 나가야 CUST 에서 수신 후 SetCustFeed를 호출하기 때문에 LP변경이 늦어짐.
			//         기존 LP에서 더이상 시세가 들어오지 않으면 바뀌지 않음.
			//         모든 LP시세 전송하는 것으로 다시 변경함.
			//cfold = mds_getfolder(carch, psise->symb);
			//if(cfold != NULL && (market->excode[0] == cfold->cust.excode[0] || psise->excode[0] == DF_EXCD_HAND)) {
				rtn = sendto(csock, sbuff, SZ_MDSSISE, 0, (struct sockaddr *)&custsock, sizeof(custsock));
				if (rtn <  0)
					mds_log(market, MLOG_ERROR, "UDP SEND ERROR for CUST (%d) (%d:%s)", rtn, errno, strerror(errno));
			//}

			// BEST 전송
			rtn = sendto(bsock, sbuff, SZ_MDSSISE, 0, (struct sockaddr *)&bestsock, sizeof(bestsock));
			if (rtn <  0)
				mds_log(market, MLOG_ERROR, "UDP SEND ERROR for BEST (%d) (%d:%s)", rtn, errno, strerror(errno));
		}

//		imod = pfold->seqn % xchg->ma_pnum;

		/*===============================================================
		 * CUST시세처리 체크로직
		 * 각 핸들러로 전달 전에 체크하여 SKIP 처리
		 * 모든 원천의 시세를 UDP로 수신하기 때문에 시간대별로 대상 원천만 처리해야 함
		===============================================================*/
		if (market->excode[0] == DF_EXCD_CUST && psise->excode[0] != DF_EXCD_HAND)
		{
			char	ctime[14+1];
//			sprintf(ctime, "%.8s%.6s", psise->date, psise->time);		// YYYYMMDDHHmmSS
			sprintf(ctime, "%04d%02d%02d%02d%02d%02d", lt->tm_year+1900, lt->tm_mon+1, lt->tm_mday, lt->tm_hour, lt->tm_min, lt->tm_sec);

			// ★ CHECK : [1801] 화면에서 변경한 내용은 해당 서비스에서 API(mds_updt_custfeed) 호출하여 메모리 업데이트 하므로 
			//            항상 메모리의 stime,etime 을 기준으로 동작하여도 무관함.
			// 종료시간이 지난경우 시간 재조회 하여 세팅
			if (pfold->cust.feedtp[0] == DF_CFEED_STND && memcmp(pfold->cust.etm, ctime, sizeof(pfold->cust.etm)) < 0 &&
				memcmp(pfold->cust.etm, "00000000000000", sizeof(pfold->cust.etm)) != 0)
			{
mds_log(market, MLOG_DEBUG, "[%s] before SetCustFeed [%.1s/%.6s/%.8s/%.9s/%.6f/%.f/%.6f/%.f]", __func__, 
			psise->excode, psise->symb, psise->date, psise->time, psise->bidprc, psise->bidqty, psise->offerprc, psise->offerqty);
				SetCustFeed(market, pfold);
			}

			switch (pfold->cust.feedtp[0])
			{
			case DF_CFEED_STOP :		// 시세처리 안함
				continue;
			case DF_CFEED_HAND :		// 시간에 관계없이 수기시세만 처리
				if (psise->excode[0] != DF_EXCD_HAND)	continue;
//				if (pfold->trdf == DF_OFF)	pfold->trdf = DF_ON;	// 수기수신 시 trdf 가능으로 변경 (update_master 에서 함)
				break;
			case DF_CFEED_PRIO :		// 시간에 관계없이 원천체크 후 처리
				if (psise->excode[0] != pfold->cust.excode[0])	continue;
				break;
			case DF_CFEED_STND :		// 시간과 원천 모두 체크
				if (psise->excode[0] != pfold->cust.excode[0] ||
					memcmp(pfold->cust.stm, ctime, sizeof(pfold->cust.stm)) >  0 ||
					memcmp(pfold->cust.etm, ctime, sizeof(pfold->cust.etm)) <= 0)
				continue;

				break;
			default :
				continue;
			}
		}

		// 각 handler로 시세 전달
		rtn = KBA_MDS_QUE_PUSH(market->ipck, pfold->seqn, sbuff, SZ_MDSSISE);
		if (rtn <  0)
		{
			mds_log(market, MLOG_ERROR, "KBA_MDS_QUE_PUSH : Send Error (%d)", rtn);
			continue;
		}
//mds_log(market, MLOG_DEBUG, "[%s] KBA_MDS_QUE_PUSH OK. (%d) (%d)", __func__, rtn, wfah_sise.rwno[0]);

		// USDCNY는 고객전용 시세 (USDCNH를 USDCNY로 카피하여 재처리)
		if (market->excode[0] == DF_EXCD_CUST && memcmp(psise->symb, "USDCNH", 6) == 0)
		{
			memcpy(psise->symb, "USDCNY", 6);
			goto SendUSDCNY ;
		}
// 24.08.09) sendto CUST, BEST 소스 위치 상단으로 이동
	}

	mds_log(market, MLOG_ERROR, "UDP 시세수신 BREAK. Call Termination function..");
	
	close(r_sock);

	exitproc(-99);
}

/*===============================================================
 * 마스터메모리 업데이트하고 실시간 패킷 생성 후 전송
===============================================================*/
void *handler_master(void *argv)
{
	int			rtn, dlen, idx, imod;
	key_t		ipck;
	pthread_t	tid;
	pid_t		lwp;
	char		rbuff[1024], sbuff[1024];
	struct pushdata		pushdata;
	WFA_HDL		wfah  = {0,};
	MDARCH		*arch;
	XCHG		*xchg;
	MDFOLD		*pfold, *pusdkrw;
	CUSTSISE	*pcust;
	MDSSISE		*psise;
	APSISE		*preal;
	
	idx   = *((int *)argv);

pthread_mutex_unlock(&gmutex);

	tid = pthread_self();
	pthread_detach(tid);

	lwp = syscall(SYS_gettid);
	
	arch  = (MDARCH *)market->arch;
	xchg  = (XCHG *)&arch->xchg;

	ipck  = IPCK(market->ipck, DF_SISEQ4MA);
	
mds_log(market, MLOG_MUST, "[%s:%d:%u] [%.1s/%s] thread start !!...(0x%0x)\n", __func__, idx, lwp, xchg->excode, xchg->exnm, ipck);

	/*===============================================================
	 * AP 데이터 전송을 위한 멀티캐스트 소켓 생성
	===============================================================*/
	int		c_sock, options = 1;
	struct	in_addr		localif;
	struct	sockaddr_in	multisock;
	
	memset(&multisock, 0x00, sizeof(multisock));
	memset(&localif,   0x00, sizeof(localif));

	if ((c_sock = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP)) < 0)
	{
		mds_log(market, MLOG_ERROR, "[%s:%u] Cannot open a socket for AP %s.%d", __func__, lwp, xchg->apsnd.ipad, xchg->apsnd.port);
		pthread_kill(main_tid, SIGTERM);
		pthread_exit(NULL);
	}
	
	multisock.sin_family		= AF_INET;
	multisock.sin_addr.s_addr	= inet_addr(xchg->apsnd.ipad);
	multisock.sin_port			= htons(xchg->apsnd.port);
	
	// LOOPBACK OPTION OFF
	options = 1;
	if (setsockopt(c_sock, IPPROTO_IP, IP_MULTICAST_LOOP, (void *)&options, sizeof(options)) != 0)
	{
		mds_log(market, MLOG_ERROR, "[%s:%u] (%d) Set socketoption Failed. %s.%d (%s)", __func__, lwp, __LINE__, xchg->apsnd.ipad, xchg->apsnd.port, strerror(errno));
		close(c_sock);
		pthread_kill(main_tid, SIGTERM);
		pthread_exit(NULL);
	}

	// TTL OPTION = 1
	options = 1;
	if (setsockopt(c_sock, IPPROTO_IP, IP_MULTICAST_TTL, (void *)&options, sizeof(options)) != 0)
	{
		mds_log(market, MLOG_ERROR, "[%s:%u] (%d) Set socketoption Failed. %s.%d (%s)", __func__, lwp, __LINE__, xchg->apsnd.ipad, xchg->apsnd.port, strerror(errno));
		close(c_sock);
		pthread_kill(main_tid, SIGTERM);
		pthread_exit(NULL);
	}

	mds_log(market, MLOG_MUST, "[%s:%u] READY TO SEND DATA TO AP %s.%d", __func__, lwp, xchg->apsnd.ipad, xchg->apsnd.port);

	/*===============================================================
	 * SISE DATA RECEIVE LOOP START
	===============================================================*/
	psise = (MDSSISE *)rbuff;
	preal = (APSISE  *)sbuff;

	/*===============================================================
	 * USDKRW FOLDER 메모리 GET
	 * 모든 APSISE 패킷의 공통정보이므로 별도로 포인터 생성
	===============================================================*/
	if ((pusdkrw = mds_getfolder((MDARCH *)market->arch, DF_USDKRW)) == NULL)
	{
		mds_log(market, MLOG_ERROR, "[%s:%u] USDKRW : mds_getfolder error [%.7s]", __func__, lwp, DF_USDKRW);
		pthread_kill(main_tid, SIGTERM);
		pthread_exit(NULL);
	}

// ★TODO-03 : 초기 기동 시 큐의 readcnt = writecnt로 맞추는 기능 필요 (과거 데이터 전송 방지)

	while (1)
	{
		memset(rbuff, 0x00, sizeof(rbuff));
		memset(sbuff, 0x00, sizeof(sbuff));

		// SISE DATA POP
		//dlen = KBA_MDS_QUE_POP (&wfah, xchg->quenm, rbuff, SZ_MDSSISE, 0, MDSDQ_IDX_MAST);
		dlen = KBA_MDS_QUE_POP(ipck, (idx+1), rbuff, SZ_MDSSISE);
		if (dlen == 0)
		{
			mds_log(market, MLOG_WARNING, "[%s] KBA_MDS_QUE_POP timeout [%d]", __func__, dlen);
			continue;
		} 
		else if (dlen <  0)
		{
			mds_log(market, MLOG_ERROR, "[%s] KBA_MDS_QUE_POP error [%d]", __func__, dlen);
			break;
		}

		// 35=X 체결데이터는 SKIP
		if (psise->quotid[0] == 'X')	continue;

		// 해당 통화쌍의 SHM(FOLD) GET
		if ((pfold = mds_getfolder((MDARCH *)market->arch, psise->symb)) == NULL)
		{
			mds_log(market, MLOG_ERROR, "mds_getfolder error [%.7s]", psise->symb);
			continue;
		}

		// update_best()
		// 수신한 시세로 비교하는 것이 아니고, 데이터 발생 시점에 모든 원천의 동일 통화 마스터 비교 후 처리
		// 수신한 원천에서 마스터 처리전에 송신한 데이터 이므로 해당 원천 마스터에 반영되지 않았을 수 있음.
		if (market->excode[0] == DF_EXCD_BEST)
			rtn = update_best(market, pfold, psise);
		else
			rtn = update_master(market, pfold, psise);

if (psise->excode[0] == DF_EXCD_HAND || pfold->filler[0] == DF_C_ON)
	mds_log(market, MLOG_QLOG, "[%s:%d:%u] [%s] update_mast rtn=%d [%d/%.1s/%.6s] %.6f/%.f/%.6f/%.f", __func__, idx, lwp, xchg->exnm, rtn, 
				pfold->trdf, psise->excode, psise->symb, pfold->bidlast, pfold->bidvol, pfold->offerlast, pfold->offervol);

		// 호가가 변경된 경우만 실시간 처리 함
		// 24.07.08) 딜러가 보는 시장가격은 BEST 및 잔량도 봐야 하므로 SKIP 제거
		if ((market->excode[0] == DF_EXCD_CUST || market->excode[0] == DF_EXCD_BEST) && rtn == 0)	continue;	// 실시간 대상 아님.
		else if (rtn <0)
		{
			mds_log(market, MLOG_WARNING, "update_master error [%.7s]", psise->symb);
			//sleep(1);		continue;
			continue;
		}

		// PUSH REAL SISE FOR CUSTOMER
		memset(&pushdata, 0x00, sizeof(struct pushdata));

		pcust = (CUSTSISE *)(pushdata.pushmsg.msgb);
		
		rtn = make_cust_sise(market, pfold, psise, pcust);
		if (rtn < 0)
		{
			mds_log(market, MLOG_WARNING, "make_cust_sise error [%.7s]", psise->symb);
			//sleep(1);		continue;
			continue;
		}

		sprintf(pushdata.pushmsg.symb, "%.7s", pcust->rdcode);
		pushdata.mkid			= market->exid;
		pushdata.pushmsg.mask	= PUSH_QUOT;
		pushdata.pushmsg.type	= 'A';
		pushdata.pushmsg.msgl	= (SZ_CUSTSISE > MAX_PUSH_LEN ? MAX_PUSH_LEN : SZ_CUSTSISE);
		
		// SEND REAL TO MYMQ
		myrq_push(&pushdata);

		/*===============================================================
		 * 내부 AP 시세용 패킷 생성 후 전송
		===============================================================*/
		rtn = make_ap_sise(market, pfold, pusdkrw, psise, preal);
		if (rtn <0)
		{
			mds_log(market, MLOG_WARNING, "[%s:%u] make_ap_sise error [%.7s]", __func__, lwp, psise->symb);
			//sleep(1);		continue;
			continue;
		}

		if (sendto(c_sock, sbuff, sizeof(APSISE), 0, (struct sockaddr *)&multisock, sizeof(multisock)) < 0)
		{
// ★TODO-10 : handler_apsend()에서 송신 소켓 에러 시 재생성 로직 필요 (상단 소켓생성부분을 함수로 빼고 호출.)
			mds_log(market, MLOG_WARNING, "[%s:%u] sendto apsise error [%.7s] (%s)", __func__, lwp, psise->symb, strerror(errno));
			//sleep(1);		continue;
			continue;
		}

if (pfold->filler[0] == DF_C_ON)
mds_log(market, MLOG_QLOG, "[%s:%d:%u] [%s] myrq_push [%.7s] [%s:%s:%s]", __func__, idx, lwp,
			xchg->exnm, pcust->rdcode, pcust->symb, pcust->pbid, pcust->pask);
	} // while

	close(c_sock);
	
	mds_log(market, MLOG_MUST, "[%s:%d:%u] handler_master thread is terminated !!!", __func__, idx, lwp);
	
	pthread_kill(main_tid, SIGTERM);
	pthread_exit(NULL);	
}

/*===============================================================
 * AP전송용 패킷 생성 후 전송
 * ★★★ CHECK : 용도변경. 체결데이터(35=X) 처리 전용 handler
===============================================================*/
void *handler_apsend(void *argv)
{
	int		rtn, dlen, idx, imod;
	key_t		ipck;
	pthread_t	tid;
	pid_t		lwp;
	char	rbuff[1024], sbuff[1024];
	struct pushdata		pushdata;
	WFA_HDL	wfah  = {0,};
	MDFOLD		*pfold, *pusdkrw;
	MDARCH		*arch;
	XCHG		*xchg;
	MDSSISE		*psise;
	CUSTXSISE 	*preal;

	struct timeval	tv;
	struct tm *lt;

	idx = *((int *)argv);
	
pthread_mutex_unlock(&gmutex);
	
	tid = pthread_self();
	pthread_detach(tid);

	lwp = syscall(SYS_gettid);
	
	arch  = (MDARCH *)market->arch;
	xchg  = (XCHG *)&arch->xchg;

	ipck  = IPCK(market->ipck, DF_SISEQ4AP);

mds_log(market, MLOG_MUST, "[%s:%d:%u] [%.1s/%s] thread start !!...(0x%0x)\n", __func__, idx, lwp, xchg->excode, xchg->exnm, ipck);

	/*===============================================================
	 * DATABASE CONNET
// ★TODO-12 : 쓰레드가 각각의 connect 했을 경우 개별 동작에 문제없는지 테스트
	===============================================================*/
	rtn = l_db2connect();
	if (rtn != 0)
	{
		mds_log(market, MLOG_ERROR, "[%s:%d:%u] DB connect failed : %d\n",__func__, idx, lwp, rtn);
		pthread_kill(main_tid, SIGTERM);
		pthread_exit(NULL);
	}
	char	ssid[128];
	memset(ssid, 0x00, sizeof(ssid));
//	_getDb2SessionID(ssid);

	mds_log(market, MLOG_MUST, "[%s:%d:%u] DB connect success ! [%s]", __func__, idx, lwp, ssid);

	/*===============================================================
	 * SISE DATA RECEIVE LOOP START
	===============================================================*/
	psise = (MDSSISE *)rbuff;

// ★TODO-03 : 초기 기동 시 큐의 readcnt = writecnt로 맞추는 기능 필요 (과거 데이터 전송 방지)

	while (1)
	{
		memset(rbuff, 0x00, sizeof(rbuff));

		/*===============================================================
		 * 시세데이터 QUEUE POP
		===============================================================*/
		//dlen = KBA_MDS_QUE_POP (&wfah, xchg->quenm, rbuff, SZ_MDSSISE, 0, MDSDQ_IDX_APSND);
		dlen = KBA_MDS_QUE_POP(ipck, (idx+1), rbuff, SZ_MDSSISE);
		if (dlen == 0)
		{
			mds_log(market, MLOG_WARNING, "[%s:%u] KBA_MDS_QUE_POP timeout [%d]", __func__, lwp, dlen);
			continue;
		} 
		else if (dlen <  0)
		{
			mds_log(market, MLOG_ERROR, "[%s:%u] KBA_MDS_QUE_POP error [%d]", __func__, lwp, dlen);
			break;
		}

		// 원천 데몬인 경우만 실시간 처리 (고객쪽은 사용 안함)
		if (market->excode[0] == DF_EXCD_BEST || market->excode[0] == DF_EXCD_CUST)	continue;

		// 통화코드별 FOLDER GET
		if ((pfold = mds_getfolder((MDARCH *)market->arch, psise->symb)) == NULL)
		{
			mds_log(market, MLOG_WARNING, "[%s:%u] mds_getfolder error [%.7s]", __func__, lwp, psise->symb);
			continue;
		}

// 35=X 체결데이터 처리
if (psise->quotid[0] == 'X')
{
		// PUSH REAL SISE FOR CUSTOMER
		memset(&pushdata, 0x00, sizeof(struct pushdata));
		
		preal = (CUSTXSISE *)(pushdata.pushmsg.msgb);
		
		rtn = make_cust_xsise(market, pfold, psise, preal);
		if (rtn <0)
		{
			mds_log(market, MLOG_WARNING, "make_cust_xsise error [%.7s]", psise->symb);
			//sleep(1);		continue;
			continue;
		}
	
		sprintf(pushdata.pushmsg.symb, "%.7s", preal->rdcode);
		pushdata.mkid			= market->exid;
		pushdata.pushmsg.mask	= PUSH_QUOT;
		pushdata.pushmsg.type	= 'X';
		pushdata.pushmsg.msgl	= (SZ_CUSTXSISE > MAX_PUSH_LEN ? MAX_PUSH_LEN : SZ_CUSTXSISE);
		
		// SEND REAL TO MYMQ
		myrq_push(&pushdata);

		// DB 테이블 INSERT 처리 ##################################################################
		rtn = InsertTrdTick(psise);
		if (rtn < 0)	l_db2rollback();
}
else 
{
		gettimeofday(&tv, NULL);
		lt = localtime(&tv.tv_sec);

		// 24.07.08) SMBS 시세에 대해서만 MU59 북운영 평가금액 계산에 사용함.
		// 24.07.08) 18시 이후에는 갱신하지 않도록 함.
		if (xchg->excode[0] == 'S' && xchg->custflag == DF_C_ON && lt->tm_hour > 3 && lt->tm_hour < 18) {
			rtn = UpsertMU59(psise, pfold);
			if (rtn < 0)	l_db2rollback();
		}
}
		l_db2commit();
//mds_log(market, MLOG_DEBUG, "[%s] receive X .. myrq_push call..[%.7s]", __func__, preal->rdcode);

	} // while (KBA_MDS_QUE_POP)
	
	mds_log(market, MLOG_MUST, "[%s:%d:%u] handler_apsend thread is terminated !!!", __func__, idx, lwp);
	
	l_db2disconnect();

	pthread_kill(main_tid, SIGTERM);
	pthread_exit(NULL);
}

/*===============================================================
 * DB 데이터 생성
===============================================================*/
void *handler_dbtable(void *argv)
{
	int		ii, rtn, dlen, idx, imod;
	key_t		ipck;
	pthread_t	tid;
	pid_t		lwp;
	char	rbuff[1024];
	WFA_HDL	wfah  = {0,};
	MDFOLD	*pfold, *pusdkrw;
	MDARCH	*arch;
	INDEX	*indx;
	XCHG	*xchg;
	MDSSISE	*psise;

	idx = *((int *)argv);

pthread_mutex_unlock(&gmutex);

	tid = pthread_self();
	pthread_detach(tid);

	lwp = syscall(SYS_gettid);

	indx  = (INDEX  *)market->indx;
	arch  = (MDARCH *)market->arch;
	xchg  = (XCHG   *)&arch->xchg;

	ipck  = IPCK(market->ipck, DF_SISEQ4DB);

mds_log(market, MLOG_MUST, "[%s:%d:%u] [%.1s/%s] thread start !!...(0x%0x)\n", __func__, idx, lwp, xchg->excode, xchg->exnm, ipck);
	/*===============================================================
	 * DATABASE CONNET
// ★TODO-12 : 쓰레드가 각각의 connect 했을 경우 개별 동작에 문제없는지 테스트
	===============================================================*/
	rtn = l_db2connect();
	if (rtn != 0)
	{
		mds_log(market, MLOG_ERROR, "[%s:%d:%u] DB connect failed : %d\n",__func__, idx, lwp, rtn);
		pthread_kill(main_tid, SIGTERM);
		pthread_exit(NULL);
	}
	char	ssid[128];
	memset(ssid, 0x00, sizeof(ssid));
//	_getDb2SessionID(ssid);

	mds_log(market, MLOG_MUST, "[%s:%d:%u] DB connect success ! [%s]", __func__, idx, lwp, ssid);

	/*===============================================================
	 * USDKRW FOLDER 메모리 GET
	 * 모든 통화의 재정TICK을 위해 고정으로 필요함. 별도로 포인터 생성
	===============================================================*/
	if ((pusdkrw = mds_getfolder((MDARCH *)market->arch, DF_USDKRW)) == NULL)
	{
		mds_log(market, MLOG_ERROR, "[%s:%d:%u] USDKRW : mds_getfolder error [%.7s]", __func__, idx, lwp, DF_USDKRW);
		pthread_kill(main_tid, SIGTERM);
		pthread_exit(NULL);
	}

	/*===============================================================
	 * SISE DATA RECEIVE LOOP START
	===============================================================*/
	psise = (MDSSISE *)rbuff;
	
// ★TODO-03 : 초기 기동 시 큐의 readcnt = writecnt로 맞추는 기능 필요 (과거 데이터 전송 방지)
	while (1)
	{
		memset(rbuff, 0x00, sizeof(rbuff));

		/*===============================================================
		 * 시세데이터 QUEUE POP
		===============================================================*/
		//dlen = KBA_MDS_QUE_POP (&wfah, xchg->quenm, rbuff, SZ_MDSSISE, 0, MDSDQ_IDX_DBTBL);
		dlen = KBA_MDS_QUE_POP(ipck, (idx+1), rbuff, SZ_MDSSISE);
		if (dlen == 0)
		{
			mds_log(market, MLOG_WARNING, "[%s:%d:%u] KBA_MDS_QUE_POP timeout [%d]", __func__, idx, lwp, dlen);
			continue;
		}
		else if (dlen <  0)
		{
			mds_log(market, MLOG_ERROR, "[%s:%d:%u] KBA_MDS_QUE_POP error [%d]", __func__, idx, lwp, dlen);
			break;
		}

		// 35=X 체결데이터는 SKIP
		if (psise->quotid[0] == 'X')	continue;

		// 통화코드별 FOLDER GET
		if ((pfold = mds_getfolder((MDARCH *)market->arch, psise->symb)) == NULL)
		{
			mds_log(market, MLOG_WARNING, "[%s:%d:%u] mds_getfolder error [%.7s]", __func__, idx, lwp, psise->symb);
			continue;
		}

//mds_log(market, MLOG_DEBUG, "[%s:%d:%u] QUE_POP [%6s:%.9s]", __func__, idx, lwp, psise->symb, psise->time);
/* 메세지 큐로 변경되면서 큐type으로 분리해서 전송하기 때문에 읽을 때는 모두 읽으면 됨.
		// 쓰레드별 할당 대상 통화 체크
		imod = pfold->seqn % xchg->db_pnum;
		if (imod != idx)	continue;
*/
// ★TODO-07 : handler_apsend, handler_dbtable 에서도 종목별 시세 변동 시에만 처리하는 방안 강구 (직전 시세 비교 방안 필요)

		// 고객용인 경우만 DB 처리
		if (xchg->excode[0] != DF_EXCD_CUST)	continue;
		/*===============================================================
		 * DATABASE
		===============================================================*/
		rtn = InsertTick(psise, pfold);
		if (rtn < 0)	l_db2rollback();

		rtn = UpsertMin(psise, pfold);
		if (rtn < 0)	l_db2rollback();
		
		rtn = UpsertDay(psise, pfold);
		if (rtn < 0)	l_db2rollback();

		/*===============================================================
		 * 재정통화 생성 대상이면 재정 TICK DATA 생성
		 * 고객용인 경우만 재정통화 DB처리
		===============================================================*/
		if (iscrosstarget(psise->symb) == 0 && pusdkrw->trdf == DF_ON)
		{
			rtn = InsertTick_Fincl(psise, pfold, pusdkrw);
			if (rtn < 0)	l_db2rollback();

			rtn = UpsertMin_Fincl(psise, pfold, pusdkrw);
			if (rtn < 0)	l_db2rollback();

			rtn = UpsertDay_Fincl(psise, pfold, pusdkrw);
			if (rtn < 0)	l_db2rollback();
		}

		rtn=l_db2commit();

if (arch->rsum%1000 == 0)
mds_log(market, MLOG_DEBUG, "[%s:%d:%u] [%.1s:%s] insert/update DB [%.6s]", __func__, idx, lwp, xchg->excode, xchg->exnm, pfold->symb);

		if (memcmp(DF_USDKRW, psise->symb, 6) != 0)		continue;

		/*===============================================================
		 * USDKRW 시세인 경우에는 전체 재정통화 처리
		===============================================================*/		
		for (ii=0; ii < arch->nrec; ii++)
		{
			pfold = (MDFOLD *)(market->fold + (sizeof(MDFOLD) * (indx+ii)->indx));
			if (pfold->symb[0] == 0x00)		continue;

			/*===============================================================
			 * SKIP 대상 통화 체크
			  > 수신통화는 SKIP
			  > 시세 중지중인 종목 여부
			===============================================================*/
			// 대상 통화가 거래중단, 재정중단, 시세중지 상태이면 SKIP
			if (pfold->trdf == DF_OFF || pfold->cust.feedtp[0] == DF_CFEED_STOP || pfold->cust.finclstop[0] == DF_C_ON)
				continue;

			if (memcmp(pfold->symb, psise->symb, sizeof(pfold->symb)) == 0)
				continue;

			if (iscrosstarget(pfold->symb) != 0)
				continue;

			/*===============================================================
			 * 재정통화용 TICKDATA
			===============================================================*/
			rtn = InsertTick_Fincl(psise, pfold, pusdkrw);
			if (rtn < 0)	l_db2rollback();

			rtn = UpsertMin_Fincl(psise, pfold, pusdkrw);
			if (rtn < 0)	l_db2rollback();

			rtn = UpsertDay_Fincl(psise, pfold, pusdkrw);
			if (rtn < 0)	l_db2rollback();

		} // while for 재정통화

		l_db2commit();

	} // while (KBA_MDS_QUE_POP)
	
	mds_log(market, MLOG_MUST, "[%s:%d:%u] handler_dbtable thread is terminated !!!", __func__, idx, lwp);
	
	l_db2disconnect();
	
	pthread_kill(main_tid, SIGTERM);
	pthread_exit(NULL);
}

/*===============================================================
 * 24.07.29) 이상호가 감시 쓰레드 : DF_ALRM_TERM 초 이상 유지 시 알람
===============================================================*/
void *handler_alarm(void *argv)
{
	int		ii, rtn;
	char	alrmsg[128];
	time_t	t;
	pthread_t	tid;
	pid_t		lwp;

	tid = pthread_self();
	pthread_detach(tid);

	lwp = syscall(SYS_gettid);
	
mds_log(market, MLOG_MUST, "[%s:%u] [%.1s/%s] thread start !!...\n", __func__, lwp, market->excode, market->exnm);

	INDEX	*indx  = (INDEX  *)market->indx;
	MDARCH	*parch = (MDARCH *)market->arch;
	MDFOLD	*pfold;

	while (1)
	{
		t = time(0);

		for (ii=0; ii < parch->nrec; ii++)
		{
			pfold = (MDFOLD *)(market->fold + (sizeof(MDFOLD) * (indx+ii)->indx));
			if (pfold->symb[0] == 0x00)		continue;

			if (pfold->trdf != DF_ON || pfold->quotalarm == DF_OFF)
				continue;

			if (t - pfold->quotalarm > DF_ALRM_TERM)
			{
				sprintf(alrmsg, "%s|%.6s|%d|", parch->xchg.exnm, pfold->symb, t - pfold->quotalarm);
				if (mds_send_alarm(DF_ALRM_QUOT, alrmsg) == 0)	pfold->quotalarm = DF_OFF;
mds_log(market, MLOG_ERROR, "(%s) mds_send_alarm : [%.6s] (%s)", __func__, pfold->symb, alrmsg);
			}

		} // while for 재정통화

		sleep(10);
	}

	pthread_kill(main_tid, SIGTERM);
	pthread_exit(NULL);
}

/*===============================================================
 * 수신한 FIX 데이터를 내부 포맷으로 전환
===============================================================*/
static int conv_SMBS(char *pbuff, int dlen, MDSSISE *psise)
{
	int		ii, rc, nrec;
	uint32_t	ymd, hms;
	char    type[DF_2], strval[64], strval2[64];
	char	symbol[ 7+1];
	struct tm *lt;

	memset(symbol, 0x00, sizeof(symbol));
	psise->excode[0] = 'S';				// 원천 : 'S'=SMB, 'K'=KMB, 'E'=EBS, 'C'=CMB

// ★TODO-08 : 데이터 원천에 따라 FIX패킷 Convert 시 분기로직 추가 : sise_fix2ecm()

	AFIX_TOK_SETVATINT(s_xfix, MsgSeqNum,				AG_ZERO, (double) EOF);
	AFIX_TOK_SETVATINT(s_xfix, LastMsgSeqNumProcessed,	AG_ZERO, (double) EOF);
	AFIX_TOK_SETVATINT(s_xfix, BeginSeqNo,				AG_ZERO, (double) EOF);
	AFIX_TOK_SETVATINT(s_xfix, EndSeqNo,				AG_ZERO, (double) EOF);
	AFIX_TOK_SETVATINT(s_xfix, NewSeqNo,				AG_ZERO, (double) EOF);

	agfix_token_cls(s_xfix);
	agfix_set_define_leg (s_xfix, NoMDEntries, AG_ZERO, (int *) AG_NULL, (int *) AG_NULL, (double) EOF);
	
	pbuff[dlen] = 0x00;
	rc = agfix_dec (s_xfix, pbuff, dlen+1, SOH, EQU, AG_ZERO);		
	if (rc) 
 	{
		mds_log(market, MLOG_WARNING, "[%s] agfix_dec error (%d) [%d:%s]",__func__, rc, dlen, pbuff);
		return (-1);
	}

	rc = AFIX_TOK_GETSTR (s_xfix, Symbol, AG_ZERO, symbol);
	if (rc != AG_OK)
	{
		mds_log(market, MLOG_WARNING, "[%s] AFIX_TOK_GETSTR error (%d) [%d:%s]",__func__, rc, dlen, pbuff);
		return (-1);
	}
	//mds_time(market, 0, &market->xymd, &market->xhms, &market->kymd, &market->khms);
	sprintf(psise->symb, "%.3s%.3s", symbol, &symbol[4]);

	mds_time(market, 0, &ymd, &hms, NULL, NULL);	// get local date & time
	sprintf (psise->date, "%08d", ymd);

	struct timeb itb;
	ftime(&itb);

	lt = localtime(&itb.time);
	sprintf (psise->time, "%02d%02d%02d%03d",lt->tm_hour,lt->tm_min,lt->tm_sec,itb.millitm);
	//AFIX_TOK_GETSTR (s_xfix, SendingTime, AG_ZERO, g_time);	

	nrec = AG_ZERO;
	rc = AFIX_TOK_GETINT (s_xfix, NoMDEntries, AG_ZERO, nrec);
	if (rc != AG_OK)	nrec = AG_ONE;

	for (ii = 0; ii < nrec; ii++)
	{
		MXZINIT (type); 
		AFIX_TOK_GETSTR (s_xfix, MDEntryType, ii, type);

		switch (type[0])
		{
		case '0' :
// AFIX_TOK_GETDBL에서 잘못된 값이 리턴되어 STR로 처리후 변환
//			AFIX_TOK_GETDBL (s_xfix, 270, 			ii, psise->bidprc);
//			memset(strval, 0x00, sizeof(strval));
			AFIX_TOK_GETSTR (s_xfix, MDEntryPx, 	ii, strval);
			psise->bidprc = atof(strval);
//			AFIX_TOK_GETDBL (s_xfix, MDEntrySize, 	ii, psise->bidqty);
			AFIX_TOK_GETSTR (s_xfix, MDEntrySize, 	ii, strval);
			psise->bidqty = atof(strval);
			AFIX_TOK_GETSTR (s_xfix, MDEntryDate, 	ii, psise->biddate);
			AFIX_TOK_GETSTR (s_xfix, QuoteEntryID, 	ii, strval);		// psise->bidquoteid);
			sprintf(strval2, "%.1s.%.*s", psise->excode, sizeof(psise->quotid)-2, strval);
			memcpy(psise->quotid, strval2, strlen(strval2));			// excode + QuoteEntryID 로 채번
			AFIX_TOK_GETSTR (s_xfix, 9063,			ii, psise->bidsettype);
//			AFIX_TOK_GETDBL (s_xfix, 9064,			ii, psise->bidbestprc);
			AFIX_TOK_GETSTR (s_xfix, 9064,			ii, strval);
			psise->bidbestprc = atof(strval);
//			AFIX_TOK_GETDBL (s_xfix, 9065,			ii, psise->bidbestqty);
			AFIX_TOK_GETSTR (s_xfix, 9065,			ii, strval);
			psise->bidbestqty = atof(strval);
			//bid시세가 없어서 임시추가 

			if (memcmp(psise->symb, "USDKRW", 6) == 0)
			{
//				AFIX_TOK_GETDBL (s_xfix, 9065, ii, psise->bidqty);
				AFIX_TOK_GETSTR (s_xfix, 9065, ii, strval);
				psise->bidqty = atof(strval);
			}
			break;

		case '1' :
//			AFIX_TOK_GETDBL (s_xfix, 270, 			ii, psise->offerprc);
//			memset(strval, 0x00, sizeof(strval));
			AFIX_TOK_GETSTR (s_xfix, MDEntryPx, 	ii, strval);
			psise->offerprc = atof(strval);
//			AFIX_TOK_GETDBL (s_xfix, MDEntrySize, 	ii, psise->offerqty);
			AFIX_TOK_GETSTR (s_xfix, MDEntrySize, 	ii, strval);
			psise->offerqty = atof(strval);
			AFIX_TOK_GETSTR (s_xfix, MDEntryDate, 	ii, psise->offerdate);
//			AFIX_TOK_GETSTR (s_xfix, QuoteEntryID, 	ii, psise->offerquoteid);
			AFIX_TOK_GETSTR (s_xfix, 9063,			ii, psise->offersettype);
//			AFIX_TOK_GETDBL (s_xfix, 9064,			ii, psise->offerbestprc);
			AFIX_TOK_GETSTR (s_xfix, 9064,			ii, strval);
			psise->offerbestprc = atof(strval);
//			AFIX_TOK_GETDBL (s_xfix, 9065,			ii, psise->offerbestqty);
			AFIX_TOK_GETSTR (s_xfix, 9065,			ii, strval);
			psise->offerbestqty = atof(strval);
		 	//offer시세가 없어서 임시추가 

			if (memcmp(psise->symb, "USDKRW", 6) == 0)
			{
//				AFIX_TOK_GETDBL (s_xfix, 9065, ii, psise->offerqty);
				AFIX_TOK_GETSTR (s_xfix, 9065, ii, strval);
				psise->offerqty = atof(strval);
			}
			break;

		case '2' :	// 35=X (MarketData Incremantal Refresh for Trade Summary)
//mds_log(market, MLOG_DEBUG, "[%s] receive X=[%.*s]", __func__, dlen, pbuff);
			// MDEntryDate, MDEntryTime 수신 데이터로 UPDATE
			// TODO : MDUpdateAction(279) : New,Change,Delete 에 대한 처리 필요한지 확인
			// TODO : AggressorSide(5797) : 0=No aggressor 에 대한 처리 필요한지 확인
			AFIX_TOK_GETSTR (s_xfix, MDEntryDate, 	ii, psise->date);
			// GMT시간이므로 GMT+9로 변형해야 국내시간 나오므로 서버시간으로 사용
			//AFIX_TOK_GETSTR (s_xfix, MDEntryTime, 	ii, strval);		// HHMMSS -> HHMMSSsss
			//sprintf(strval2, "%.6s000", strval);
			sprintf (strval2, "%02d%02d%02d%03d",lt->tm_hour,lt->tm_min,lt->tm_sec,itb.millitm);
			memcpy(psise->time, strval2, sizeof(psise->time));

			char	AggSide[8];

			AFIX_TOK_GETSTR (s_xfix, 5797, 	ii, AggSide);	// 0=No aggressor, 1=Buy, 2=Sell
			if (AggSide[0] == '1')
			{
				AFIX_TOK_GETSTR (s_xfix, MDEntryPx, 	ii, strval);
				psise->bidprc   = atof(strval);
				AFIX_TOK_GETSTR (s_xfix, MDEntrySize, 	ii, strval);		// always '0'
				psise->bidqty   = atof(strval);
				//MDUpdateAction=279
				AFIX_TOK_GETSTR (s_xfix, MDEntryDate, 	ii, psise->biddate);
				//AggressorSide=5797
				AFIX_TOK_GETSTR (s_xfix, 9063,			ii, psise->bidsettype);
			}
			else
			{
				AFIX_TOK_GETSTR (s_xfix, MDEntryPx, 	ii, strval);
				psise->offerprc = atof(strval);
				AFIX_TOK_GETSTR (s_xfix, MDEntrySize, 	ii, strval);		// always '0'
				psise->offerqty = atof(strval);
				//MDUpdateAction=279
				AFIX_TOK_GETSTR (s_xfix, MDEntryDate, 	ii, psise->offerdate);
				//AggressorSide=5797
				AFIX_TOK_GETSTR (s_xfix, 9063,			ii, psise->offersettype);
			}

			AFIX_TOK_GETSTR (s_xfix, MDEntryID, 	ii, strval);
			// quotID[0] 을 'X'로 세팅하여 기존 시세 데이터와 구분 함.
			sprintf(strval2, "X%.1s.%.*s", psise->excode, sizeof(psise->quotid)-3, strval);
			memcpy(psise->quotid, strval2, strlen(strval2));			// excode + QuoteEntryID 로 채번

			//TradeDate=75
			//FutSettDate=64

			break;
		}
	}

	// 24.08.26) BEST 값이 없으면 AVAIL 값으로 대체함.
	if (psise->bidbestprc   <= 0.)	psise->bidbestprc   = psise->bidprc;
	if (psise->offerbestprc <= 0.)	psise->offerbestprc = psise->offerprc;

	return 0;
}

static int conv_CMBS(char *pbuff, int dlen, MDSSISE *psise)
{
	char	strtmp[64], scode[7];
	struct tm *lt;
	struct timeb itb;
	Eai_keiif0020_olist		*peai;

	peai = (Eai_keiif0020_olist *)pbuff;

	psise->excode[0]	= 'C';

	memset(strtmp, 0x00, sizeof(strtmp));
	memset(scode,  0x00, sizeof(scode));
	memcpy(scode, peai->cncycd, sizeof(peai->cncycd));

	if (memcmp(scode, "GBP" ,3) == 0 ||memcmp(scode, "EUR" ,3) == 0 ||memcmp(scode, "AUD" ,3) == 0 ||memcmp(scode, "NZD" ,3) == 0 )
		sprintf(strtmp, "%.3s%.3s",scode, "USD");
	else if (memcmp(scode, "JPY" ,3) == 0 || memcmp(scode, "CHF" ,3) == 0 || memcmp(scode, "CAD" ,3) == 0 ||
			 memcmp(scode, "HKD" ,3) == 0 || memcmp(scode, "SEK" ,3) == 0 || memcmp(scode, "DKK" ,3) == 0 ||
			 memcmp(scode, "THB" ,3) == 0 || memcmp(scode, "SGD" ,3) == 0 )
		sprintf(strtmp, "%.3s%.3s", "USD", scode);
	else if (memcmp(scode, "CNY" ,3) ==0)
		sprintf(strtmp, "%.3s%.3s", "USD", scode);
	else if (memcmp(scode, "USD" ,3) ==0)
		sprintf(strtmp, "%.6s", "USDKRW");
	else
	{
		mds_log(market, MLOG_WARNING, "[%s] receive code error [%d:%s]",__func__, dlen, pbuff);
		return (-1);
	}

	memcpy(psise->symb, strtmp, sizeof(psise->symb));

	ftime(&itb);
	lt =localtime(&itb.time);
	sprintf (strtmp, "%02d%02d%02d%03d",lt->tm_hour,lt->tm_min,lt->tm_sec,itb.millitm);

	memcpy(psise->date, peai->baseYmd, sizeof(psise->date));
	memcpy(psise->time, strtmp, sizeof(psise->time));			// 수신시간 HHMMssSSS

	memcpy(psise->quotid, peai->anounNth, sizeof(peai->anounNth));
	psise->bidprc		= str2d(peai->buyPcstExrt, sizeof(peai->buyPcstExrt));
	psise->bidqty		= 0.;
	memcpy(psise->biddate, peai->baseYmd, sizeof(psise->date));
//	psise->bidsettype	
	psise->bidbestprc	= 0.;
	psise->bidbestqty	= 0.;
	psise->offerprc		= str2d(peai->sellPcstExrt, sizeof(peai->sellPcstExrt));
	psise->offerqty		= 0.;
	memcpy(psise->offerdate, peai->baseYmd, sizeof(psise->date));
//	psise->offersettype
	psise->offerbestprc	= 0.;
	psise->offerbestqty	= 0.;

	return 0;
}

// EAI로 수신하는 CMBS 시세 패킷 안에 로이터 환율이 있음.
static int conv_REUT(char *pbuff, int dlen, MDSSISE *psise)
{
	char	strtmp[64], scode[7];
	struct tm *lt;
	struct timeb itb;
	Eai_keiif0020_olist		*peai;

	peai = (Eai_keiif0020_olist *)pbuff;

	psise->excode[0]	= 'R';

	memset(strtmp, 0x00, sizeof(strtmp));
	memset(scode,  0x00, sizeof(scode));
	memcpy(scode, peai->cncycd, sizeof(peai->cncycd));

	if (memcmp(scode, "GBP" ,3) == 0 ||memcmp(scode, "EUR" ,3) == 0 ||memcmp(scode, "AUD" ,3) == 0 ||memcmp(scode, "NZD" ,3) == 0 )
		sprintf(strtmp, "%.3s%.3s",scode, "USD");
	else if (memcmp(scode, "JPY" ,3) == 0 || memcmp(scode, "CHF" ,3) == 0 || memcmp(scode, "CAD" ,3) == 0 ||
			 memcmp(scode, "HKD" ,3) == 0 || memcmp(scode, "SEK" ,3) == 0 || memcmp(scode, "DKK" ,3) == 0 ||
			 memcmp(scode, "THB" ,3) == 0 || memcmp(scode, "SGD" ,3) == 0 )
		sprintf(strtmp, "%.3s%.3s", "USD", scode);
	else if (memcmp(scode, "CNY" ,3) ==0)
		sprintf(strtmp, "%.3s%.3s", "USD", scode);
	else if (memcmp(scode, "USD" ,3) ==0)
		sprintf(strtmp, "%.6s", "USDKRW");
	else
	{
		mds_log(market, MLOG_WARNING, "[%s] receive code error [%d:%s]",__func__, dlen, pbuff);
		return (-1);
	}

	memcpy(psise->symb, strtmp, sizeof(psise->symb));

	ftime(&itb);
	lt =localtime(&itb.time);
	sprintf (strtmp, "%02d%02d%02d%03d",lt->tm_hour,lt->tm_min,lt->tm_sec,itb.millitm);

	memcpy(psise->date, peai->baseYmd, sizeof(psise->date));
	memcpy(psise->time, strtmp, sizeof(psise->time));			// 수신시간 HHMMssSSS

	memcpy(psise->quotid, peai->anounNth, sizeof(peai->anounNth));
	psise->bidprc		= str2d(peai->bnrt, sizeof(peai->bnrt));		// 로이터환율
	psise->bidqty		= 0.;
	memcpy(psise->biddate, peai->baseYmd, sizeof(psise->date));
//	psise->bidsettype	
	psise->bidbestprc	= 0.;
	psise->bidbestqty	= 0.;
	psise->offerprc		= str2d(peai->sellrt, sizeof(peai->sellrt));	// 로이터환율
	psise->offerqty		= 0.;
	memcpy(psise->offerdate, peai->baseYmd, sizeof(psise->date));
//	psise->offersettype
	psise->offerbestprc	= 0.;
	psise->offerbestqty	= 0.;

	return 0;
}

static int conv_EBS(char *pbuff, int dlen, MDSSISE *psise)
{
	int		ii, rc, nrec;
	uint32_t	ymd, hms;
	char    type[DF_2], strval[64], strval2[64];
	char	symbol[ 7+1];
	struct tm *lt;

	memset(symbol, 0x00, sizeof(symbol));
	psise->excode[0] = 'E';				// 원천 : 'S'=SMB, 'K'=KMB, 'E'=EBS, 'C'=CMB

// ★TODO-08 : 데이터 원천에 따라 FIX패킷 Convert 시 분기로직 추가 : sise_fix2ecm()

	AFIX_TOK_SETVATINT(s_xfix, MsgSeqNum,				AG_ZERO, (double) EOF);
	AFIX_TOK_SETVATINT(s_xfix, LastMsgSeqNumProcessed,	AG_ZERO, (double) EOF);
	AFIX_TOK_SETVATINT(s_xfix, BeginSeqNo,				AG_ZERO, (double) EOF);
	AFIX_TOK_SETVATINT(s_xfix, EndSeqNo,				AG_ZERO, (double) EOF);
	AFIX_TOK_SETVATINT(s_xfix, NewSeqNo,				AG_ZERO, (double) EOF);

	agfix_token_cls(s_xfix);
	agfix_set_define_leg (s_xfix, NoMDEntries, AG_ZERO, (int *) AG_NULL, (int *) AG_NULL, (double) EOF);
	
	pbuff[dlen] = 0x00;
	rc = agfix_dec (s_xfix, pbuff, dlen+1, SOH, EQU, AG_ZERO);		
	if (rc) 
 	{      
		mds_log(market, MLOG_WARNING, "[%s] agfix_dec error (%d) [%d:%s]",__func__, rc, dlen, pbuff);
		return (-1);
	}

	rc = AFIX_TOK_GETSTR (s_xfix, Symbol, AG_ZERO, symbol);
	if (rc != AG_OK)
	{
		mds_log(market, MLOG_WARNING, "[%s] AFIX_TOK_GETSTR error (%d) [%d:%s]",__func__, rc, dlen, pbuff);
		return (-1);
	}
	//mds_time(market, 0, &market->xymd, &market->xhms, &market->kymd, &market->khms);
	sprintf(psise->symb, "%.3s%.3s", symbol, &symbol[4]);

	AFIX_TOK_GETSTR (s_xfix, MDReqID, AG_ZERO, strval);
	sprintf(strval2, "%.1s.%.*s", psise->excode, sizeof(psise->quotid)-2, strval);
//	sprintf(strval2, "%.1s.%.12s", psise->excode, psise->time);
//	memcpy(psise->quotid, strval2, strlen(strval2));			// excode + HHMMssSSS 로 채번

	mds_time(market, 0, &ymd, &hms, NULL, NULL);	// get local date & time
	sprintf (psise->date, "%08d", ymd);

	struct timeb itb;
	ftime(&itb);

	lt = localtime(&itb.time);
	sprintf (psise->time, "%02d%02d%02d%03d",lt->tm_hour,lt->tm_min,lt->tm_sec,itb.millitm);
	//AFIX_TOK_GETSTR (s_xfix, SendingTime, AG_ZERO, g_time);	

	nrec = AG_ZERO;
	rc = AFIX_TOK_GETINT (s_xfix, NoMDEntries, AG_ZERO, nrec);
	if (rc != AG_OK)	nrec = AG_ONE;

	for (ii = 0; ii < nrec; ii++)
	{
		MXZINIT (type); 
		AFIX_TOK_GETSTR (s_xfix, MDEntryType, ii, type);

		switch (type[0])
		{
		case    '0' :
			AFIX_TOK_GETSTR (s_xfix, MDEntryPx, 	ii, strval);
			psise->bidprc = atof(strval);										// AFIX_TOK_GETDBL에서 잘못된 값이 리턴되어 STR로 처리후 변환
//			AFIX_TOK_GETDBL (s_xfix, MDEntrySize, 	ii, psise->bidqty);
			AFIX_TOK_GETSTR (s_xfix, MDEntrySize, 	ii, strval);
			psise->bidqty = atof(strval);
//			AFIX_TOK_GETSTR (s_xfix, MDEntryDate, 	ii, psise->biddate);		// 안들어옴 FutSettDate로 대체
			AFIX_TOK_GETSTR (s_xfix, FutSettDate, AG_ZERO, psise->biddate);		// FutSettDate (64)
//			AFIX_TOK_GETSTR (s_xfix, MDEntryID, 	ii, strval);				// 안들어옴

			AFIX_TOK_GETSTR (s_xfix, SettlmntTyp, AG_ZERO, psise->bidsettype);		// Instrument tenor.(63=0)
			psise->bidbestprc = 0.;		// 안들어옴.
			psise->bidbestqty = 0.;		// 안들어옴.

			break;

		case    '1' :
			AFIX_TOK_GETSTR (s_xfix, MDEntryPx, 	ii, strval);
			psise->offerprc = atof(strval);										// AFIX_TOK_GETDBL에서 잘못된 값이 리턴되어 STR로 처리후 변환
//			AFIX_TOK_GETDBL (s_xfix, MDEntrySize, 	ii, psise->bidqty);
			AFIX_TOK_GETSTR (s_xfix, MDEntrySize, 	ii, strval);
			psise->offerqty = atof(strval);
//			AFIX_TOK_GETSTR (s_xfix, MDEntryDate, 	ii, psise->biddate);		// 안들어옴 FutSettDate로 대체
			AFIX_TOK_GETSTR (s_xfix, FutSettDate, AG_ZERO, psise->offerdate);	// FutSettDate (64)
//			AFIX_TOK_GETSTR (s_xfix, MDEntryID, 	ii, strval);				// 안들어옴

			AFIX_TOK_GETSTR (s_xfix, SettlmntTyp, AG_ZERO, psise->offersettype);	// Instrument tenor.(63=0)
			psise->offerbestprc = 0.;		// 안들어옴.
			psise->offerbestqty = 0.;		// 안들어옴.
		
			break;
		case	'J' :		// EmptyBook
		default :
			break;	//return (-1);
		}
	}

	// 24.08.26) BEST 값이 없으면 AVAIL 값으로 대체함.
	if (psise->bidbestprc   <= 0.)	psise->bidbestprc   = psise->bidprc;
	if (psise->offerbestprc <= 0.)	psise->offerbestprc = psise->offerprc;

	return 0;
}

static int conv_KMB(char *pbuff, int dlen, MDSSISE *psise)
{
	int		ii, rc, nrec;
	uint32_t	ymd, hms;
	char    type[DF_2], strval[64], strval2[64];
	char	stemp[32], symbol[ 7+1];
	struct tm *lt;

	memset(symbol, 0x00, sizeof(symbol));
	psise->excode[0] = 'K';				// 원천 : 'S'=SMB, 'K'=KMB, 'E'=EBS, 'C'=CMB

// ★TODO-08 : 데이터 원천에 따라 FIX패킷 Convert 시 분기로직 추가 : sise_fix2ecm()

	AFIX_TOK_SETVATINT(s_xfix, MsgSeqNum,				AG_ZERO, (double) EOF);
	AFIX_TOK_SETVATINT(s_xfix, LastMsgSeqNumProcessed,	AG_ZERO, (double) EOF);
	AFIX_TOK_SETVATINT(s_xfix, BeginSeqNo,				AG_ZERO, (double) EOF);
	AFIX_TOK_SETVATINT(s_xfix, EndSeqNo,				AG_ZERO, (double) EOF);
	AFIX_TOK_SETVATINT(s_xfix, NewSeqNo,				AG_ZERO, (double) EOF);

	agfix_token_cls(s_xfix);
	agfix_set_define_leg (s_xfix, NoMDEntries, AG_ZERO, (int *) AG_NULL, (int *) AG_NULL, (double) EOF);
	
	pbuff[dlen] = 0x00;
	rc = agfix_dec (s_xfix, pbuff, dlen+1, SOH, EQU, AG_ZERO);		
	if (rc) 
 	{
		mds_log(market, MLOG_WARNING, "[%s] agfix_dec error (%d) [%d:%s]",__func__, rc, dlen, pbuff);
		return (-1);
	}

	rc = AFIX_TOK_GETSTR (s_xfix, Symbol, AG_ZERO, symbol);
	if (rc != AG_OK)
	{
		mds_log(market, MLOG_WARNING, "[%s] AFIX_TOK_GETSTR error (%d) [%d:%s]",__func__, rc, dlen, pbuff);
		return (-1);
	}
	//mds_time(market, 0, &market->xymd, &market->xhms, &market->kymd, &market->khms);
	if (symbol[3] == '/') {		// 통화코드에 '/'이 있을 때도 있고 없을 때도 있음.
		sprintf(stemp, "%.3s%.3s", symbol, &symbol[4]);
		memcpy(psise->symb, stemp, sizeof(psise->symb));
	}
	else
		memcpy(psise->symb, symbol, sizeof(psise->symb));

/* bid의 QuoteEntryID 를 Unique QuoteID로 사용 (USDKRWYYYYMMDDHHmmSS)
	rc = AFIX_TOK_GETSTR (s_xfix, MDReqID, AG_ZERO, psise->reqid);
	if (rc != AG_OK)
	{
		mds_log(market, MLOG_WARNING, "[%s] Fix Get Fail!", __func__);  
		return (0);
	}
*/
	mds_time(market, 0, &ymd, &hms, NULL, NULL);	// get local date & time
	sprintf (psise->date, "%08d", ymd);

	struct timeb itb;
	ftime(&itb);

	lt = localtime(&itb.time);
	sprintf (psise->time, "%02d%02d%02d%03d",lt->tm_hour,lt->tm_min,lt->tm_sec,itb.millitm);
	//AFIX_TOK_GETSTR (s_xfix, SendingTime, AG_ZERO, g_time);	

	nrec = AG_ZERO;
	rc = AFIX_TOK_GETINT (s_xfix, NoMDEntries, AG_ZERO, nrec);
	if (rc != AG_OK)	nrec = AG_ONE;

	for (ii = 0; ii < nrec; ii++)
	{
		MXZINIT (type); 
		AFIX_TOK_GETSTR (s_xfix, MDEntryType, ii, type);

		switch (type[0])
		{
		case    '0' :
// AFIX_TOK_GETDBL에서 잘못된 값이 리턴되어 STR로 처리후 변환
//			AFIX_TOK_GETDBL (s_xfix, 270, 			ii, psise->bidprc);
//			memset(strval, 0x00, sizeof(strval));
			AFIX_TOK_GETSTR (s_xfix, 270, 			ii, strval);		// MDEntryPx
			psise->bidprc = atof(strval);
//			AFIX_TOK_GETDBL (s_xfix, MDEntrySize, 	ii, psise->bidqty);
			AFIX_TOK_GETSTR (s_xfix, MDEntrySize, 	ii, strval);
			psise->bidqty = atof(strval);
			AFIX_TOK_GETSTR (s_xfix, MDEntryDate, 	ii, psise->biddate);
			AFIX_TOK_GETSTR (s_xfix, QuoteEntryID, 	ii, strval);		// psise->bidquoteid);
			sprintf(strval2, "%.1s.%.*s", psise->excode, sizeof(psise->quotid)-2, strval);
			memcpy(psise->quotid, strval2, strlen(strval2));			// excode + QuoteEntryID 로 채번
			AFIX_TOK_GETSTR (s_xfix, 9063,			ii, psise->bidsettype);		// SettType
//			AFIX_TOK_GETDBL (s_xfix, 9064,			ii, psise->bidbestprc);
			AFIX_TOK_GETSTR (s_xfix, 9064,			ii, strval);		// MDBestPx
			psise->bidbestprc = atof(strval);
//			AFIX_TOK_GETDBL (s_xfix, 9065,			ii, psise->bidbestqty);
			AFIX_TOK_GETSTR (s_xfix, 9065,			ii, strval);		// MDBestSize
			psise->bidbestqty = atof(strval);
			//bid시세가 없어서 임시추가 

			if (memcmp(psise->symb, "USDKRW", 6) == 0)
			{
//				AFIX_TOK_GETDBL (s_xfix, 9065, ii, psise->bidqty);
				AFIX_TOK_GETSTR (s_xfix, 9065, ii, strval);
				psise->bidqty = atof(strval);
			}
			break;

		case    '1' :
//			AFIX_TOK_GETDBL (s_xfix, 270, 			ii, psise->offerprc);
//			memset(strval, 0x00, sizeof(strval));
			AFIX_TOK_GETSTR (s_xfix, 270, 			ii, strval);
			psise->offerprc = atof(strval);
//			AFIX_TOK_GETDBL (s_xfix, MDEntrySize, 	ii, psise->offerqty);
			AFIX_TOK_GETSTR (s_xfix, MDEntrySize, 	ii, strval);
			psise->offerqty = atof(strval);
			AFIX_TOK_GETSTR (s_xfix, MDEntryDate, 	ii, psise->offerdate);
//			AFIX_TOK_GETSTR (s_xfix, QuoteEntryID, 	ii, psise->offerquoteid);
			AFIX_TOK_GETSTR (s_xfix, 9063,			ii, psise->offersettype);
//			AFIX_TOK_GETDBL (s_xfix, 9064,			ii, psise->offerbestprc);
			AFIX_TOK_GETSTR (s_xfix, 9064,			ii, strval);
			psise->offerbestprc = atof(strval);
//			AFIX_TOK_GETDBL (s_xfix, 9065,			ii, psise->offerbestqty);
			AFIX_TOK_GETSTR (s_xfix, 9065,			ii, strval);
			psise->offerbestqty = atof(strval);
		 	//offer시세가 없어서 임시추가 

			if (memcmp(psise->symb, "USDKRW", 6) == 0)
			{
//				AFIX_TOK_GETDBL (s_xfix, 9065, ii, psise->offerqty);
				AFIX_TOK_GETSTR (s_xfix, 9065, ii, strval);
				psise->offerqty = atof(strval);
			}
		}
	}

	// 24.08.26) BEST 값이 없으면 AVAIL 값으로 대체함.
	if (psise->bidbestprc   <= 0.)	psise->bidbestprc   = psise->bidprc;
	if (psise->offerbestprc <= 0.)	psise->offerbestprc = psise->offerprc;

	return 0;
}

int sise2mds(char *excode, char *pbuff, int dlen, MDSSISE *psise)
{
	uint32_t	ymd, hms;
	int		ii, rc, nrec;
	char    strval[64];

	// 고객용, 베스트 데몬은 MDSSISE 내부 포맷으로 수신함.
	if (market->excode[0] == DF_EXCD_BEST || market->excode[0] == DF_EXCD_CUST)
	{
		memcpy((void *)psise, pbuff, dlen);
		return (0);
	}

	switch (excode[0])
	{
	case 'C' :
		rc = conv_CMBS(pbuff, dlen, psise);
		if (rc < 0)
		{
			mds_log(market, MLOG_WARNING, "[%s] conv_CMBS error ! [%d] [%.*s]", __func__, rc, dlen, pbuff);
			return (-1);
		}
		break;

	case 'S' :
		rc = conv_SMBS(pbuff, dlen, psise);
		if (rc < 0)
		{
			mds_log(market, MLOG_WARNING, "[%s] conv_SMBS error ! [%d] [%.*s]", __func__, rc, dlen, pbuff);
			return (-1);
		}
		break;

	case 'K' :
		rc = conv_KMB(pbuff, dlen, psise);
		if (rc < 0)
		{
			mds_log(market, MLOG_WARNING, "[%s] conv_CMBS error ! [%d] [%.*s]", __func__, rc, dlen, pbuff);
			return (-1);
		}
		break;

	case 'E' :
		rc = conv_EBS(pbuff, dlen, psise);
		if (rc < 0)
		{
			mds_log(market, MLOG_WARNING, "[%s] conv_EBS error ! [%d] [%.*s]", __func__, rc, dlen, pbuff);
			return (-1);
		}
		break;

	case 'R' :
		rc = conv_REUT(pbuff, dlen, psise);
		if (rc < 0)
		{
			mds_log(market, MLOG_WARNING, "[%s] conv_SMBS error ! [%d] [%.*s]", __func__, rc, dlen, pbuff);
			return (-1);
		}
		break;

	default :
		mds_log(market, MLOG_WARNING, "[%s] excode error ! [%.1s]", __func__, excode);
		return (-1);
	}

	return 0;
}
