/*#####################################################################
// JPM 에서 NDF 를 거래하기 위한 시세 수신 및 전송
//#######################################################################*/
#include <sys/syscall.h>


#include "agfix.h"
#include "comdef.h"
#include "wfaapi.h"    // 실시간전송(Client)
#include "axsnd.h"
#include "mymq.h"
#include "agxpi.h"
#include "agtrc.h"
#include "comrdb.h"
#include "comhdr.h"
#include "comfun.h"
#include "killmon.h"
#include "quelog.h"

#include "mds2.h"
char	*whoami = "ndfmds";

MARKET	market;
E_MSG	e_msg;      // Error Message info

AG_FIX		s_afix;
Ag_Fix		s_xfix;
TFILE		s_trcf;
TFile	_trcf_	=  (TFile) &s_trcf;

KILLMON_T		*root;
KILL_SWITCH_T	*pk=NULL;

