	sprintf(v_usd_bid_last_prc,		"%.*f",		pind, pusdkrw->bidlast);
	sprintf(v_usd_offer_last_prc,	"%.*f",		pind, pusdkrw->offerlast);
	sprintf(v_usd_mid_last_prc,		"%.*f",		pind, (pusdkrw->bidlast+pusdkrw->offerlast)/2);

	l_rtrim(v_mrkup_dstcd   );
	l_rtrim(v_fx_prdct_cd   );
	l_rtrim(v_regi_ymd      );
	l_rtrim(v_rgst_time     );
	l_rtrim(v_bid_last_prc  );
	l_rtrim(v_offer_last_prc);
	l_rtrim(v_mid_last_prc  );
	l_rtrim(v_usd_mrkup_dstcd);
	l_rtrim(v_usd_bid_last_prc);
	l_rtrim(v_usd_offer_last_prc);
	l_rtrim(v_usd_mid_last_prc);

EXEC SQL 
	UPDATE INST1.TSKEIMU71
	SET	 GROUP_CO_CD        = 'KB0'
		,MRKUP_DSTCD        = :v_mrkup_dstcd
		,FX_PRDCT_CD        = :v_fx_prdct_cd
		,REGI_YMD           = :v_regi_ymd
		,RGST_TIME          = :v_rgst_time
		,BID_LAST_PRC       = :v_bid_last_prc
		,OFFER_LAST_PRC     = :v_offer_last_prc
--		,BID_OPEN_PRC       = :v_bid_last_prc
		,BID_HIGH_PRC       = CASE WHEN BID_HIGH_PRC < :v_bid_last_prc THEN :v_bid_last_prc ELSE BID_HIGH_PRC END
		,BID_LOW_PRC        = CASE WHEN BID_LOW_PRC  > :v_bid_last_prc THEN :v_bid_last_prc ELSE BID_LOW_PRC  END
--		,OFFER_OPEN_PRC     = :v_offer_last_prc
		,OFFER_HIGH_PRC     = CASE WHEN OFFER_HIGH_PRC < :v_offer_last_prc THEN :v_offer_last_prc ELSE OFFER_HIGH_PRC END
		,OFFER_LOW_PRC      = CASE WHEN OFFER_LOW_PRC  > :v_offer_last_prc THEN :v_offer_last_prc ELSE OFFER_LOW_PRC  END
		,MID_LAST_PRC       = :v_mid_last_prc
		,USD_MRKUP_DSTCD    = :v_usd_mrkup_dstcd
		,USD_BID_LAST_PRC   = :v_usd_bid_last_prc
		,USD_OFFER_LAST_PRC = :v_usd_offer_last_prc
--		,USD_BID_OPEN_PRC   = :v_usd_bid_last_prc
		,USD_BID_HIGH_PRC   = CASE WHEN USD_BID_HIGH_PRC < :v_usd_bid_last_prc THEN :v_usd_bid_last_prc ELSE USD_BID_HIGH_PRC END
		,USD_BID_LOW_PRC    = CASE WHEN USD_BID_LOW_PRC  > :v_usd_bid_last_prc THEN :v_usd_bid_last_prc ELSE USD_BID_LOW_PRC  END
--		,USD_OFFER_OPEN_PRC = :v_usd_offer_last_prc
		,USD_OFFER_HIGH_PRC = CASE WHEN USD_OFFER_HIGH_PRC < :v_usd_offer_last_prc THEN :v_usd_offer_last_prc ELSE USD_OFFER_HIGH_PRC END
		,USD_OFFER_LOW_PRC  = CASE WHEN USD_OFFER_LOW_PRC  > :v_usd_offer_last_prc THEN :v_usd_offer_last_prc ELSE USD_OFFER_LOW_PRC  END
		,USD_MID_LAST_PRC   = :v_usd_mid_last_prc
		,SYS_LAST_PRCSS_YMS = SUBSTR(HEX(CURRENT TIMESTAMP),1,20)
		,SYS_LAST_UNO       = 'KEI000'
	WHERE	GROUP_CO_CD	='KB0'
	  AND	FX_PRDCT_CD	= :v_fx_prdct_cd
	  AND	REGI_YMD	= :v_regi_ymd
	  AND	RGST_TIME	= :v_rgst_time
	;
	if (SQLCODE == 100) 
	{
	EXEC SQL 
		INSERT INTO INST1.TSKEIMU71 (
			 GROUP_CO_CD
			,MRKUP_DSTCD
			,FX_PRDCT_CD
			,REGI_YMD
			,RGST_TIME
			,BID_LAST_PRC
			,OFFER_LAST_PRC
			,BID_OPEN_PRC
			,BID_HIGH_PRC
			,BID_LOW_PRC
			,OFFER_OPEN_PRC
			,OFFER_HIGH_PRC
			,OFFER_LOW_PRC
			,MID_LAST_PRC
			,USD_MRKUP_DSTCD
			,USD_BID_LAST_PRC
			,USD_OFFER_LAST_PRC
			,USD_BID_OPEN_PRC
			,USD_BID_HIGH_PRC
			,USD_BID_LOW_PRC
			,USD_OFFER_OPEN_PRC
			,USD_OFFER_HIGH_PRC
			,USD_OFFER_LOW_PRC
			,USD_MID_LAST_PRC
			,SYS_LAST_PRCSS_YMS
			,SYS_LAST_UNO
		) VALUES (
			 'KB0'
			,:v_mrkup_dstcd
			,:v_fx_prdct_cd
			,:v_regi_ymd
			,:v_rgst_time
			,:v_bid_last_prc
			,:v_offer_last_prc
			,:v_bid_last_prc
			,:v_bid_last_prc
			,:v_bid_last_prc
			,:v_offer_last_prc
			,:v_offer_last_prc
			,:v_offer_last_prc
			,:v_mid_last_prc
			,:v_usd_mrkup_dstcd
			,:v_usd_bid_last_prc
			,:v_usd_offer_last_prc
			,:v_usd_bid_last_prc
			,:v_usd_bid_last_prc
			,:v_usd_bid_last_prc
			,:v_usd_offer_last_prc
			,:v_usd_offer_last_prc
			,:v_usd_offer_last_prc
			,:v_usd_mid_last_prc
			, SUBSTR(HEX(CURRENT TIMESTAMP),1,20)
			,'KEI000'
		);
		if (SQLCODE != 0)
		{
			mds_log(market, LOG_MUST, "TSKEIMU71 insert error [%.1s:%.6s] [%s] \n", psise->excode, psise->symb, SQLERRM);
			return(-1);
		}
	}
	else if (SQLCODE != 0)
	{
		mds_log(market, LOG_MUST, "TSKEIMU71 update error [%.1s:%.6s] [%s] \n", psise->excode, psise->symb, SQLERRM);
		return(-1);
	}

	return (0);
}


int UpsertDay(MDFOLD *pfold, MDSSISE *psise)
{
	int		pind = 8;
	
EXEC SQL BEGIN DECLARE SECTION;
	char	v_mrkup_dstcd       [ 1+1];
	char	v_fx_prdct_cd       [ 6+1];
	char	v_regi_ymd          [ 8+1];
	char	v_rgst_time         [ 9+1];
	char	v_bid_last_prc      [20+1];
	char	v_offer_last_prc    [20+1];
	char	v_mid_last_prc      [20+1];
	char	v_prdat_cntst_prc   [20+1];
	char	v_updwn_rato        [ 8+1];
EXEC SQL END DECLARE SECTION;

	double	d_prdat_cntst_prc	;
	double	d_updwn_rato		;
	double	d_mid_last_prc		;

	memset(v_mrkup_dstcd    , 0x00,		sizeof(v_mrkup_dstcd    ));
	memset(v_fx_prdct_cd    , 0x00,		sizeof(v_fx_prdct_cd    ));
	memset(v_regi_ymd       , 0x00,		sizeof(v_regi_ymd       ));
	memset(v_rgst_time      , 0x00,		sizeof(v_rgst_time      ));
	memset(v_bid_last_prc   , 0x00,		sizeof(v_bid_last_prc   ));
	memset(v_offer_last_prc , 0x00,		sizeof(v_offer_last_prc ));
	memset(v_mid_last_prc   , 0x00,		sizeof(v_mid_last_prc   ));
	memset(v_prdat_cntst_prc, 0x00,		sizeof(v_prdat_cntst_prc));
	memset(v_updwn_rato     , 0x00,		sizeof(v_updwn_rato     ));
	
	sprintf(v_fx_prdct_cd,	"%.6s%",		psise->symb);
	sprintf(v_regi_ymd,		"%.8s",			psise->date);
	sprintf(v_rgst_time,	"%.4s00000",	psise->time);
	if (psise->excode[0] == 'C' || psise->excode[0] == 'R' || psise->excode[0] == 'H')
		v_mrkup_dstcd[0] = '2';
	else
		v_mrkup_dstcd[0] = '1';

	sprintf(v_bid_last_prc,		"%.*f",		pind, psise->bidprc);
	sprintf(v_offer_last_prc,	"%.*f",		pind, psise->offerprc);

	d_mid_last_prc = (psise->bidprc + psise->offerprc)/2;
	sprintf(v_mid_last_prc,		"%.*f",		pind, d_mid_last_prc);
	if (d_mid_last_prc > 0.0)
	{
		d_prdat_cntst_prc	= d_mid_last_prc - pfold->baseprc;
		d_updwn_rato		= (d_prdat_cntst_prc / d_mid_last_prc) * 100.;
		sprintf(v_prdat_cntst_prc,	"%.*f",		pind, d_prdat_cntst_prc);
		sprintf(v_updwn_rato,		"%.*f",		pind, d_updwn_rato);
	}

	l_rtrim(v_mrkup_dstcd    );
	l_rtrim(v_fx_prdct_cd    );
	l_rtrim(v_regi_ymd       );
	l_rtrim(v_rgst_time      );
	l_rtrim(v_bid_last_prc   );
	l_rtrim(v_offer_last_prc );
	l_rtrim(v_mid_last_prc   );
	l_rtrim(v_prdat_cntst_prc);
	l_rtrim(v_updwn_rato     );

EXEC SQL 
	UPDATE INST1.TSKEIMU52
	SET	 GROUP_CO_CD        = 'KB0'
		,MRKUP_DSTCD        = :v_mrkup_dstcd
		,FX_PRDCT_CD        = :v_fx_prdct_cd
		,REGI_YMD           = :v_regi_ymd
		,RGST_TIME          = :v_rgst_time
		,BID_LAST_PRC       = :v_bid_last_prc
		,OFFER_LAST_PRC     = :v_offer_last_prc
--		,BID_OPEN_PRC       = :v_bid_last_prc
		,BID_HIGH_PRC       = CASE WHEN BID_HIGH_PRC < :v_bid_last_prc THEN :v_bid_last_prc ELSE BID_HIGH_PRC END
		,BID_LOW_PRC        = CASE WHEN BID_LOW_PRC  > :v_bid_last_prc THEN :v_bid_last_prc ELSE BID_LOW_PRC  END
--		,OFFER_OPEN_PRC     = :v_offer_last_prc
		,OFFER_HIGH_PRC     = CASE WHEN OFFER_HIGH_PRC < :v_offer_last_prc THEN :v_offer_last_prc ELSE OFFER_HIGH_PRC END
		,OFFER_LOW_PRC      = CASE WHEN OFFER_LOW_PRC  > :v_offer_last_prc THEN :v_offer_last_prc ELSE OFFER_LOW_PRC  END
		,MID_LAST_PRC       = :v_mid_last_prc
--		,OPEN_PRC_TIME      = SUBSTR(HEX(CURRENT TIMESTAMP), 9, 9)
		,HIGH_PRC_TIME      = CASE WHEN BID_HIGH_PRC < :v_bid_last_prc OR OFFER_HIGH_PRC < :v_offer_last_prc THEN 
									SUBSTR(HEX(CURRENT TIMESTAMP), 9, 9) ELSE HIGH_PRC_TIME END
		,LOW_PRC_TIME       = CASE WHEN BID_LOW_PRC  > :v_bid_last_prc OR OFFER_LOW_PRC  > :v_offer_last_prc THEN
									SUBSTR(HEX(CURRENT TIMESTAMP), 9, 9) ELSE LOW_PRC_TIME  END
		,PRDAT_CNTST_PRC    = :v_prdat_cntst_prc
		,UPDWN_RATO         = :v_updwn_rato
		,SYS_LAST_PRCSS_YMS = SUBSTR(HEX(CURRENT TIMESTAMP),1,20)
		,SYS_LAST_UNO       = 'KEI000'
	WHERE	GROUP_CO_CD	='KB0'
	  AND	FX_PRDCT_CD	= :v_fx_prdct_cd
	  AND	REGI_YMD	= :v_regi_ymd
	;
	if (SQLCODE == 100) 
	{
	EXEC SQL 
		INSERT INTO INST1.TSKEIMU52 (
			 GROUP_CO_CD
			,MRKUP_DSTCD
			,FX_PRDCT_CD
			,REGI_YMD
			,RGST_TIME
			,BID_LAST_PRC
			,OFFER_LAST_PRC
			,BID_OPEN_PRC
			,BID_HIGH_PRC
			,BID_LOW_PRC
			,OFFER_OPEN_PRC
			,OFFER_HIGH_PRC
			,OFFER_LOW_PRC
			,MID_LAST_PRC
			,OPEN_PRC_TIME
			,HIGH_PRC_TIME
			,LOW_PRC_TIME
			,PRDAT_CNTST_PRC
			,UPDWN_RATO
			,SYS_LAST_PRCSS_YMS
			,SYS_LAST_UNO
		) VALUES (
			 'KB0'
			,:v_mrkup_dstcd
			,:v_fx_prdct_cd
			,:v_regi_ymd
			,:v_rgst_time
			,:v_bid_last_prc
			,:v_offer_last_prc
			,:v_bid_last_prc
			,:v_bid_last_prc
			,:v_bid_last_prc
			,:v_offer_last_prc
			,:v_offer_last_prc
			,:v_offer_last_prc
			,:v_mid_last_prc
			, SUBSTR(HEX(CURRENT TIMESTAMP), 9, 9)
			, SUBSTR(HEX(CURRENT TIMESTAMP), 9, 9)
			, SUBSTR(HEX(CURRENT TIMESTAMP), 9, 9)
			,:v_prdat_cntst_prc
			,:v_updwn_rato
			, SUBSTR(HEX(CURRENT TIMESTAMP), 1, 20)
			,'KEI000'
		);
		if (SQLCODE != 0)
		{
			mds_log(market, LOG_MUST, "TSKEIMU52 insert error [%.1s:%.6s] [%s] \n", psise->excode, psise->symb, SQLERRM);
			return(-1);
		}
	}
	else if (SQLCODE != 0)
	{
		mds_log(market, LOG_MUST, "TSKEIMU52 update error [%.1s:%.6s] [%s] \n", psise->excode, psise->symb, SQLERRM);
		return(-1);
	}

	return (0);
}


int UpsertDay_Fincl(MDSSISE *psise, MDFOLD *pfold, MDFOLD *pusdkrw)
{
	int		pind = 8;
	
EXEC SQL BEGIN DECLARE SECTION;
	char	v_mrkup_dstcd       [ 1+1];
	char	v_fx_prdct_cd       [ 6+1];
	char	v_regi_ymd          [ 8+1];
	char	v_rgst_time         [ 9+1];
	char	v_bid_last_prc      [20+1];
	char	v_offer_last_prc    [20+1];
	char	v_mid_last_prc      [20+1];
	char	v_prdat_cntst_prc   [20+1];
	char	v_updwn_rato        [ 8+1];
	char	v_usd_mrkup_dstcd	[ 1+1];
	char	v_usd_bid_last_prc	[20+1];
	char	v_usd_offer_last_prc[20+1];
	char	v_usd_mid_last_prc	[20+1];
	
	double	d_bid_high_prc		;
	double	d_bid_low_prc		;
	double	d_offer_high_prc	;
	double	d_offer_low_prc		;
	int		i_bh				;
	int		i_bl				;
	int		i_oh				;
	int		i_ol				;
EXEC SQL END DECLARE SECTION;

	double	fn_bid				= 0.0;
	double	fn_offer			= 0.0;
	double	fn_baseprc			= 0.0;
	double	d_prdat_cntst_prc	= 0.0;
	double	d_updwn_rato		= 0.0;
	double	d_mid_last_prc		= 0.0;
	double	d_bid_prc			= 0.0;
	double	d_offer_prc			= 0.0;

	memset(v_mrkup_dstcd    	, 0x00,	sizeof(v_mrkup_dstcd    ));
	memset(v_fx_prdct_cd    	, 0x00,	sizeof(v_fx_prdct_cd    ));
	memset(v_regi_ymd       	, 0x00,	sizeof(v_regi_ymd       ));
	memset(v_rgst_time      	, 0x00,	sizeof(v_rgst_time      ));
	memset(v_bid_last_prc   	, 0x00,	sizeof(v_bid_last_prc   ));
	memset(v_offer_last_prc 	, 0x00,	sizeof(v_offer_last_prc ));
	memset(v_mid_last_prc   	, 0x00,	sizeof(v_mid_last_prc   ));
	memset(v_prdat_cntst_prc	, 0x00,	sizeof(v_prdat_cntst_prc));
	memset(v_updwn_rato     	, 0x00,	sizeof(v_updwn_rato     ));
	memset(v_usd_mrkup_dstcd	, 0x00, sizeof(v_usd_mrkup_dstcd));
	memset(v_usd_bid_last_prc	, 0x00, sizeof(v_usd_bid_last_prc));
	memset(v_usd_offer_last_prc	, 0x00, sizeof(v_usd_offer_last_prc));
	memset(v_usd_mid_last_prc	, 0x00, sizeof(v_usd_mid_last_prc));

	d_bid_high_prc		= 0.0;
	d_bid_low_prc		= 0.0;
	d_offer_high_prc	= 0.0;
	d_offer_low_prc		= 0.0;

	i_bh = i_bl = i_oh = i_ol = 0;

//	if (pfold->usdpos == 0)			// USD위치 ("0": CADKRW=USDKRW/USDCAD, "1":EURKRW=USDKRW*EURUSD)
	if (memcmp(pfold->symb, "USD", 3) == 0)	memcpy(v_fx_prdct_cd, &pfold->symb[3], 3);
	else									memcpy(v_fx_prdct_cd, &pfold->symb, 3);
	memcpy(&v_fx_prdct_cd[3], "KRW", 3);

	sprintf(v_regi_ymd,		"%.8s",			psise->date);
	sprintf(v_rgst_time,	"%.4s00000",	psise->time);

	if (psise->excode[0] == 'C' || psise->excode[0] == 'R' || psise->excode[0] == 'H')
		v_mrkup_dstcd[0] = '2';
	else
		v_mrkup_dstcd[0] = '1';

	// USDKRW 수신으로 재정통화계산 시에는 psise값은 미사용, 두 통화의 마스트메모리 값으로 계산함.
	if (memcmp(psise->symb, DF_USDKRW, 6) == 0)
	{
		d_bid_prc	= pfold->bidlast;
		d_offer_prc	= pfold->offerlast;
	}
	else
	{
		d_bid_prc	= psise->bidprc;
		d_offer_prc	= psise->offerprc;
	}

	sprintf(v_bid_last_prc,		"%.*f",		pind, d_bid_prc);
	sprintf(v_offer_last_prc,	"%.*f",		pind, d_offer_prc);

	//	if (pfold->usdpos == 0)			// USD위치 ("0": CADKRW=USDKRW/USDCAD, "1":EURKRW=USDKRW*EURUSD)
	if (memcmp(pfold->symb, "USD", 3) == 0)
	{
		fn_bid		= pusdkrw->bidlast/d_bid_prc;
		fn_offer	= pusdkrw->offerlast/d_offer_prc;
		fn_baseprc	= pusdkrw->baseprc/pfold->baseprc;
	}
	else
	{
		fn_bid		= pusdkrw->bidlast*d_bid_prc;
		fn_offer	= pusdkrw->offerlast*d_offer_prc;
		fn_baseprc	= pusdkrw->baseprc*pfold->baseprc;
	}

	d_mid_last_prc = (fn_bid + fn_offer)/2;
	sprintf(v_mid_last_prc,		"%.*f",		pind, d_mid_last_prc);

	if (d_mid_last_prc <= 0.0)	return (-1);

	d_prdat_cntst_prc	= d_mid_last_prc - fn_baseprc;
	d_updwn_rato		= (d_prdat_cntst_prc / d_mid_last_prc) * 100.;
	sprintf(v_prdat_cntst_prc,	"%.*f",		pind, d_prdat_cntst_prc);
	sprintf(v_updwn_rato,		"%.*f",		pind, d_updwn_rato);

	if (pusdkrw->bidex[0] == 'C' || pusdkrw->bidex[0] == 'R' || pusdkrw->bidex[0] == 'H')
		v_usd_mrkup_dstcd[0] = '2';
	else
		v_usd_mrkup_dstcd[0] = '1';

	sprintf(v_usd_bid_last_prc,		"%.*f",		pind, pusdkrw->bidlast);
	sprintf(v_usd_offer_last_prc,	"%.*f",		pind, pusdkrw->offerlast);
	sprintf(v_usd_mid_last_prc,		"%.*f",		pind, (pusdkrw->bidlast+pusdkrw->offerlast)/2);

	l_rtrim(v_mrkup_dstcd    );
	l_rtrim(v_fx_prdct_cd    );
	l_rtrim(v_regi_ymd       );
	l_rtrim(v_rgst_time      );
	l_rtrim(v_bid_last_prc   );
	l_rtrim(v_offer_last_prc );
	l_rtrim(v_mid_last_prc   );
	l_rtrim(v_prdat_cntst_prc);
	l_rtrim(v_updwn_rato     );
	l_rtrim(v_usd_mrkup_dstcd);
	l_rtrim(v_usd_bid_last_prc);
	l_rtrim(v_usd_offer_last_prc);
	l_rtrim(v_usd_mid_last_prc);

EXEC SQL
	SELECT	 CASE WHEN SUBSTR(FX_PRDCT_CD,1,3)='USD' THEN USD_BID_HIGH_PRC/BID_HIGH_PRC     ELSE USD_BID_HIGH_PRC*BID_HIGH_PRC     END
			,CASE WHEN SUBSTR(FX_PRDCT_CD,1,3)='USD' THEN USD_BID_LOW_PRC/BID_LOW_PRC       ELSE USD_BID_LOW_PRC*BID_LOW_PRC       END
			,CASE WHEN SUBSTR(FX_PRDCT_CD,1,3)='USD' THEN USD_OFFER_HIGH_PRC/OFFER_HIGH_PRC ELSE USD_OFFER_HIGH_PRC*OFFER_HIGH_PRC END
			,CASE WHEN SUBSTR(FX_PRDCT_CD,1,3)='USD' THEN USD_OFFER_LOW_PRC/OFFER_LOW_PRC   ELSE USD_OFFER_LOW_PRC*OFFER_LOW_PRC   END
	  INTO	 :d_bid_high_prc
			,:d_bid_low_prc
			,:d_offer_high_prc
			,:d_offer_low_prc
	  FROM	INST1.TSKEIMU72
	WHERE	GROUP_CO_CD	='KB0'
	  AND	FX_PRDCT_CD	= :v_fx_prdct_cd
	  AND	REGI_YMD	= :v_regi_ymd
	;
	if (SQLCODE == 100) 
	{
	EXEC SQL
		INSERT INTO INST1.TSKEIMU72 (
			 GROUP_CO_CD
			,MRKUP_DSTCD
			,FX_PRDCT_CD
			,REGI_YMD
			,RGST_TIME
			,BID_LAST_PRC
			,OFFER_LAST_PRC
			,BID_OPEN_PRC
			,BID_HIGH_PRC
			,BID_LOW_PRC
			,OFFER_OPEN_PRC
			,OFFER_HIGH_PRC
			,OFFER_LOW_PRC
			,MID_LAST_PRC
			,USD_MRKUP_DSTCD
			,USD_BID_OPEN_PRC
			,USD_BID_HIGH_PRC
			,USD_BID_LOW_PRC
			,USD_BID_LAST_PRC
			,USD_OFFER_OPEN_PRC
			,USD_OFFER_HIGH_PRC
			,USD_OFFER_LOW_PRC
			,USD_OFFER_LAST_PRC
			,USD_MID_LAST_PRC
			,OPEN_PRC_TIME
			,HIGH_PRC_TIME
			,LOW_PRC_TIME
			,PRDAT_CNTST_PRC
			,UPDWN_RATO
			,SYS_LAST_PRCSS_YMS
			,SYS_LAST_UNO
		) VALUES (
			 'KB0'
			,:v_mrkup_dstcd
			,:v_fx_prdct_cd
			,:v_regi_ymd
			,:v_rgst_time
			,:v_bid_last_prc
			,:v_offer_last_prc
			,:v_bid_last_prc
			,:v_bid_last_prc
			,:v_bid_last_prc
			,:v_offer_last_prc
			,:v_offer_last_prc
			,:v_offer_last_prc
			,:v_mid_last_prc
			,:v_usd_mrkup_dstcd
			,:v_usd_bid_last_prc
			,:v_usd_bid_last_prc
			,:v_usd_bid_last_prc
			,:v_usd_bid_last_prc
			,:v_usd_offer_last_prc
			,:v_usd_offer_last_prc
			,:v_usd_offer_last_prc
			,:v_usd_offer_last_prc
			,:v_usd_mid_last_prc
			, SUBSTR(HEX(CURRENT TIMESTAMP), 9, 9)
			, SUBSTR(HEX(CURRENT TIMESTAMP), 9, 9)
			, SUBSTR(HEX(CURRENT TIMESTAMP), 9, 9)
			,:v_prdat_cntst_prc
			,:v_updwn_rato
			, SUBSTR(HEX(CURRENT TIMESTAMP), 1, 20)
			,'KEI000'
		);
		if (SQLCODE != 0)
		{
			mds_log(market, LOG_MUST, "TSKEIMU72 insert error [%.1s:%.6s:%.6s] [%s] \n", psise->excode, psise->symb, v_fx_prdct_cd, SQLERRM);
			return(-1);
		}
		return (0);
	}
	else if (SQLCODE != 0)
	{
		mds_log(market, LOG_MUST, "TSKEIMU72 select error [%.1s:%.6s] [%s] \n", psise->excode, psise->symb, SQLERRM);
		return(-1);
	}

	/*===============================================================
	 * 고가와 저가는 계산된 재정환율을 기준으로 비교 함
	 * 계산된 재정환율이 고가를 갱신한 경우에 각 HIGH_PRC, USD_HIGH_PRC, HIGH_PRC_TIME 업데이트
	 * 계산된 재정환율이 저가를 갱신한 경우에 각 LOW_PRC, USD_LOW_PRC, LOW_PRC_TIME 업데이트
	===============================================================*/
	if (fn_bid > d_bid_high_prc)			i_bh = 1;
	else if (fn_bid < d_bid_low_prc)		i_bl = 1;

	if (fn_offer > d_offer_high_prc)		i_oh = 1;
	else if (fn_offer < d_offer_low_prc)	i_ol = 1;

EXEC SQL 
	UPDATE INST1.TSKEIMU72
	SET	 GROUP_CO_CD        = 'KB0'
		,MRKUP_DSTCD        = :v_mrkup_dstcd
		,FX_PRDCT_CD        = :v_fx_prdct_cd
		,REGI_YMD           = :v_regi_ymd
		,RGST_TIME          = :v_rgst_time
		,BID_LAST_PRC       = :v_bid_last_prc
		,OFFER_LAST_PRC     = :v_offer_last_prc
--		,BID_OPEN_PRC       = :v_bid_last_prc
		,BID_HIGH_PRC       = DECODE(:i_bh, 1, :v_bid_last_prc, BID_HIGH_PRC)
		,BID_LOW_PRC        = DECODE(:i_bl, 1, :v_bid_last_prc, BID_LOW_PRC )
--		,OFFER_OPEN_PRC     = :v_offer_last_prc
		,OFFER_HIGH_PRC     = DECODE(:i_oh, 1, :v_offer_last_prc, OFFER_HIGH_PRC)
		,OFFER_LOW_PRC      = DECODE(:i_ol, 1, :v_offer_last_prc, OFFER_LOW_PRC )
		,MID_LAST_PRC       = :v_mid_last_prc
		,USD_MRKUP_DSTCD    = :v_usd_mrkup_dstcd
--		,USD_BID_OPEN_PRC   = :v_usd_bid_last_prc
		,USD_BID_HIGH_PRC   = DECODE(:i_bh, 1, :v_usd_bid_last_prc, USD_BID_HIGH_PRC)
		,USD_BID_LOW_PRC    = DECODE(:i_bl, 1, :v_usd_bid_last_prc, USD_BID_LOW_PRC )
		,USD_BID_LAST_PRC   = :v_usd_bid_last_prc  
--		,USD_OFFER_OPEN_PRC = :v_usd_offer_last_prc
		,USD_OFFER_HIGH_PRC = DECODE(:i_oh, 1, :v_usd_offer_last_prc, USD_OFFER_HIGH_PRC)
		,USD_OFFER_LOW_PRC  = DECODE(:i_ol, 1, :v_usd_offer_last_prc, USD_OFFER_LOW_PRC )
		,USD_OFFER_LAST_PRC = :v_usd_offer_last_prc
		,USD_MID_LAST_PRC   = :v_usd_mid_last_prc
--		,OPEN_PRC_TIME      = SUBSTR(HEX(CURRENT TIMESTAMP), 9, 9)
		,HIGH_PRC_TIME      = CASE WHEN :i_bh + :i_oh > 0 THEN SUBSTR(HEX(CURRENT TIMESTAMP), 9, 9) ELSE HIGH_PRC_TIME END
		,LOW_PRC_TIME       = CASE WHEN :i_bl + :i_ol > 0 THEN SUBSTR(HEX(CURRENT TIMESTAMP), 9, 9) ELSE HIGH_PRC_TIME END
		,PRDAT_CNTST_PRC    = :v_prdat_cntst_prc
		,UPDWN_RATO         = :v_updwn_rato
		,SYS_LAST_PRCSS_YMS = SUBSTR(HEX(CURRENT TIMESTAMP),1,20)
		,SYS_LAST_UNO       = 'KEI000'
	WHERE	GROUP_CO_CD	='KB0'
	  AND	FX_PRDCT_CD	= :v_fx_prdct_cd
	  AND	REGI_YMD	= :v_regi_ymd
	;
	if (SQLCODE != 0)
	{
		if (abs(SQLCODE) == 420)
			mds_log(market, LOG_MUST, "%s,%s,%s,%s,%s,%s,%s,%s,%s"
					,v_fx_prdct_cd
					,v_bid_last_prc
					,v_offer_last_prc
					,v_mid_last_prc
					,v_usd_bid_last_prc  
					,v_usd_offer_last_prc
					,v_usd_mid_last_prc
					,v_prdat_cntst_prc
					,v_updwn_rato);
		mds_log(market, LOG_MUST, "TSKEIMU72 update error [%.1s:%.6s:%.6s] [%s]\n", psise->excode, psise->symb, pfold->symb, SQLERRM);
		return(-1);
	}

	return (0);
}


void SetCustFeed(MARKET *m)
{
	time_t	clock;
	struct	tm tm;
	uint32_t nextday;
	char	stime	[14+1];
	char	etime	[14+1];
	MDFOLD	*pfold;

EXEC SQL BEGIN DECLARE SECTION;
	char v_fx_prdct_cd			[ 6+1];
	char v_prc_orign_dstcd		[ 1+1];
	char v_fincl_anoun_stop_yn	[ 1+1];
	char v_fcm_id				[10+1];
	char v_start_hms			[ 6+1];
	char v_end_hms				[ 6+1];
EXEC SQL END DECLARE SECTION;

	while ((pfold = mds_popfolder(m)))
	{
		// TSKEIAM97 테이블에서 관리하지 않는 통화코드 SKIP
		if (memcmp(pfold->symb, "CNHKRW", 6) == 0 || memcmp(pfold->symb, "MARKRW", 6) == 0)		// 고객은 CNYKRW 사용하므로 CNHKRW는 관리하지 않음.
			continue;

		memset(v_fx_prdct_cd		, 0x00, sizeof(v_fx_prdct_cd		));
		memset(v_prc_orign_dstcd	, 0x00, sizeof(v_prc_orign_dstcd	));
		memset(v_fincl_anoun_stop_yn, 0x00, sizeof(v_fincl_anoun_stop_yn));
		memset(v_fcm_id				, 0x00, sizeof(v_fcm_id				));
		memset(v_start_hms			, 0x00, sizeof(v_start_hms			));
		memset(v_end_hms			, 0x00, sizeof(v_end_hms			));

		if (memcmp(pfold->symb, "USDCNY", 6) == 0)		// 화면에서 USDCNH로 관리되므로 USDCNY는 USDCNH 시간설정을 동일하게 처리.
			memcpy(v_fx_prdct_cd, "USDCNH", sizeof(pfold->symb));
		else
			memcpy(v_fx_prdct_cd, pfold->symb, sizeof(pfold->symb));

	EXEC SQL
		SELECT	 FX_PRDCT_CD
				,PRC_ORIGN_DSTCD
				,FINCL_ANOUN_STOP_YN
				,PROR_FCM_ID
				,PROR_START_HMS
				,PROR_END_HMS
		  INTO	 :v_fx_prdct_cd
				,:v_prc_orign_dstcd
				,:v_fincl_anoun_stop_yn
				,:v_fcm_id
				,:v_start_hms
				,:v_end_hms
		  FROM	INST1.TSKEIAM97
		 WHERE	FX_PRDCT_CD = :v_fx_prdct_cd
		WITH UR
		;
		if (SQLCODE != 0)
		{
			mds_log(m, LOG_MUST, "TSKEIAM97 select error [%.1s:%.6s] [%s] \n", m->excode, pfold->symb, SQLERRM);
			continue;
		}

		l_rtrim(v_fx_prdct_cd		);
		l_rtrim(v_prc_orign_dstcd	);
		l_rtrim(v_fincl_anoun_stop_yn);
		l_rtrim(v_fcm_id			);
		l_rtrim(v_start_hms			);
		l_rtrim(v_end_hms			);

		if (pfold->custfeedtp[0]  != v_prc_orign_dstcd[0])
		{
			mds_log(m, LOG_MUST, "[%s] 고객제공원천 for [%.6s] 변경됨 -> [%.1s]",__func__, pfold->symb, v_prc_orign_dstcd);
			pfold->custfeedtp[0]  = v_prc_orign_dstcd[0];
		}
		if (pfold->custfinclyn[0] != v_fincl_anoun_stop_yn[0])
		{
			mds_log(m, LOG_MUST, "[%s] 고객 재정환율제공 for [%.6s] 변경됨 -> [%.1s]",__func__, pfold->symb, v_fincl_anoun_stop_yn);
			pfold->custfinclyn[0] = v_fincl_anoun_stop_yn[0];
		}
		
		// CUST인 경우 시간관리는 하지 않으므로 원천정보만 표기함.
		if (m->excode[0] == DF_EXCD_CUST)
			continue;

		clock = time(0);
		localtime_r(&clock, &tm);

		// '가격원천구분코드'에 따른 분기처리
		switch (v_prc_orign_dstcd[0])
		{
		case DF_CFEED_STOP :		// 고객시세 : 제공중단
			mds_log(m, LOG_MUST, "[%s] [%.6s] 고객시세 중단",__func__, pfold->symb);
			break;

		case DF_CFEED_HAND :		// 고객시세 : 수기제공
			mds_log(m, LOG_MUST, "[%s] [%.6s] 고객시세 수기",__func__, pfold->symb);
			break;

		case DF_CFEED_PRIO :		// 고객시세 : 우선설정
			if (memcmp(v_fcm_id, m->exnm, sizeof(v_fcm_id)) != 0)
			{
				if (memcmp(pfold->custstm, "99999999999999", sizeof(pfold->custstm)) != 0 || memcmp(pfold->custetm, "00000000000000", sizeof(pfold->custetm)) != 0)
				{
					mds_log(m, LOG_MUST, "[%s] [%.6s] 고객시세 우선 for [%.4s].. reset.",__func__, pfold->symb, v_fcm_id);
					memcpy(pfold->custstm, "99999999999999", sizeof(pfold->custstm));
					memcpy(pfold->custetm, "00000000000000", sizeof(pfold->custetm));
				}
				break;
			}
			
			sprintf(stime, "%04d%02d%02d%.6s", tm.tm_year+1900, tm.tm_mon+1, tm.tm_mday, v_start_hms);
			if (strncmp(v_start_hms, v_end_hms, sizeof(v_start_hms)) > 0)
			{
				nextday = getnextday();
				sprintf(etime, "%08d%.6s", nextday, v_end_hms);
			}
			else
				sprintf(etime, "%04d%02d%02d%.6s", tm.tm_year+1900, tm.tm_mon+1, tm.tm_mday, v_end_hms);

			mds_log(m, LOG_MUST, "[%s] [%.6s] 고객시세 우선 [%.14s ~ %.14s]",__func__, pfold->symb, stime, etime);

			if (memcmp(pfold->custstm, stime, sizeof(pfold->custstm)) != 0)
			{
				mds_log(m, LOG_MUST, "[%s] [%.6s] starttime 변경됨 [%.14s -> %.14s]",__func__, pfold->symb, pfold->custstm, stime);
				memcpy(pfold->custstm, stime, sizeof(pfold->custstm));
			}
			if (memcmp(pfold->custetm, etime, sizeof(pfold->custetm)) != 0)
			{
				mds_log(m, LOG_MUST, "[%s] [%.6s] endtime 변경됨 [%.14s -> %.14s]",__func__, pfold->symb, pfold->custetm, etime);
				memcpy(pfold->custetm, etime, sizeof(pfold->custetm));
			}
			break;

		case DF_CFEED_STND :		// 고객시세 : 기본설정(TSKEIAM98)

			memset(v_fcm_id		, 0x00, sizeof(v_fcm_id		));
			memset(v_start_hms	, 0x00, sizeof(v_start_hms	));
			memset(v_end_hms	, 0x00, sizeof(v_end_hms	));
			
			memcpy(v_fcm_id, m->exnm, sizeof(v_fcm_id));

		EXEC SQL
			SELECT	 START_HMS
					,END_HMS
			  INTO	 :v_start_hms
			  		,:v_end_hms
			  FROM	(	SELECT	 START_HMS
								,END_HMS
								,CASE WHEN START_HMS > END_HMS THEN TO_CHAR(TO_NUMBER(END_HMS) + 240000) ELSE END_HMS END AS ETIME
						  FROM	INST1.TSKEIAM98
						 WHERE	FCM_ID = :v_fcm_id
						   AND	FX_PRDCT_CD = :v_fx_prdct_cd
					)
			 WHERE	ETIME > TO_CHAR(SYSDATE, 'HH24MISS')
			ORDER BY ETIME
			FETCH FIRST 1 ROWS ONLY
			WITH UR
			;
			if (SQLCODE != 0)
			{
				if (SQLCODE != 100)		// NOT FOUND
					mds_log(m, LOG_MUST, "TSKEIAM98 select error [%.1s:%.6s] [%s] \n", m->excode, pfold->symb, SQLERRM);

				if (memcmp(pfold->custstm, "99999999999999", sizeof(pfold->custstm)) != 0 || memcmp(pfold->custetm, "00000000000000", sizeof(pfold->custetm)) != 0)
				{
					mds_log(m, LOG_MUST, "[%s] [%.6s] custfeed time reset [%.14s/%.14s]=>[9999/0000]", __func__, pfold->symb, pfold->custstm, pfold->custetm);
					memcpy(pfold->custstm, "99999999999999", sizeof(pfold->custstm));
					memcpy(pfold->custetm, "00000000000000", sizeof(pfold->custetm));
				}
				break;
			}

			sprintf(stime, "%04d%02d%02d%.6s", tm.tm_year+1900, tm.tm_mon+1, tm.tm_mday, v_start_hms);
			if (strncmp(v_start_hms, v_end_hms, sizeof(v_start_hms)) > 0)
			{
				nextday = getnextday();
				sprintf(etime, "%08d%.6s", nextday, v_end_hms);
			}
			else
				sprintf(etime, "%04d%02d%02d%.6s", tm.tm_year+1900, tm.tm_mon+1, tm.tm_mday, v_end_hms);

			//mds_log(m, LOG_MUST, "[%s] [%.6s] 고객시세 기본 [%.14s ~ %.14s]",__func__, pfold->symb, stime, etime);

			if (memcmp(pfold->custstm, stime, sizeof(pfold->custstm)) != 0)
			{
				mds_log(m, LOG_MUST, "[%s] [%.6s] starttime 변경됨 [%.14s -> %.14s]",__func__, pfold->symb, pfold->custstm, stime);
				memcpy(pfold->custstm, stime, sizeof(pfold->custstm));
			}
			if (memcmp(pfold->custetm, etime, sizeof(pfold->custetm)) != 0)
			{
				mds_log(m, LOG_MUST, "[%s] [%.6s] endtime 변경됨 [%.14s -> %.14s]",__func__, pfold->symb, pfold->custetm, etime);
				memcpy(pfold->custetm, etime, sizeof(pfold->custetm));
			}
			break;

		default :
			mds_log(market, LOG_MUST, "TSKEIAM98 v_prc_orign_dstcd error [%.1s:%.6s] [%.1s] \n", market->excode, pfold->symb, v_prc_orign_dstcd);
		}
	}

	l_db2commit();

	return 0;
}

