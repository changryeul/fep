	printf("read count (all=0) : ");
	scanf("%d", &cnt);
}
	rtn = agdque_at_io(&dque);
	//rc = agdque_at (&dque, "/fsfxwin/wfa/dat", NULL, "WGRCVRQ", 0, 0);
	//rc = agdque_at (&dque, "/fsfxwin/wfa", "dat", "YARIQ", 0, 0);
	if (rtn < 0)
	{
		printf("(%s) queue in agdque_at_io error (%d)\n ", __func__, rtn);
		return (0);
	}
	if (cnt <= 0)	cnt = dque.hdr.wno;
	printf("TOT CNT : %d\n", dque.hdr.wno);
	
	spos = (dque.hdr.wno>cnt?dque.hdr.wno-cnt:0);
	rwno[0] = spos;
	rtn = agdque_rwi_io (&dque, idx, &rwno);

	// dque 사용 시 semk 지정하지 않으면, 이름을 base로 semkey를 생성하게 되어 있다. 
	rtn = agdque_semget (&dque, AG_ZERO, AG_DQ_ENV);
	if (rtn < 0)
	{
		printf("(%s) queue in agdque_semget error (%d)\n ", __func__, rtn);
		return (0);
	}

//	printf("dfnm=[%s] dsnm=[%s]\n", dque.dfnm, dque.dsnm);

	// 시세 수신
	while (1) {
		memset(rbuf, 0x00, sizeof(rbuf));
// dque.semk에 NULL 값이 있어 이벤트 발생 안함.
//		rtn = agdque_rdn (&dque, NULL, NULL, dque.dfnm, dque.semk, rbuf, sizeof(rbuf), idx, (-1), &rwno);
// 1/10초당 1건씩 read로 변경
		rtn = agdque_rdn (&dque, NULL, NULL, dque.dfnm, dque.semk, rbuf, sizeof(rbuf), idx, 100000, &rwno);
		if (rtn == 0) {
			if (ac >= 4)	break;
			continue;
		} else if (rtn < 0)	{
			printf("agdque_rdn error : %d\n", rtn);
			break;
		}
		for (ii=0; ii<rtn; ii++)
			if(rbuf[ii] == NULL)	rbuf[ii]='_';

		printf("[%d/%d] [%d:%s]\n", rwno[0], rwno[1], rtn, rbuf);
	}

	return (0);
}

int call_W3370A01(MDFOLD *pfold, char *lgen_no, char prdct_dstcd, char side, char *ordqty)
{
	int			slen = 0, rlen = 0;
	double		d_ordqty;
	char		sndbuf[1024*4] = {0};
	char		stemp[128];
	char		*prcv;
	MyMQ		*mymq;
	COMHDR		*pcom;
	W3370A01_I	*tri;
	W3370A01_O	*tro;

EXEC SQL BEGIN DECLARE SECTION;
	char v_bizdate	[ 8+1];
	char v_tnr_cd	[ 2+1];
	char v_furdate	[ 8+1];
	char v_fx_prdct_cd [ 6+1];
EXEC SQL END DECLARE SECTION;

	memset(sndbuf, 0x00, sizeof(sndbuf));
	pcom = (COMHDR *)sndbuf;

    char    msid          [14];  // 209 WTS(master,sub id) ADD-202211

	// 공통헤더 세팅
	zsedit(pcom->trxc, "W3370A01" );
	zsedit(pcom->loip, "127.0.0.1");	//16 로컬 IP
	zsedit(pcom->auip, "127.0.0.1");	//16 공인 IP
	zsedit(pcom->ctyp, "W");			//"A" );		// 접속매체구분 : 주문쪽 요청으로 일단 'W'로 변경함.
	zsedit(pcom->usid, lgen_no);		//whoami);		// 주문쪽 요청으로 일단 사용자 Lgen_No로 변경
	//zsedit(pcom->msid, "");			// FXGO CNSH
	//zsedit(pcom->msid, "");			// FXGO CNSH

	memset(pcom->msid,     0x00, sizeof(pcom->msid));
	memset(v_bizdate,     0x00, sizeof(v_bizdate));
	memset(v_furdate,     0x00, sizeof(v_furdate));
	memset(v_tnr_cd,      0x00, sizeof(v_tnr_cd));
	memset(v_fx_prdct_cd, 0x00, sizeof(v_fx_prdct_cd));

EXEC SQL
	SELECT 영업년월일 INTO :v_bizdate FROM INST1.TSKEIAM00 WITH UR;
	if (SQLCODE != 0)
	{
		printf("select bizdate error.. [%d:%s]\n", SQLCODE, SQLERRM);
		return (-1);
	}

	d_ordqty = atof(ordqty);

// tri->fx_prdct_dstcd               // FX상품구분(1-TD, 2-TOM, 3-현물환, 4-선물환, 5-스왑, 6-바로환전, 7-NDF)
	if (prdct_dstcd == '1')			strcpy(v_tnr_cd, "00");
	else if (prdct_dstcd == '2')	strcpy(v_tnr_cd, "01");
	else if (prdct_dstcd == '3')	strcpy(v_tnr_cd, "02");
	else if (prdct_dstcd == '4')	strcpy(v_tnr_cd, "10");
	else if (prdct_dstcd == '6')	strcpy(v_tnr_cd, "02");
	else	return (-2);

	memcpy(v_fx_prdct_cd, pfold->symb, sizeof(pfold->symb));
EXEC SQL
	SELECT EXPIR_YMD INTO :v_furdate FROM INST1.TSKEIMU55
	WHERE REGI_YMD    = (SELECT MAX(REGI_YMD) FROM INST1.TSKEIMU55)
	  AND ANOUN_TIME  = '000000'
	  AND TNR_CD      = :v_tnr_cd
	  AND FX_PRDCT_CD = :v_fx_prdct_cd;
	if (SQLCODE != 0)
	{
		printf("select furdate error.. [%d:%s]\n", SQLCODE, SQLERRM);
		return (-3);
	}

	// TR INPUT 세팅
	tri = (W3370A01_I *)&sndbuf[COMHDR_LEN];

// tri->fx_ordr_ymd                  // FX주문년월일
	memcpy(tri->fx_ordr_ymd, v_bizdate, sizeof(tri->fx_ordr_ymd));
// tri->lgen_no                      // lgen_no
	memcpy(tri->lgen_no, lgen_no, sizeof(tri->lgen_no));	// "0000101936"
// tri->fx_ordr_dstcd                // FX주문구분코드(1-신규, 2-정정, 3-취소)	
	tri->fx_ordr_dstcd[0] = '1';
// tri->fx_tran_ptrncd               // FX거래유형코드('1'-일반, '2'-MAR, '3'-RFQ, '4'-RFS)
	tri->fx_tran_ptrncd[0] = '1';
// tri->auto_tran_dstcd              // 자동거래구분코드('1'-일반, '2'-AH, '3'-MM, '4'-AH(MAR), '5'-AH(API))
	tri->auto_tran_dstcd[0] = '1';
// tri->fx_prdct_dstcd               // FX상품구분(1-TD, 2-TOM, 3-현물환, 4-선물환, 5-스왑, 6-바로환전, 7-NDF)
	tri->fx_prdct_dstcd[0] = prdct_dstcd;
// tri->fx_prdct_cd                  // FX상품코드
	memcpy(tri->fx_prdct_cd, pfold->symb, sizeof(tri->fx_prdct_cd));
// tri->pyacc_ymd                    // 결제년월일
	memcpy(tri->pyacc_ymd, v_furdate, sizeof(v_furdate));
// tri->fx_deal_dstcd                // FX매매구분코드(1-매수(BID-BUY, SELL & BUY), 2-매도(ASK-SELL, BUY & SELL))
	tri->fx_deal_dstcd[0] = side;
// tri->fx_ofpr_dstcd                // FX호가구분코드('1'-시장가, '2'-지정가, '3'-예약(STOP), '4'-OCO, '5'-SOR)
	tri->fx_ofpr_dstcd[0] = '1';
// tri->fx_ordr_prc                  // FX주문가격
	double prc = (side=='1'?pfold->offerlast:pfold->bidlast);
	sprintf(stemp, "%.*f", pfold->zCustdiv, prc);
	memcpy(tri->fx_ordr_prc, stemp, sizeof(tri->fx_ordr_prc));
// tri->ordr_qanty                   // FX주문수량
	MEMCPY(tri->ordr_qanty, ordqty);//, sizeof(o->orderqty));			// o->orderqty[16] 가 더 작음.
// tri->base_cncycd                  // 기준통화코드
	memcpy(tri->base_cncycd, pfold->symb, sizeof(tri->base_cncycd));
// tri->base_crncy_amt               // 기준통화금액
	MEMCPY(tri->base_crncy_amt, ordqty);//, sizeof(tri->ordr_qanty));
// tri->cnprt_cncycd                 // 상대통화코드
	memcpy(tri->cnprt_cncycd, &pfold->symb[3], sizeof(tri->cnprt_cncycd));
// tri->cnprt_crncy_amt              // 상대통화금액
	sprintf(stemp, "%.6f", prc * d_ordqty);
	MEMCPY(tri->cnprt_crncy_amt, stemp);
// tri->ntnl_cncycd                  // 관념통화코드
	memcpy(tri->ntnl_cncycd, pfold->symb, sizeof(tri->ntnl_cncycd));
// tri->ntnl_crncy_amt               // 관념통화금액
	MEMCPY(tri->ntnl_crncy_amt, ordqty);//, sizeof(tri->ntnl_crncy_amt));
// tri->ordr_end_ymd                 // 주문종료일자
	memcpy(tri->ordr_end_ymd, tri->fx_ordr_ymd, sizeof(tri->ordr_end_ymd));

tri->fx_spot_prc[0]           = '0';
tri->fx_spot_prc_mrkup[0]     = '0';
tri->fx_spot_prc_mrgn[0]      = '0';
tri->fx_swap_prc[0]           = '0';
tri->fx_swap_prc_mrkup[0]     = '0';
tri->fx_swap_prc_mrgn[0]      = '0';
tri->fx_ordr_prc_mrkup[0]     = '0';
tri->fx_ordr_prc_mrgn[0]      = '0';
tri->fx_obsr_dmnd_prc[0]      = '0';
tri->fx_obsr_pfrm_ordr_prc[0] = '0';

	//int mymq_call(MyMQ *mymq, const char *host, const char *xchg, const char *rkey, const char *sndb, int sndl, char **rcvb, int timeout)
	rlen = mymq_call(mymq, NULL, "dom", "W3370A01", sndbuf, sizeof(COMHDR) + sizeof(W3370A01_I), &prcv, 5);

	pcom = (COMHDR *)prcv;
	tro  = (W3370A01_O *)(prcv+COMHDR_LEN);

	printf("return comhdr [%d:%.1s:%.5s:%s]\n", rlen, pcom->rtyp, pcom->rcod, pcom->eflg);

	if (pcom->eflg[0] != '0') {
		printf("ERR : (%s) service(W3370A01) call error! (%.1s:%.5s)\n", __func__, pcom->rtyp, pcom->rcod);
		return (-1);
	}

	printf("[%s] OUT >>>>>>>>>>>>>>>>>>>>>>> \n",pcom->trxc);
	printf("fx_ordr_ymd   =[%.*s]\n", sizeof(tro->fx_ordr_ymd), tro->fx_ordr_ymd);  // FX주문년월일 
	printf("fx_ordr_no    =[%.*s]\n", sizeof(tro->fx_ordr_no ), tro->fx_ordr_no );  // FX주문번호

	free(prcv);

	return (0);
}

int function16(int ac, char **av)
{
	char	msg[128], prdct, side, lgen_no[10+1];
	char	symb[6+1], ordqty[16+1];
	MDFOLD *pfold; 

	memset(lgen_no, 0x00, sizeof(lgen_no));
	memset(symb,    0x00, sizeof(symb));
	memset(ordqty,  0x00, sizeof(ordqty));

	if (ac != 6) return (-1);

	l_db2connect();
// [LGEN_NO] [USDKRW] [1:TOD,2:TOM,3:현물,4:선물,6:바로환전] [1:BUY,2:SEL] [QTY]
	
	strcpy(lgen_no, av[1]);
	strcpy(symb, av[2]);
	prdct = av[3][0];
	side  = av[4][0];
	strcpy(ordqty, av[5]);

printf("INPUT : lgen=%s, symb=%s, prdct=%c, side=%c, qty=%s\n", lgen_no, symb, prdct, side, ordqty);

//	주문자정보 : 0000101936 (고정)
//	대상통화 : "USDKRW" (필요 시 arg 로 처리)

	pfold = mds_getfold("CUST", symb, msg);
	if (pfold == NULL) {
		printf("mds_getfold error [%s]\n", msg);
		return (-1);
	}

//int call_W3370A01(MDFOLD *pfold, char prdct_dstcd, char side)
// prdct : FX상품구분 (1-TD, 2-TOM, 3-현물환, 4-선물환, 5-스왑, 6-바로환전, 7-NDF)
// side  : 매매구분 (1-BUY, 2-SEL)
	call_W3370A01(pfold, lgen_no, prdct, side, ordqty);

	l_db2disconnect();

	return (0);
}

int function17(int ac, char **av)
{
	int		sterm=1, scnt, rcnt, dmax=100;
	int		port=30428;				// CUST PORT
	char	stemp[32];
	char	*ipad="127.0.0.1";
	char	rbuf[1024], sbuf[1024], msg[128];
	MDSSISE	*p=sbuf;
	
	if (ac > 1)		sterm = atoi(av[1]);

	int		ii, c_sock, options = 1;
	struct	in_addr		localif;
	struct	sockaddr_in	multisock;

	memset(&multisock, 0x00, sizeof(multisock));
	memset(&localif,   0x00, sizeof(localif));

	if ((c_sock = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP)) < 0)
	{
		printf("Cannot open a socket for AP (%d:%s)\n", errno, strerror(errno));
		return (-1);
	}

	multisock.sin_family		= AF_INET;
	multisock.sin_addr.s_addr	= inet_addr(ipad);
	multisock.sin_port			= htons(port);

	MDFOLD	 *pfold;

	pfold = mds_getfold("SMBS", "USDKRW", msg);
	if (pfold == NULL) {
		printf("mds_getfold error [%s]\n", msg);
		return (-1);
	}

	time_t	t;
	struct tm *tm;
	struct timeval tv;
	
	while (1)
	{
		memset(sbuf, 0x00, sizeof(sbuf));
		memset(stemp, 0x00, sizeof(stemp));

		t = gettimeofday(&tv, NULL);
		tm = localtime(&tv.tv_sec);

		p->excode[0] = 'S';
		memcpy(p->symb, pfold->symb, sizeof(p->symb));
		sprintf(stemp, "%04d%02d%02d", tm->tm_year+1900, tm->tm_mon+1, tm->tm_mday);
		memcpy(p->date, stemp, sizeof(p->date));
		sprintf(stemp, "%02d%02d%02d%03d", tm->tm_hour, tm->tm_min, tm->tm_sec, tv.tv_usec/1000);
		memcpy(p->time, stemp, sizeof(p->time));
		p->bidprc		= pfold->bidlast - (tm->tm_sec%10 * 0.01);
		p->bidbestprc	= pfold->bidbest;
		p->bidqty		= 1000000;
		p->offerprc		= pfold->offerlast + (tm->tm_sec%10 * 0.01);
		p->offerbestprc	= pfold->offerbest;
		p->offerqty		= 1000000;

		if (sendto(c_sock, sbuf, sizeof(MDSSISE), 0, (struct sockaddr *)&multisock, sizeof(multisock)) < 0)
			break;

		if (sterm <= 0)		getchar();
		else				sleep(sterm);
	}
	printf("================= send done..\n");

	close(c_sock);
		
	return (0);
}

uint32_t getnextday(int n)
{
    time_t  clock;  
    struct  tm tm;  
    int ymd;
    
    int d = n*24;
    
    clock = time(NULL);
    clock += (d*60*60);
    localtime_r(&clock, &tm);
    ymd = YMD((tm.tm_year+1900), (tm.tm_mon+1), tm.tm_mday);

    return (ymd);
}

AG_DQUE		qcom;
int			semk=0xffff0001;

void *func18(void *argv)
{
	int		ii, rc, slen, idx;
	char	sbuf[512];
	
	memset(sbuf, 0x00, sizeof(sbuf));
	
	idx = *((int *)argv);
	printf("[%d] start >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>> \n", idx);

	for (ii=0; ii<1000; ii++) {
		sprintf(sbuf, "%d.%d", idx, ii);
		slen = strlen(sbuf);
		rc = agdque_wrn (&qcom, WG_DAT_DIR, NULL, "YTEST", semk, 1024, sbuf, slen);
		usleep(10000);
	}

	printf("[%d] end >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>> \n", idx);
	pthread_exit(NULL);
}

int function18(int ac, char **av)
{
	int		ii, cnt, tot=1;
	pthread_t	tids[1024];
	memset(&qcom, 0x00, sizeof(qcom));

	AG_DQUECLS(&qcom);

	qcom.xha |= AQ_XHA_OPN;
	qcom.xha |= AG_XAS_LIV;

	if (ac > 1)		tot=atoi(av[1]);
	
	for (ii=0; ii<tot; ii++) {
		cnt=ii;
		pthread_create(&tids[ii], 0, func18, (void *)&cnt);
		usleep(50000);
	}

	for (ii=0; ii<tot; ii++)
		pthread_join(tids[ii], NULL);

	return (0);
}

int function19(int ac, char **av)
{
	int		rc, idx=1;
	char	sbuf[1024];
	JNLF	ejnl;

	memset(&ejnl, 0x00, sizeof(ejnl));
	sprintf(ejnl.jfname, "%s/%s", DF_AGR_JNL_PATH, DF_AGR_JNL_NAME);

printf("[%s]\n", ejnl.jfname);

	rc = JFopen(&ejnl, idx, 1);
	if (rc != 0)
	{
		printf("(%s) jfopen error.. (%d) (%s)\n", __func__, rc, strerror(errno));
		return (-1);
	}
	
	while (1)
	{
		memset(sbuf, 0x00, sizeof(sbuf));

		printf("write buff : ");
		scanf("%s", sbuf);

		ejnl.sndb = &sbuf;
		ejnl.sndl = strlen(sbuf);
		rc = JFpush(&ejnl);
	}

	return (0);
}

//////////////////////////////////////////////////////////////////////////////////////////
#define		DF_DLOG_QKEY		0x00990099
#define		MXLOGS		128

struct _dlog {
	char	pname	[128];
	int		logdate	;
	FILE	*logf	;
} dlogs[MXLOGS];

int f20(struct _dlog *plog, int loglen, char *logmsg)
{
	char	logpath[128];
	struct tm *tm;

	time_t	t=time(NULL);
	tm = localtime(&t);
	
	struct stat fst;
	sprintf(logpath, "%s-%04d%02d%02d.log", plog->pname, tm->tm_year+1900, tm->tm_mon+1, tm->tm_mday);

pid_t	lwp;
lwp = syscall(SYS_gettid);	//pthread_self();

	if (plog->logf == NULL || plog->logdate != tm->tm_mday)
	{
		if (plog->logf)		fclose(plog->logf);
	
		plog->logf    = fopen(logpath, "a+");
		plog->logdate = tm->tm_mday;
	}
	else
	{
		fstat(fileno(plog->logf), &fst);
	
		if (fst.st_nlink <= 0)
			plog->logf = fopen(logpath, "a+");
	}

flock(plog->logf, LOCK_EX);

	fprintf(plog->logf, "%u] %.*s\n", lwp, loglen, logmsg);
	fflush(plog->logf);

flock(plog->logf, LOCK_UN);

	return 0;
}

int func20(int dlen, char *rbuf)
{
	int		ii, msglen;
	char	*logmsg;
	char	pname[128];
	
	memset(pname, 0x00, sizeof(pname));

	for (ii=0; ii<dlen; ii++)
	{
		if (rbuf[ii] == ':') {
			memcpy(pname, rbuf, ii>sizeof(pname)?sizeof(pname):ii);
			logmsg = &rbuf[ii+1];
			msglen = dlen-ii-1;

			break;
		}
	}
	if (ii >= dlen)		return (-1);

//printf("pname=[%s] logmsg=[%d:%.*s]\n", pname, msglen, msglen, logmsg);

	struct tm *tm;
	time_t	t=time(NULL);
	tm = localtime(&t);

	// find pname
	for (ii=0; ii<MXLOGS; ii++)
	{
		if (strcmp(pname, dlogs[ii].pname) != 0)	continue;
			
		f20(&dlogs[ii], msglen, logmsg);

		return 0;
	}

	// new pname
	for (ii=0; ii<100; ii++)
	{
		// 일자가 지났거나 빈자리에 할당
		if (dlogs[ii].pname[0] == 0x00 || dlogs[ii].logdate != tm->tm_mday)
		{
			printf("\t allocate (%d) new pname (%s)\n", ii, pname);

			if (dlogs[ii].logf)		fclose(dlogs[ii].logf);

			memset(&dlogs[ii], 0x00, sizeof(struct _dlog));
			strncpy(dlogs[ii].pname, pname, sizeof(dlogs[ii].pname));
			dlogs[ii].logdate = tm->tm_mday;

			f20(&dlogs[ii], msglen, logmsg);

			return 0;
		}
	}

	return (-1);
}

void *thrd20(void *arg)
{
	int			rtn, qsize, msgid, idx=0;
	ssize_t		dlen;
	key_t		mkey;
	struct	message	msg;
	struct	msqid_ds msg_ds;

pid_t	lwp;
lwp = syscall(SYS_gettid);	//pthread_self();

printf("thread start..(%u)\n", lwp);

SETDMSG :

	if (msgid < 0)
	{
		qsize = 1024*1024;

		msgid = msgget(DF_DLOG_QKEY, IPC_CREAT | 0666);
		if(msgid < 0)
		{
			return -1;
		}
		memset(&msg_ds, 0x00, sizeof(msg_ds));
		if (msgctl(msgid, IPC_STAT, &msg_ds) == 0)
		{
			msg_ds.msg_qbytes = qsize;
			msgctl(msgid, IPC_SET, &msg_ds);
		}
	}

	while (1)
	{
		memset(&msg, 0x00, sizeof(msg));
    	
//		dlen = msgrcv(msgid, &msg, blen, idx, IPC_NOWAIT);
		dlen = msgrcv(msgid, &msg, qsize, idx, MSG_NOERROR);		// 버퍼보다 클 경우 잘라서 수신

		if(dlen == (ssize_t)-1)
		{
			usleep(500000);
			printf("(%s) msgrcv error (%d:%s)\n", __func__, errno, strerror(errno));
			
			msgid = (-1);
			goto SETDMSG;
		}

		if ((rtn=func20(dlen, msg.mtext)) < 0)
			printf("func20 error (%d)\n", rtn);
	}

	return (0);
}

int function20(int ac, char **av)
{
	int		ii, tot=5;
	pid_t	tids[10];

	for (ii=0; ii<tot; ii++) {
		pthread_create(&tids[ii], 0, thrd20, NULL);
		usleep(50000);
	}

	for (ii=0; ii<tot; ii++)
		pthread_join(&tids[ii], NULL);

	return 0;
}

