uint32_t len2int(unsigned char *b)
{
    uint32_t l = 0;
    int  i; 

    for (i = 0; i < 4; i++) 
    {
        l <<= 8;
        l += b[i];
    }
    return(l);
}

/*===============================================================
 * MAIN PROCESS
===============================================================*/
int main(int argc, char *argv[])
{
	int		rc, ii, idx;

//	l_db2connect();

	if (argc < 2 || argv[1][0] == '?') {
		printf("------------------\n");
		for(ii=0; ii <= FUNCMX; ii++)
		{
			if (FUNCS[ii].desc[0] != NULL)
				printf("function%02d : %s\n", ii, FUNCS[ii].desc);
		}
		printf("------------------\n");
		exit(0);
	}
		
	idx = atoi(argv[1]);
	if (idx < 0 || idx > FUNCMX)
	{
		printf("index error..\n");
		exit(0);
	}
	
	printf("--------------------------------------------\n");
	printf(" %s \n", FUNCS[idx].desc);
	printf("--------------------------------------------\n");
	rc = FUNCS[idx].f(argc-1, &argv[1]);
	printf("\n============== return : [%d] \n", rc);
	
//	l_db2disconnect();

	exit(0);
}

int str2hex(char *p)
{
	int		num=0;

	while (*p)
	{
		if (*p >= 'A' && *p <= 'F')			num = num * 16 + *p - 'A' + 10;
		else if (*p >= 'a' && *p <= 'f')	num = num * 16 + *p - 'a' + 10;
		else if (*p >= '0' && *p <= '9')	num = num * 16 + *p - '0';
		
		p++;
	}

	return num;
}

int strsplit (char *sep, char *istr, ...)		// int agetc_gettok (char *sep, char *istr, ...)
{
	va_list	trc;
	char	*tok, *ostr;
	
	if (sep == NULL || istr == NULL)
		return (-1);
	
	va_start(trc, istr);
	
	tok = strtok (istr, sep);
	while (tok != NULL)
	{
		tok  = strtok (AG_NULL, sep);
		if (tok == NULL)
			break;
	
		ostr = va_arg(trc, char *);
		if (ostr == NULL)
			break;
	
		sprintf (ostr, "%s", tok);
	}
	va_end(trc);

	return(0);
}

__inline int getinput(char *istr, int sz)
{
	memset(istr, 0x00, sz);
	fgets(istr, sz, stdin);

	if (istr[0] == '\n')	istr[0] = 0;
	else if (istr[strlen(istr)-1] == '\n')	istr[strlen(istr)-1] = 0;

	return (strlen(istr));	
}
