		  FROM	INST1.TSKEILM11 -- 거래참여자 CMBS한도내역
		 WHERE	GROUP_CO_CD = :JORD.s_group_co_cd
		   AND	LGEN_NO     = :JORD.s_lgen_no
		WITH UR;

		if (SQLCODE != SQL_SUCCESS)
		{
			if (SQLCODE == NO_DATA_FOUND)
			{
				printf("no order limit data for [%s]\n", JORD.s_fx_prdct_cd);
				return (ERR_USR_INFO*(-1));
			}
			printf("(%s:%d) select error [%d:%s]\n", __func__, __LINE__, SQLCODE, SQLERRM);
			return (ERR_SYSTEM*(-1));
		}
	}
	else
	{
	EXEC SQL
		SELECT A1.SPEX_TRAN_SCHAMT
			 , A1.FWRD_BUY_SCHAMT
			 , A1.FWRD_SELL_SCHAMT
			 , A1.FWRD_BUY_ANTICI_EXPIR_NOMN
			 , DECODE(B1.HOLDY_DSTCD, NULL, A1.BUY_LAST_YMD , B1.NXBIZ_YMD)
			 , A1.FWRD_SELL_ANTICI_EXPIR_NOMN
			 , DECODE(C1.HOLDY_DSTCD, NULL, A1.SELL_LAST_YMD, C1.NXBIZ_YMD)
		  INTO :JORD.d_spex_tran_schamt           
			 , :JORD.d_fwrd_buy_schamt            
			 , :JORD.d_fwrd_sell_schamt           
			 , :JORD.l_fwrd_buy_antici_expir_nomn 
			 , :JORD.s_buy_last_ymd 
			 , :JORD.l_fwrd_sell_antici_expir_nomn
			 , :JORD.s_sell_last_ymd 
		  FROM (
				SELECT A.GROUP_CO_CD                        AS GROUP_CO_CD                  -- 그룹회사코드
					 , A.SPEX_TRAN_SCHAMT                   AS SPEX_TRAN_SCHAMT             -- 현물환거래예정금액(한도금액)
					 , A.FWRD_BUY_SCHAMT                    AS FWRD_BUY_SCHAMT              -- 선물환매입예정금액(매입한도)
					 , A.FWRD_SELL_SCHAMT                   AS FWRD_SELL_SCHAMT             -- 선물환매도예정금액(매도한도)
					 , A.FWRD_BUY_ANTICI_EXPIR_NOMN         AS FWRD_BUY_ANTICI_EXPIR_NOMN   -- 선물환매입예상만기월수
					 , TO_CHAR(TO_DATE(:JORD.s_sp_pyacc_ymd, 'YYYYMMDD') + A.FWRD_BUY_ANTICI_EXPIR_NOMN MONTH, 'YYYYMMDD')
															   AS BUY_LAST_YMD
					 , A.FWRD_SELL_ANTICI_EXPIR_NOMN        AS FWRD_SELL_ANTICI_EXPIR_NOMN  -- 선물환매도예상만기월수
					 , TO_CHAR(TO_DATE(:JORD.s_sp_pyacc_ymd, 'YYYYMMDD') + A.FWRD_SELL_ANTICI_EXPIR_NOMN MONTH, 'YYYYMMDD')
															   AS SELL_LAST_YMD
				  FROM INST1.TSKEILM11 A -- 한도내역
				 WHERE A.GROUP_CO_CD = :JORD.s_group_co_cd
				   AND A.LGEN_NO     = :JORD.s_lgen_no
				   AND A.BASE_YMD    = :JORD.s_fx_ordr_ymd
			   ) A1
			 , INST1.TSKEIAM95 B1 -- 영업일정보(BUY) 
			 , INST1.TSKEIAM95 C1 -- 영업일정보(SELL)
		 WHERE A1.GROUP_CO_CD   = B1.GROUP_CO_CD(+)
		   AND '00'             = B1.CLND_DSTCD (+)
		   AND A1.BUY_LAST_YMD  = B1.BASE_YMD   (+)
		   AND A1.GROUP_CO_CD   = C1.GROUP_CO_CD(+)
		   AND '00'             = C1.CLND_DSTCD (+)
		   AND A1.SELL_LAST_YMD = C1.BASE_YMD   (+)
	
		;
	}

	d_limit_s_amt  = 0.0;
	d_limit_fa_amt = 0.0;
	d_limit_fb_amt = 0.0;

	EXEC SQL
	SELECT CAST(ROUND(:JORD.d_ote_usd_bid_amt + :JORD.d_ote_usd_bid_namt + :JORD.d_ote_usd_ask_amt + :JORD.d_ote_usd_ask_namt, 2) AS DECIMAL(20, 2))
		 , CAST(ROUND(:JORD.d_fwd_usd_bid_amt + :JORD.d_fwd_usd_bid_namt, 2) AS DECIMAL(20,2))
		 , CAST(ROUND(:JORD.d_fwd_usd_ask_amt + :JORD.d_fwd_usd_ask_namt, 2) AS DECIMAL(20,2))
	  INTO :d_limit_s_amt
		 , :d_limit_fb_amt
		 , :d_limit_fa_amt
	  FROM SYSIBM.DUAL
	;

	if (SQLCODE != SQL_SUCCESS)
	{
		printf("select error 2 [%d:%s]\n", SQLCODE, SQLERRM);
		return (-1);
	}
	printf("\n==========================================");
	printf("현물환    한도금액(달러) = [%lf] \n", JORD.d_spex_tran_schamt);
	printf("선물환매수한도금액(달러) = [%lf] \n", JORD.d_fwrd_buy_schamt );
	printf("선물환매도한도금액(달러) = [%lf] \n", JORD.d_fwrd_sell_schamt);
	printf("선물환매수가능최종일자   = [%s]  \n", JORD.s_buy_last_ymd    );
	printf("선물환매도가능최종일자   = [%s]  \n", JORD.s_sell_last_ymd   );

	printf("현물환    매매금액(달러) = [%.10f] \n", d_limit_s_amt );
	printf("선물환매수매매금액(달러) = [%.10f] \n", d_limit_fb_amt);
	printf("선물환매도매매금액(달러) = [%.10f] \n", d_limit_fa_amt);

	//---------------------------------------------------------------------
	// 3.E.2 한도금액을 체크한다.
	//---------------------------------------------------------------------
	// SWAP은 FAR만 체크하기로 함. : 2023.03.07 BY P.B.Y
	//---------------------------------------------------------------------
	if (JORD.s_fx_prdct_dstcd[0] == ECM_PRDCT_DSTCD_SWAP)
	{
		// ------------------------------------------------------
		// FAR 체크
		// ------------------------------------------------------
		if (JORD.s_fr_prdct_dstcd[0] == ECM_PRDCT_DSTCD_TOD ||
			JORD.s_fr_prdct_dstcd[0] == ECM_PRDCT_DSTCD_TOM ||
			JORD.s_fr_prdct_dstcd[0] == ECM_PRDCT_DSTCD_SP  )
		{
			// TOD, TOM, SP인 경우
			if (d_limit_s_amt > JORD.d_spex_tran_schamt)
			{
				printf("1 [%4d] 총액 > 한도금액 = [%.10f]>[%.10f]\n", __LINE__, d_limit_s_amt, JORD.d_spex_tran_schamt);
				return (RET_FAILURE);
			}
		}
		else
		{
			// FWD 인 경우
			if (JORD.s_fr_deal_dstcd[0] == ECM_DEAL_DSTCD_BUY)
			{
				if (d_limit_fb_amt > JORD.d_fwrd_buy_schamt)
				{
					printf("2 [%4d] 매수금액 > 매수한도금액 = [%.10f]>[%.10f]\n", __LINE__, d_limit_fb_amt, JORD.d_fwrd_buy_schamt);
					return (RET_FAILURE);
				}
			}
			else
			{
				if (d_limit_fa_amt > JORD.d_fwrd_sell_schamt)
				{
					printf("3 [%4d] 매도금액 > 매도한도금액 = [%.10f]>[%.10f]\n", __LINE__, d_limit_fa_amt, JORD.d_fwrd_sell_schamt);
					return (RET_FAILURE);
				}
			}
		}
	}
	else
	{
		if (JORD.s_fx_prdct_dstcd[0] == ECM_PRDCT_DSTCD_TOD ||
			JORD.s_fx_prdct_dstcd[0] == ECM_PRDCT_DSTCD_TOM ||
			JORD.s_fx_prdct_dstcd[0] == ECM_PRDCT_DSTCD_SP  ||
			JORD.s_fx_prdct_dstcd[0] == ECM_PRDCT_DSTCD_MAR )
		{
			// TOD, TOM, SPOT, MAR인경우
			if (d_limit_s_amt > JORD.d_spex_tran_schamt)
			{
				printf("4 [%4d] 총액 > 한도금액 = [%.10f]>[%.10f]\n", __LINE__, d_limit_s_amt, JORD.d_spex_tran_schamt);
				return (RET_FAILURE);
			}
		}
		else
		{
			// FWD                인경우 
			if (JORD.s_fx_deal_dstcd[0] == ECM_DEAL_DSTCD_BUY)
			{
				if (d_limit_fb_amt > JORD.d_fwrd_buy_schamt)
				{
					printf("5 [%4d] 매수금액 > 매수한도금액 = [%.10f]>[%.10f]\n", __LINE__, d_limit_fb_amt, JORD.d_fwrd_buy_schamt);
					return (RET_FAILURE);
				}
			}
			else
			{
				if (d_limit_fa_amt > JORD.d_fwrd_sell_schamt)
				{
					printf("6 [%4d] 매도금액 > 매도한도금액 = [%.10f]>[%.10f]\n", __LINE__, d_limit_fa_amt, JORD.d_fwrd_sell_schamt);
					return (RET_FAILURE);
				}
			}
		}
	}
	
	printf("\n한도체크 OK..\n");
*/
	return (0);
}

int function6(int ac, char **av)
{
	E_MSG		e_msg;
	MRKFEE_ST	mrgn;
	char		stemp[128];

	memset(&mrgn,  0x00, sizeof(mrgn));
	memset(&e_msg, 0x00, sizeof(e_msg));
/*
typedef struct {
    char      s_proc_gb          [  1+1];  // [INPUT] 고객구분('1'-고객, '2'-직원)
    char      s_base_ymd         [  8+1];  // 기준일자
    char      s_lgen_no          [ 10+1];  // [INPUT] 고객구분에 따라 시장참여자번호(10) OR 트레이더번호(4)
    char      s_fx_prdct_dstcd   [  1+1];  // [INPUT] FX상품구분드(FX상품구분코드 : '1'-TOD', '2'-'TOM', '3'-'SP(현물환)', '4'-'FWD', '5'-'SW', '6'-'바로현물환', '7'-NDF, '8'-MAR)
                                           // '3', '6', '8' --> SPOT 마크업, 마진. 필요..
                                           // '3', '6', '8' 제외하면 --> SPOT, SWAP 마크업, 마진필요.
    char      s_fx_prdct_cd      [  6+1];  // [INPUT] FX상품코드
    char      s_pyacc_ymd_gb     [  1+1];  // [INPUT] 만기년월일구분('1'-고객, '2'-직원)
    char      s_fx_pyacc_ymd     [  8+1];  // [INPUT] FX만기년월일
    char      s_fx_deal_dstcd    [  1+1];  // [INPUT] FX매매구분코드('1'-매수(Sell&Buy), '2'-매도(Buy&Sell))
    char      s_mrkoper_dstcd    [  1+1];  // [INPUT] 장운영구분코드('1'-SMBS마감전, '2'-SMBS마감후)
    char      s_mrkup_group_id   [  3+1];  // [OUTPUT]마크어그룹ID
    double    d_spot_mrkup              ;  // [OUTPUT]마크업
    double    d_spot_mrgn               ;  // [OUTPUT]마진(수수료)
    double    d_swap_mrkup              ;  // [OUTPUT]마크업
    double    d_swap_mrgn               ;  // [OUTPUT]마진(수수료)
} MRKFEE_ST;
*/
	printf("base_ymd : ");
	scanf("%s", stemp);
	if (strlen(stemp) != sizeof(mrgn.s_base_ymd)-1)	return (-1);
	memcpy(mrgn.s_base_ymd, stemp, sizeof(mrgn.s_base_ymd)-1);

	printf("lgen_no : ");
	scanf("%s", stemp);
	if (strlen(stemp) != sizeof(mrgn.s_lgen_no)-1)	return (-2);
	memcpy(mrgn.s_lgen_no, stemp, sizeof(mrgn.s_lgen_no)-1);

	printf("1=TD,2=TOM,3=Spot,4=Forward,5=FXSwap,6=바로환전 : ");
	scanf("%s", stemp);
	if (strlen(stemp) != sizeof(mrgn.s_fx_prdct_dstcd)-1)	return (-5);
	memcpy(mrgn.s_fx_prdct_dstcd, stemp, sizeof(mrgn.s_fx_prdct_dstcd)-1);

	printf("symb : ");
	scanf("%s", stemp);
	if (strlen(stemp) != sizeof(mrgn.s_fx_prdct_cd)-1)	return (-3);
	memcpy(mrgn.s_fx_prdct_cd, stemp, sizeof(mrgn.s_fx_prdct_cd)-1);

	printf("exp_ymd : ");
	scanf("%s", stemp);
	if (strlen(stemp) != sizeof(mrgn.s_fx_pyacc_ymd)-1)	return (-1);
	memcpy(mrgn.s_fx_pyacc_ymd, stemp, sizeof(mrgn.s_fx_pyacc_ymd)-1);
	
	printf("1=BUY(S&B), 2=SEL(B&S) : ");
	scanf("%s", stemp);
	if (strlen(stemp) != sizeof(mrgn.s_fx_prdct_dstcd)-1)	return (-6);
	memcpy(mrgn.s_fx_deal_dstcd, stemp, sizeof(mrgn.s_fx_deal_dstcd)-1);
////////////////////	
	mrgn.s_mrkoper_dstcd[0] = '3';	// [INPUT] 장운영구분코드('1'-SMBS마감전, '2'-SMBS마감후, '3'-자동)
	mrgn.s_pyacc_ymd_gb[0]	= '1';			// [INPUT] 만기년월일구분('1'-고객, '2'-직원)
	mrgn.s_proc_gb[0]		= '1';			// [INPUT] 고객구분('1'-고객, '2'-직원)

	printf("call f_get_mrkup_fee ........");
	//int f_get_mrkup_fee(MRKFEE_ST *mrkfee_st, E_MSG *e_msg)
//	if (f_get_mrkup_fee(&mrgn, &e_msg) < 0)
	{
		printf("f_get_mrkup_fee error (%s:%s)\n", e_msg.code, e_msg.mesg);
		return (-1);
	}

	printf("s_mrkup_group_id =[%f]\n", mrgn.s_mrkup_group_id);  // [OUTPUT]마크업그룹ID
	printf("d_spot_mrkup     =[%f]\n", mrgn.d_spot_mrkup    );  // [OUTPUT]마크업
	printf("d_spot_mrgn      =[%f]\n", mrgn.d_spot_mrgn     );  // [OUTPUT]마진(수수료)
	printf("d_swap_mrkup     =[%f]\n", mrgn.d_swap_mrkup    );  // [OUTPUT]마크업
	printf("d_swap_mrgn      =[%f]\n", mrgn.d_swap_mrgn     );  // [OUTPUT]마진(수수료)

	return (0);
}

int function7(int ac, char **av)
{
	int		rc;
	char	symb[6+1], stemp[36];
	char	rejmsg[128];

	memset(symb, 0x00, sizeof(symb));
	memset(rejmsg, 0x00, sizeof(rejmsg));

	printf("symb : ");
	scanf("%s", stemp);
	if (strlen(stemp) != 6)		return (-1);
	memcpy(symb, stemp, 6);

	rc = mds_updt_custfeed("CUST", symb, rejmsg);

	printf("rc=[%d] msg=[%s]\n", rc, rejmsg);

	return (0);
}

int function8(int ac, char **av)
{
