int function1(int ac, char **av)
{
	FILE *fp;
	char	buf[1024], cmd[128], output[1024*10];

	memset(cmd,    0x00, sizeof(cmd));
	memset(buf,    0x00, sizeof(buf));
	memset(output, 0x00, sizeof(output));

	sprintf(cmd, "/fsfxwin/mymq/bin/lswho | awk '{if (NR>2 && NF>4) printf(\"%%s,%%s\\n\", substr($0,7,7), substr($0, 37,15))}' | uniq -c");
	printf("cmd=[%s]\n", cmd);
	if ((fp = popen(cmd, "r")) == NULL)
		exit(-1);

	while (fgets(buf, sizeof(buf), fp))
	{
		strncpy(&output[strlen(output)], buf, strlen(buf));

		if (strlen(output) >= sizeof(output))
			break;
	}

	printf("[%s]\n", output);

	pclose(fp);
	
	return (0);
}

int function2(int ac, char **av)
{
	int		rc;
	char	targetid[50+1], trdstat[2], autohedge[2], emsg[256];
	
	memset(targetid,  0x00, sizeof(targetid));
	memset(trdstat,   0x00, sizeof(trdstat));
	memset(autohedge, 0x00, sizeof(autohedge));
	memset(emsg,      0x00, sizeof(emsg));

	printf("targetid : ");
	scanf("%s", targetid);
	if (strlen(targetid) <= 0)	return (-1);

	rc = getapistatus(targetid, trdstat, autohedge, emsg);
	
	printf("current : target[%s] trd[%.1s] hdg[%.1s] msg[%s]\n", rc, targetid, trdstat, autohedge, emsg);

	printf("]nSETUP >>>>>");	
	printf("trdstat : ");
	scanf("%s", trdstat);
	if (strlen(targetid) != 1)	return (-2);

	printf("autohedge : ");
	scanf("%s", autohedge);
	if (strlen(autohedge) != 1)	return (-3);

	rc = setapistatus(targetid, trdstat, autohedge, emsg);
	if (rc < 0)
	{
		printf("error [%d:%s]\n", rc, emsg);
		return (-1);
	}
	printf("\n## setapistatus done..\n"); 

	return (0);
}

int function3(int ac, char **av)
{
	int		shmid;
	char	rejmsg[128], stemp[32];
	WGMST	*wgmst;

	shmid = shmget(WG_SHMKEY, 0, 0);
	if (shmid < 0)
	{
		sprintf(rejmsg,"(%s) create shared memory error (%d/%s)", __func__, errno, strerror(errno));
		return (-1);
	}

	wgmst = (WGMST *)shmat(shmid, 0, 0);
	if (wgmst == NULL)
	{
		sprintf(rejmsg, "(%s) shared memory attach error (%d/%s)", __func__, errno, strerror(errno));
		return (-2);
	}

	printf("new mrkuptime(%.6s) : ", wgmst->updtmkup);
	scanf("%s", stemp);
	if (strlen(stemp) != sizeof(wgmst->updtmkup))	return (-1);
	
	memcpy(wgmst->updtmkup, stemp, sizeof(wgmst->updtmkup));

	printf("\n>>>> update mrkuptime done.. (%.6s)\n", wgmst->updtmkup);

	return (0);
}

int function4(int ac, char **av)
{
	int		scnt, rcnt, dmax=100;
	int		mport=0;				// DF_RFQ_PORT
	char	stemp[32];
	char	mipad[16]; // = "227.10.20.10";	// DF_MDS_MCAST
	char	rbuf[1024], sbuf[1024];

	memset(mipad, 0x00, sizeof(mipad));

	printf("svr / cli : ");
	scanf("%s", stemp);

	if (strcmp(stemp, "cli") == 0)
	{
		int		ii, c_sock, options = 1;
		struct	in_addr		localif;
		struct	sockaddr_in	multisock;

//		printf("port (C:30020,S:30021,K:30022,E:30023,R:30024,Z:30028,B:30029) : ");
		printf("port (C:30420,S:30410,K:30422,E:30423,R:30424,Z:30428,B:30429) : ");
		scanf("%d", &mport);
//		printf("multicast (apreal=227.10.20.10) : ");
//		scanf("%s", mipad);

		memset(&multisock, 0x00, sizeof(multisock));
		memset(&localif,   0x00, sizeof(localif));

		if ((c_sock = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP)) < 0)
		{
			printf("Cannot open a socket for AP (%d:%s)\n", errno, strerror(errno));
			return (-1);
		}

		multisock.sin_family		= AF_INET;
		multisock.sin_addr.s_addr	= inet_addr("127.0.0.1");
		multisock.sin_port			= htons(mport);
/*
		// LOOPBACK OPTION ON
		options = 1;
		if (setsockopt(c_sock, IPPROTO_IP, IP_MULTICAST_LOOP, (void *)&options, sizeof(options)) != 0)
		{
			printf("Set socketoption Failed 1. %s.%d (%s)\n", mipad, mport, strerror(errno));
			close(c_sock);
			return (-1);
		}

		// TTL OPTION = 1
		options = 1;
		if (setsockopt(c_sock, IPPROTO_IP, IP_MULTICAST_TTL, (void *)&options, sizeof(options)) != 0)
		{
			printf("Set socketoption Failed 2. %s.%d (%s)", mipad, mport, strerror(errno));
			close(c_sock);
			return (-1);
		}
*/
		// MULTICAST INTERFACE
		/*
		//localif.s_addr = inet_addr("10.38.111.75");
		localif.s_addr = inet_addr("127.0.0.1");
		if (setsockopt(c_sock, IPPROTO_IP, IP_MULTICAST_IF, (void *)&localif, sizeof(localif)) != 0)
		{
			printf("Set socketoption Failed 3. %s.%d (%s)", mipad, mport, strerror(errno));
			close(c_sock);
			return (-1);
		}
		*/
		
		char	fname[128];
		int 	term, cnt, tcnt=0;

		printf("filename : ");
		scanf("%s", fname);
		FILE *fp = fopen(fname, "r");
		if (!fp) {
			perror("fopen error : ");
			return (-1);
		}
		printf("count/sec : ");
		scanf("%d", &cnt);
		term = 1000000 / cnt;

		while (fgets(sbuf, sizeof(sbuf), fp))
		{
			printf("[%7d:%4d:%.140s]\n", tcnt, strlen(sbuf), sbuf);
if (strstr(sbuf, "270=0.0") != NULL && tcnt>5000)	getchar();
			if (sendto(c_sock, sbuf, strlen(sbuf), 0, (struct sockaddr *)&multisock, sizeof(multisock)) < 0)
				break;
			tcnt++;
			usleep(term);
			if (tcnt%cnt == 0)	sleep(2);

			memset(sbuf, 0x00, sizeof(sbuf));
		}

		printf("================= send done..\n");
		
		fclose(fp);
		close(c_sock);
	}
	else if (strcmp(stemp, "svr") == 0)
	{
		int		ii, rc, dlen;
		struct timeval	tmout, tv1, tv2;
		fd_set	fds;

		memset(rbuf, 0x00, sizeof(rbuf));

		int		rsock, bsize, options = 1;
		in_addr_t addr;
		struct	sockaddr_in svrsock, clisock;
		struct	ip_mreq ip_mreq;
		socklen_t socklen = sizeof(svrsock);

		printf("port (C:30020,S:30021,K:30022,E:30023,R:30024,Z:30028,B:30029) : ");
		scanf("%d", &mport);
		printf("multicast (apreal=227.10.20.10) : ");
		scanf("%s", mipad);

		memset(&svrsock, 0, sizeof(svrsock));
		memset(&clisock, 0, sizeof(clisock));	

		if ((rsock = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP)) < 0)
		{
			printf("Cannot open a socket for %s.%d\n", mipad, mport);
			return (-1);
		}

		options = 1;
		setsockopt(rsock, SOL_SOCKET, SO_REUSEADDR, &options, sizeof(options));
		
		bsize = 80 * 1024;
		setsockopt(rsock, SOL_SOCKET, SO_RCVBUF, &bsize, sizeof(int));

		svrsock.sin_family = AF_INET;
		svrsock.sin_addr.s_addr = INADDR_ANY;
		svrsock.sin_port = htons(mport);

		ip_mreq.imr_multiaddr.s_addr = inet_addr(mipad);
		ip_mreq.imr_interface.s_addr = htonl(INADDR_ANY);
		if (setsockopt(rsock, IPPROTO_IP, IP_ADD_MEMBERSHIP, (void *)&ip_mreq, sizeof(ip_mreq)) != 0)
		{
			printf("Cannnot add a multicast member for %s.%d\n", mipad, mport);
			close(rsock);
			return (-1);
		}

		if (bind(rsock, (struct sockaddr *)&svrsock, sizeof(svrsock)) != 0)
		{
			printf("Cannot bind a socket for %s.%d\n", mipad, mport);
			close(rsock);
			return (-1);
		}

		printf("udp server start..\n");
		
		rcnt = 0;
		while (1)
		{
			memset(rbuf, 0x00, sizeof(rbuf));

			tmout.tv_sec  = 0;
			tmout.tv_usec = 0;

			FD_ZERO(&fds);
			FD_SET(rsock, &fds);

			rc = select (rsock+1, &fds, NULL, NULL, &tmout);
			if (rc == 0)	continue;
			if (rc < 0)		break;

			if (FD_ISSET(rsock, &fds))
			{
				dlen = read(rsock, rbuf, sizeof(rbuf));
				if (dlen > 0)	rcnt++;
printf("(%d) rcv (%d:%.*s)\n", rcnt, dlen, dlen, rbuf);
				if (rcnt >= dmax)	break;	
				if (rcnt == 1)	gettimeofday(&tv1, NULL);
			}
		}
		printf("rbuf=[%s]\n", rbuf);
/*
		double tdif;
		gettimeofday(&tv2, NULL);
		tdif = (tv2.tv_sec*1000+(tv2.tv_usec/1000))-(tv1.tv_sec*1000+(tv1.tv_usec/1000));	
		printf("data count : %d [%f sec]\n", rcnt, tdif/1000);
*/
		close(rsock);
	}
	else	return (-1);

	return (0);
}

