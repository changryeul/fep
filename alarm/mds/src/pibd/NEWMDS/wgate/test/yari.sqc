int _printDb2SessionID(char *ssid)
{
EXEC SQL BEGIN DECLARE SECTION;
    char    c_ssid  [128];  
EXEC SQL END DECLARE SECTION;

    memset(c_ssid, 0x00, sizeof(c_ssid));

EXEC SQL
    SELECT APPLICATION_ID() 
      INTO :c_ssid 
      FROM SYSIBM.SYSDUMMY1
    ;
    if (SQLCODE != 0)
    {
        printf("[%s] get sesstion ID error.. [%d:%s]\n", __func__, SQLCODE, SQLERRM);
        return(-1);
    }

    l_rtrim(c_ssid);
    strcpy(ssid, c_ssid);

    return (0);
}

void *dbtest(void *argv)
{
	int		rc, idx;
	pthread_t	tid;
	pid_t		pid;

	tid = pthread_self();
	pid = syscall(SYS_gettid);
//	pthread_detach(tid);

	idx = *((int *)argv) + 5;
	
	printf("[%lu] thread start..[%d]\n", pid, idx);
	rc = l_db2connect();
	if (rc != 0) {
		printf("[%lu] thread connect error [%d:%s]\n", pid, rc, SQLERRM);
		return (0);
	}
	char	ssid[128];
	_printDb2SessionID(ssid);
	printf("[%lu] thread connect...[ %s ]\n", pid, ssid);

EXEC SQL BEGIN DECLARE SECTION;
	char	v_date[8+1];
	char	c_stm[6+1];
EXEC SQL END DECLARE SECTION;

	memset(v_date, 0x00, sizeof(v_date));
	memset(c_stm,  0x00, sizeof(c_stm));

	sprintf(c_stm, "%06d", idx);
	l_rtrim(c_stm);

EXEC SQL
	UPDATE INST1.TSKEIAM88 SET APLY_START_HMS = :c_stm
	 WHERE FX_PRDCT_CD = 'AUDUSD'
	   AND FCM_ID = 'SMBS'
	;
	printf("(%lu) update set stm=[%s]\n", pid, c_stm);

sleep (idx);
	l_db2commit();

	printf("(%lu) commit [%s] [%d:%s]\n", pid, c_stm, SQLCODE, SQLERRM);

	rc = l_db2disconnect();
	printf("[%lu] thread disconnect...[%d:%s]\n", pid, rc, SQLERRM);

	return (0);
}

