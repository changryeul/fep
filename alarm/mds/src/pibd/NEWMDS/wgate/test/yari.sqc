// ############  int function13(int ac, char **av)
static void signal_block(sigset_t *sigsave) {
    sigset_t sig;
    sigfillset(&sig);
    sigdelset(&sig, SIGINT);
    sigprocmask(SIG_BLOCK, &sig, sigsave);
}

static void signal_unblock(sigset_t *sigsave) {
    sigprocmask(SIG_SETMASK, sigsave, NULL);
}

#define		RWLOCK
struct _y {
	pthread_mutex_t		mt;
	pthread_rwlock_t	rw;
	pthread_spinlock_t	sp;
	sem_t				sm;

	int		count;
} y;

int	LOOPCNT = 200;

void *proc_read(void *argv)
{
	int 		i, ltype;
	pthread_t	tid, lwp;
	struct timeval	tv;
	sigset_t sigset;		// 기존 시그널 저장

	tid = syscall(SYS_gettid);	//pthread_self();
	ltype = *((int *)argv);

	int	rsleep=0;
	
	rsleep = (rand()%1000) + 1;
	printf(">> [%d] %s.. usleep set=%d\n", tid, __func__, rsleep);
	while (y.count < LOOPCNT) {
		gettimeofday(&tv, NULL);
		printf(">> [%d] %s.. read lock         [%ld.%06ld]\n", tid, __func__, tv.tv_sec, tv.tv_usec);

if (ltype == 1)		// 1=mutex, 2=rwlock, 3=spin, 4=sem
	pthread_mutex_lock(&y.mt);
else if (ltype == 2)
	pthread_rwlock_rdlock(&y.rw);
else if (ltype == 4)
	sem_wait(&y.sm);

		gettimeofday(&tv, NULL);
		printf(">> [%d] %s.. read count[%5d] [%ld.%06ld]\n", tid, __func__, y.count, tv.tv_sec, tv.tv_usec);
//if (tid%10 == 2)	usleep(100000);

if (ltype == 1)		// 1=mutex, 2=rwlock, 3=spin, 4=sem
	pthread_mutex_unlock(&y.mt);
else if (ltype == 2)	
	pthread_rwlock_unlock(&y.rw);
else if (ltype == 4)
	sem_post(&y.sm);

		usleep(rsleep);
	}
	printf(">> [%d] %s.. done [%d]\n", tid, __func__, y.count);
	pthread_exit(NULL) ;
}

void *proc_write(void *argv)
{
	int 		i, ltype;
	pthread_t	tid;
	struct timeval	tv;
	sigset_t sigset;		// 기존 시그널 저장

	tid = syscall(SYS_gettid);	//pthread_self();
	ltype = *((int *)argv);

	int	rsleep=0;
	
	rsleep = (rand()%1000) + 1;
	printf(">> [%d] %s.. usleep set=%d\n", tid, __func__, rsleep);
	
	while (y.count < LOOPCNT) {
		gettimeofday(&tv, NULL);
		printf(">> [%d] %s. writ lock         [%ld.%06ld]\n", tid, __func__, tv.tv_sec, tv.tv_usec);
signal_block(&sigset);

if (ltype == 1)		// 1=mutex, 2=rwlock, 3=spin, 4=sem
	pthread_mutex_lock(&y.mt);
else if (ltype == 2)
	pthread_rwlock_wrlock(&y.rw);
else if (ltype == 4)
	sem_wait(&y.sm);

		if (y.count >= LOOPCNT)
		{
			printf(">> [%d] %s.. write break\n", tid, __func__);

if (ltype == 1)		// 1=mutex, 2=rwlock, 3=spin, 4=sem
	pthread_mutex_unlock(&y.mt);
else if (ltype == 2)
	pthread_rwlock_unlock(&y.rw);
else if (ltype == 4)
	sem_post(&y.sm);

signal_unblock(&sigset);
			break;
		}
		y.count++;
		gettimeofday(&tv, NULL);
		printf(">> [%d] %s. writ count[%5d] [%ld.%06ld]\n", tid, __func__, y.count, tv.tv_sec, tv.tv_usec);
		usleep(rsleep);

if (ltype == 1)		// 1=mutex, 2=rwlock, 3=spin, 4=sem
	pthread_mutex_unlock(&y.mt);
else if (ltype==2)
	pthread_rwlock_unlock(&y.rw);
else if (ltype == 4)
	sem_post(&y.sm);

signal_unblock(&sigset);
		usleep(rsleep);
	}
	printf(">> [%d] %s.. done [%d]\n", tid, __func__, y.count);
	pthread_exit(NULL) ;
}

int function13(int ac, char **av)
{
	int		ltype=0, wcnt=0, rcnt=0;

if (ac == 5) {
	ltype = atoi(av[1]);
	wcnt = atoi(av[2]);
	rcnt = atoi(av[3]);
	LOOPCNT = atoi(av[4]);
} else {
	printf("lock type (1=mutex, 2=rwlock, 3=spin, 4=sem) : ");
	scanf("%d", &ltype);
	printf("write thread count : ");
	scanf("%d", &wcnt);
	printf("read thread count : ");
	scanf("%d", &rcnt);

	printf("loop count : ");
	scanf("%d", &LOOPCNT);
}
	memset(&y, 0x00, sizeof(struct _y));

	pthread_mutexattr_t mutattr;
	pthread_mutexattr_init(&mutattr);
	pthread_mutexattr_setpshared(&mutattr, PTHREAD_PROCESS_SHARED);
	pthread_mutex_init(&y.mt, &mutattr);
	pthread_mutexattr_destroy(&mutattr);

	pthread_rwlockattr_t rw_attr;
	pthread_rwlockattr_init (&rw_attr);
	pthread_rwlockattr_setpshared (&rw_attr, PTHREAD_PROCESS_SHARED);
	pthread_rwlock_init(&y.rw, &rw_attr);
	pthread_rwlockattr_destroy(&rw_attr);

	pthread_condattr_t cattr1;
	pthread_condattr_init(&cattr1);
	pthread_condattr_setpshared(&cattr1, PTHREAD_PROCESS_SHARED);
	pthread_cond_init(&y.sp, &cattr1);
	pthread_condattr_destroy(&cattr1);

	sem_init(&y.sm, 1, 1);

	int		rc, ii;
	pthread_t	tids[1024];

	for (ii=0; ii<rcnt; ii++)
	{
		pthread_create(&tids[ii], NULL, proc_read, (void *)&ltype);
		printf("[%d] thread create\n", ii);
		//usleep(10000);
	}

	for (ii=rcnt; ii<rcnt+wcnt; ii++)
	{
		pthread_create(&tids[ii], NULL, proc_write, (void *)&ltype);
		printf("[%d] thread create\n", ii);
		//usleep(10000);
	}

	for (ii=0; ii<rcnt+wcnt; ii++)
		pthread_join(tids[ii], NULL);

printf(" #########################\n");
printf("count [%d] <> [%d]\n", y.count, LOOPCNT);
	return (0);
}

