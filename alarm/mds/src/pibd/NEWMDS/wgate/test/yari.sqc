struct tm *ct, *ut;

ct = localtime(&dque.hdr.ctime.now.tv_sec);
ut = localtime(&dque.hdr.utime.now.tv_sec);

	printf("create [%02d%02d%02d %02d:%02d:%02d] update [%02d%02d%02d %02d:%02d:%02d]\n", 
		ct->tm_year+1900, ct->tm_mon+1, ct->tm_mday, ct->tm_hour, ct->tm_min, ct->tm_sec,
		ut->tm_year+1900, ut->tm_mon+1, ut->tm_mday, ut->tm_hour, ut->tm_min, ut->tm_sec);

	printf("wno=[%d] \n", dque.hdr.wno);
	
	for (ii=0; ii<16; ii++)
	{
		if (dque.hdr.rno[ii] > 0)
			printf("(%d:%d) ", ii, dque.hdr.rno[ii]);
	}

	printf("\n");

#if 0		// DQ read count 조정
	rc = agdque_at (&dque, WG_DAT_DIR, NULL, DQ_RCVRQ, SEM_RCVRQ, sizeof(rbuf));
	if (rc < 0)	{
		printf("\n agdque_at error.. [%d]\n", rc);
		exit(0);
	}
	
	memset(&rwno, 0x00, sizeof(rwno));
	
	printf("set aid[%d] read no [%d -> %d]\n", idx, dque.hdr.rno[idx], dque.hdr.wno);
	rwno[0] = dque.hdr.wno;
	rc = agdque_rwi_io (&dque, idx, &rwno); 
	if (rc < 0)	{
		printf("\n agdque_rwi_io error.. [%d]\n", rc);
		exit(0);
	}
#endif

	return; 
}

int function9(int ac, char **av)
{
	int			v_snln = 0, v_rcvl = 0;
	char		v_sndb[1024*4] = {0};
	char		*v_rcvb = NULL;
