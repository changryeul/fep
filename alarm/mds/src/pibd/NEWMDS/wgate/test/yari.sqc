	printf("symb : ");		scanf("%s", stemp);		if (strlen(stemp) != 6)		return (-1);
	memcpy(trin->PrdctCd, stemp, 6);				// 상품코드  
	printf("side(0/1/2) : ");	scanf("%s", stemp);		if (strlen(stemp) != 1)		return (-3);
	trin->DealDstic[0] = stemp[0];					// 매매구분 0:양방향 1:buy 2:sell
	printf("expdate : ");	scanf("%s", stemp);		if (strlen(stemp) != 8)		return (-4);
	memcpy(trin->NearExpireDate, stemp, 8);			// Near만기일
if (trin->PrdctClsfi[0] == '5') {
	printf("far date : ");	scanf("%s", stemp);		if (strlen(stemp) != 8)		return (-5);
	memcpy(trin->FarExpireDate,  stemp, 8);			// Far만기일 
}
	memcpy(trin->BaseCncycd, trin->PrdctCd, 3);		// 기준통화코드
	printf("qty : ");	scanf("%s", stemp);		if (strlen(stemp) <= 0)		return (-6);
	strcpy(trin->BaseCrncyAmt, stemp);			// 기준통화금액  
