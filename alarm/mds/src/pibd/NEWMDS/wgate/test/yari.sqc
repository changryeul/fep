static int f11(int *msgid, int idx, char *sbuf, int dlen)
{
	int		ret;
	struct message	msg;
	
	memset(&msg, 0x00, sizeof(msg));

	msg.mtype = idx;
	memcpy(msg.mtext, sbuf, dlen);

	while(1)
	{
		ret = msgsnd(14, &msg, dlen, IPC_NOWAIT);
		printf("ret=(%d)\n", ret);
		if(ret < 0)
		{
			if(errno == EINTR)
				continue;

			if(errno == EAGAIN)
				return 0;

			*msgid = (-1);
			printf("(%s) msgsnd error (%d:%s)\n", __func__, errno, strerror(errno));
		}
		break;
	}

	return (ret);
}

int func11(char *mcod, char *msg)
{
	int		slen=-1, key;
	char	sbuf[1024];
	static	__thread int qid=(-1);

	if((key = l_token(ECM_SMSSENDQUE, 'Q')) < 0) {		// /fsfxwin/wfg/inc/glb/gcomdef.h
		printf("l_token error..(%d:%s) \n", errno, strerror(errno));
		return (-1);
	}

	if ((qid = msgget(key, 0666)) < 0) {
		printf("msgget error..(%d:%s) \n", errno, strerror(errno));
		return (-1);
	}

	memset(sbuf, 0x00, sizeof(sbuf));

	// HEADER = 고객구분[1] + 알림메세지코드[5] + 거래ID[10] + 수신고객ID[10] + 발송직원번호[10] + 북번호[11]
	// 헤더 중 고객구분(C:고객,E:직원) 과 메시지코드(E0200) 만 세팅하고, 메시지 내용을 뒤로 붙임.
	// 세팅된 문구 중 '@'에 대체될 문자열과 대체열구분자'|'를 붙여서 전송함
	sprintf(sbuf, "E%-5.5s                                         %s|", mcod, msg);
	if (f11(&qid, 100L, sbuf, strlen(sbuf)) < 0)
		printf("msgsnd error..(%d:%s) \n", errno, strerror(errno));

	return (0);
}

int function11(int ac, char **av)
{
	int		rc;
	char	sndmsg[256];
	
	memset(sndmsg, 0x00, sizeof(sndmsg));

	printf("send msg : ");
	scanf("%s", sndmsg);
	
	if (func11("E0200", sndmsg) < 0)
		printf("send error..\n");

	return (0);
}

static size_t func12( char *ptr, size_t size, size_t nmemb, void *response)
{
	size_t	count = size * nmemb;
	if (response != NULL && count > 0)
		strncat(response, ptr, count);

	return count;
}

