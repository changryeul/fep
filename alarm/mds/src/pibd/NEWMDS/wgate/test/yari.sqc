#include "quelog.h"
int function21(int ac, char **av)
{
/*	
	int		rtn, msgid;
	char	buff[2048];
	struct	message	msg;

	msgid = msgget(DF_DLOG_QKEY, 0);
	if(msgid < 0)	return -1;

int	fnm=0;
*/
	int		ii, tcnt=0;
	char	logname[128];
	char	logmsg[1024];
	char	pname[2];

	memset(pname, 0x00, sizeof(pname));
	pname[0] = 'a';
	pname[1] = 'a';

	int div=5;

	if (ac > 1)		div = atoi(av[1]);

	struct _A {
		int		seq;
		char	pname[128];
	} A[50];
	memset(&A, 0x00, sizeof(A));

	for (ii=0; ii<div; ii++) {
		A[ii].seq = 0;
		memcpy(A[ii].pname, pname, sizeof(pname));
		pname[0]++; 	pname[1]++;
//		printf("[%s]\n", A[ii].pname);
	}

	int		a;
		
	while (1) {
		a = rand()%div;
		memset(logmsg, 0x00, sizeof(logmsg));
		sprintf(logmsg, "%05d", ++(A[a].seq));
		printf("[%d:%s:%s]\n", a, A[a].pname, logmsg);
		_sendtoLogQ(A[a].pname, NULL, strlen(logmsg), logmsg);

		if (tcnt++ > 10000)	break;
	}

	return 0;
}

//////////////////////////////////////////////////////////////////////////

#define		mxarr		5

typedef struct {
	char	c1[10];
	char	c2;
	int		i1;
	double	d1;
	double	d2;
	char	c3[32];
} AAA;

pthread_mutex_t		gmutex = PTHREAD_MUTEX_INITIALIZER;
static __thread int gint=0;
static AAA aaa[mxarr]={0,};

void *func22(void *arg)
{
	pid_t		lwp;
	int		v;

	lwp = syscall(SYS_gettid);

	v = *((int *)arg);

pthread_mutex_unlock(&gmutex);
aaa[v].i1 += v;
printf("[%7u]  v[%d] aaa[%.10s:%c:%d:%g:%g:%.32s]\n", lwp, v, aaa[v].c1 ,aaa[v].c2 ,aaa[v].i1 ,aaa[v].d1 ,aaa[v].d2 ,aaa[v].c3);

//	gint += v;
//	printf("[%u] v=[%d] [%d:0x%x]\n", lwp, v, gint, &gint);
	sleep(1);
	pthread_exit(NULL);
}

int function22(int ac, char **av)
{
	int			ii;
	pthread_t	tid[mxarr];

	memset(&aaa, 0x00, sizeof(aaa));

	for (ii=0; ii<mxarr; ii++)
	{
		aaa[ii].i1 = ii;
		sprintf(aaa[ii].c3, "%d", ii);
		sprintf(aaa[ii].c1, "%d", ii);
		aaa[ii].c2 = aaa[ii].c1[0];
printf("main.creat  [%d] aaa[%.10s:%c:%d:%g:%g:%.32s]\n", ii, aaa[ii].c1 ,aaa[ii].c2 ,aaa[ii].i1 ,aaa[ii].d1 ,aaa[ii].d2 ,aaa[ii].c3);

pthread_mutex_lock(&gmutex);
		pthread_create(&tid[ii], NULL, func22, (void *)&ii);
	}

	for (ii=0; ii<mxarr; ii++)
	{
printf("main.join   [%d] aaa[%.10s:%c:%d:%g:%g:%.32s]\n", ii, aaa[ii].c1 ,aaa[ii].c2 ,aaa[ii].i1 ,aaa[ii].d1 ,aaa[ii].d2 ,aaa[ii].c3);
		pthread_join(tid[ii], NULL);
	}

	return 0;
}
