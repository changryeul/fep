##########################################################################
#   Module  : makefile - PF (FX venue 시장)
#   File    : Make_PF.mk
#
#   시장 재편(A안): letter=시장이되, 시장 무관 크로스커팅은 PO로 모은다(설계 §5-3, §8-2).
#     자동전략(5xxx)·한도/리스크(9xxx)·접속서버(8xxx)·응답분배(1200계)·미니원장.
#   현 PA에서 시장별 주문/체결(1xxx·2xxx)을 빼내면 남는 잔여분이 정확히 PO.
#   빌드모델은 PC와 동일(설계 §6): 1 소스 = 1 바이너리, 인스턴스는 런타임 구분.
#   src/PF/ 에 소스가 없으면 안전하게 no-op.
##########################################################################

all: ALL END

ALL:
	sh ${_PF_MAKE}/Make_PF_all.sh

END:
	@echo "FEPp PF SRC Make End"

##########################################################################
#	End of File (Make_PF.mk)
##########################################################################
