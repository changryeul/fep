##########################################################################
#   Module  : makefile - PC (파생/선물옵션, KRX-direct)
#   File    : Make_PC.mk
#
#   시장 재편(A안): letter=시장. PC = 파생(선물/옵션). 전 시장 KRX-direct 통일.
#   빌드모델 개선(설계 §6): 컴파일타임 -D 다중바이너리 폐기.
#     → 1 소스 = 1 바이너리. 프로세스 인스턴스는 런타임(proc.ini + argv[0])로 구분.
#   src/PC/ 에 소스가 없으면 안전하게 no-op (프로덕션 mk.sh all 무영향).
##########################################################################

all: ALL END

ALL:
	sh ${_PC_MAKE}/Make_PC_all.sh

END:
	@echo "FEPp PC SRC Make End"

##########################################################################
#	End of File (Make_PC.mk)
##########################################################################
