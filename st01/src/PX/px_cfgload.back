/*----------------------------------------------------------------------*/
void	Tcp1_Config_Load (void)
/*----------------------------------------------------------------------*/
{
	int		err_flag = 0;
	int		cnt, itemcnt;
	int		c1 = '=';
	int		c2 = ' ';
	int		c3 = '\t';
	char	buf[128], tmp1[40], tmp2[40], tmp3[40];
	char	*sp, *sp1, *sp2, *sp3;

