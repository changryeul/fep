/*----------------------------------------------------------------------*/
void	Tcp1_Config_Read (void)
/*----------------------------------------------------------------------*/
{
	int		cnt;
	int		c1 = '=';
	int		c2 = ' ';
	int		c3 = '\t';
	char	buf[128], ebuf[128], tmp1[40], tmp2[40], tmp3[40];
	char	*sp, *sp1, *sp2, *sp3;

	sprintf (buf, "%s/tcp1.ini", _FEP_CFG);
