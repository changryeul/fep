#define		_GLOBAL

/*------------------------------------------------------------------------
#   System  : HANWHA FEP
#   Author  : Y.P.K
#   Module  : 선물옵션 체결 분배
#   File    : jc_1400_dd.c
------------------------------------------------------------------------*/

/*------------------------------------------------------------------------
	Header Files
------------------------------------------------------------------------*/
#include	"fep_fepj.h"
#include	"jc_struct.h"

#define		DATA_SIZE	381					  /* Header(81) + Data(300) */
#include	"buf_struct.h"

/*------------------------------------------------------------------------
	Constants and Structures
------------------------------------------------------------------------*/
#define		DATA_TIME	60 * 1000
#define		READ_MAX	(FILE_BUF_LEN/(sizeof(FILE_RW_HEAD)+DATA_SIZE+1))

/*------------------------------------------------------------------------
	Global Variables
------------------------------------------------------------------------*/
int					R_Cnt;
FILE_BUFF_FORMAT	R_Fmt[READ_MAX], W_Fmt;

/*------------------------------------------------------------------------
	Function Prototypes
------------------------------------------------------------------------*/
void	JC_1400_DD (void);
void	Analyze_Data (void);
void	Write_Data (int);

/*----------------------------------------------------------------------*/
int		main (int argc, char *argv[])
/*----------------------------------------------------------------------*/
{
	Init_Proc (argc, argv);
	JC_1400_DD ();
	Exit_Process ();
}	/* End of main ()	*/

/*----------------------------------------------------------------------*/
void	JC_1400_DD (void)
/*----------------------------------------------------------------------*/
{
	int		rt;

	while (START_S != JOB_END)
	{
		Stat_Save ();

		while (START_S != JOB_END)
		{
			Stat_Save ();
			memset (R_Fmt, 0, sizeof (FILE_BUFF_FORMAT) * READ_MAX);

			R_Cnt = F_R (PS_R_1, (void *)R_Fmt, READ_MAX);

			if (R_Cnt < 0)
			{
				SLog (SAM_FATAL, "cannot read file[%s,%d:%s]",
					IFN(D_K,P_K,0), SYS_NO, SYS_STR);
				sleep (1);
				Exit_Process ();
			}
			else if (R_Cnt == 0)
				break;

			SLog (SAM_OK, "SAM RD [%s:%d][%d]",
				IFN(D_K,P_K,0), R_Cnt, IFR(D_K,P_K,0,0));
			Analyze_Data ();
		}

		rt = Poll_File (DATA_TIME);

		if (rt == 1)
			SLog (USR_OK, "poll timeout <%d>", INT_SEQ);
		else if (rt == -1)
			continue;
	}
}	/* End of JC_1400_DD ()	*/

/*************************************************************************
	Function		: . Analyze_Data
	Parameters IN	: .
	Parameters OUT	: .
	Return Code		: . void
	Comment			: . analyze and divide data
*************************************************************************/
/*----------------------------------------------------------------------*/
void	Analyze_Data (void)
/*----------------------------------------------------------------------*/
{
	int			i;
	char		tr_code[20];

	for (i = 0; i < R_Cnt; i ++)
	{
		memset (tr_code, ' ', sizeof(tr_code));
		memcpy (&W_Fmt, &R_Fmt[i], sizeof (FILE_BUFF_FORMAT));

		memcpy (tr_code, &R_Fmt[i].Data[sizeof(KRX_HEADER)+11], 11);

		/* 전문 구분 ----------------------------------*/
		/* 회원체결결과 */
		if (memcmp (tr_code, "TTRTDP21301", 11) == 0) 
		{
			KRX_SETTLE_DATA *dat = 
				(KRX_SETTLE_DATA *)&R_Fmt[i].Data[sizeof(KRX_HEADER)];
		}
		/* 회원처리호가 */
		else if (memcmp(tr_code, "TTRODP11301", 11) == 0 ||	/* 정상 */
                 memcmp(tr_code, "TTRODP11321", 11) == 0 ||	/* 거부 */
                 memcmp(tr_code, "TTRODP11303", 11) == 0) 	/* 자동취소 */
		{
			KRX_SETTLE_RESP_DATA *dat = 
				(KRX_SETTLE_RESP_DATA *)&R_Fmt[i].Data[sizeof(KRX_HEADER)];
		}
		/* 회원대량체결결과 */
		else if (memcmp(dat->TrCode, "TTRBTP22301", 11) == 0) 
			memcpy (&member_data, &dat->Data[130], 40);
		{
			KRX_BLOCK_SETTLE_DATA *dat = 
				(KRX_BLOCK_SETTLE_DATA *)&R_Fmt[i].Data[sizeof(KRX_HEADER)];
		}
		/* 회원대량처리호가 */
		else if (memcmp(tr_code, "TTRBOP12301", 11) == 0 || /* 정상 */
                 memcmp(tr_code, "TTRBOP12311", 11) == 0 ||	/* 거부 */
                 memcmp(tr_code, "TTRBOP12302", 11) == 0 ||	/* 협의정상 */
                 memcmp(tr_code, "TTRBOP12312", 11) == 0 ||	/* 협의거부 */
                 memcmp(tr_code, "TTRBOP12303", 11) == 0)	/* 협의자동취소 */
		{
			KRX_BLOCK_SETTLE_RESP_DATA *dat = 
				(KRX_BLOCK_SETTLE_RESP_DATA *)&R_Fmt[i].Data[sizeof(KRX_HEADER)];
		}
		/* 대량매매주문서, 종목마감 */
		else
		{
			Write_Data (1);
			break;
		}
		/*---------------------------------------------*/

		if (dat->MembershipItem[0] == 'S' ||			/* 상품 */
			dat->MembershipItem[0] == 'W')				/* 위탁 */
			Write_Data (1);
		else
		{
			if (dat->MembershipItem[0] == 'D') 				/* 직접접속 */
			{
				Write_Data (2);

				if (dat->MembershipItem[2] == 'P')			/* PK   */
					Write_Data (3);
			}
			else
			{
				SLog (USR_ERROR, "접속경로오류 [%c]",
					dat->MembershipItem[0]);
				Add_Count (PS_R_1, 1);
				INT_SEQ ++;
				continue;
			}
		}
	}

	return;
}	/* End of Analyze_Data ()	*/

/**************************************************************************
	Function		: . Write_Data
	Parameters IN	: . w_type	: write flag
	Parameters OUT	: .
	Return Code		: . void
	Comment			: . write data to file
**************************************************************************/
/*-----------------------------------------------------------------------*/
void	Write_Data (int w_type)
/*-----------------------------------------------------------------------*/
{
	int		rt;

	rt = F_W (w_type * 10, (void *)&W_Fmt, 1);

	if (rt != 1)
	{
		SLog (SAM_FATAL, "file write OF%d[%s:%d]",
			w_type, OFN(D_K,P_K,w_type-1), rt);
		Exit_Process ();
	}

    if (w_type == 3)
        return;
    else
	{
		Add_Count (PS_R_1, 1);
		INT_SEQ ++;
		SLog (USR_OK, "file write OF%d[%s:%d][%d]",
			w_type, OFN(D_K,P_K,w_type-1), rt, OFW(D_K,P_K,w_type-1,0));
		Set_TR_Time ();
	}

	return;
}	/* End of Write_Data ()	*/

/*************************************************************************
	End of Program (jc_1400_dd.c)
*************************************************************************/
