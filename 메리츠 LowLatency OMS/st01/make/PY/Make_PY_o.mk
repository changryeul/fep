.SUFFIXES: .c .o

INCD= $(INC_TMP)
INCS= -I$(_P_INC)
DEFS= $(DEF_TMP)

OBJ= $(_PY_OBJ)/$(SRC_TMP:.c=.o)

all: $(OBJ)

$(OBJ): $(SRC_TMP) $(INCD)
	$(CC) -o $(OBJ) -c $(SRC_TMP) $(DEFS) $(INCS)

