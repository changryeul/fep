#include	"fep_fepp.h"
#include    "pa_struct.h"

/*----------------------------------------------------------------------*/
int		main (int argc, char *argv[])
/*----------------------------------------------------------------------*/
{
	int		i;
	char	d_time[20], wbuf[1024];


    Sub_SHM ();
    Mem_SHM (1, 0);
    Sise_SHM ();

	Get_DateTime (d_time);

	for (i = 0; i < Shm_Elw[0].total_item_cnt; i++)
	{
		memset(wbuf,    0,  sizeof(wbuf));

		/* ELW_MASTER Memory Write */
		memcpy (wbuf,   Shm_Elw[i].Elw_Master.seq_no,   sizeof(ELW_MASTER));

		printf ("%.8s:%s\n",   d_time, wbuf);
	}
	
}	/* End of main ()	*/

