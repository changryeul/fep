/*************************************************************************
	MiChe Data Struct
*************************************************************************/
typedef struct {
	int     Jan_Cnt;                   			/* 주문잔량             */
	int		Item_Seq;							/* 종목코드 Master Seq	*/

	char    AccountNo[9];                       /* 계좌번호             */
	char    Item_Cd[8];                         /* 종목코드             */
	char    OrderNo[7];                         /* 주문번호             */
	char    OriginalOrderNo[7];                 /* 원주문번호           */
	char    PriceFlag[1];                       /* 정정취소구분         */
                                            /* (0:신규,1:정정,2:취소)   */
	char    TradeFlag[2];                       /* 매도매수구분         */
                                                /* 01 ,신규매도         */
                                                /* 02 ,신규매수         */
                                                /* 03 ,전매도           */
                                                /* 04 ,환매수           */
                                                /* 05 ,최종만기매도     */
                                                /* 06 ,최종만기매수     */
                                                /* 07 ,권리행사         */
                                                /* 08 ,권리배정         */
                                                /* 09 ,옵션매도소멸     */
                                                /* 10 ,옵션매수소멸     */
	char    Order_Cnt[8];                       /* 주문수량             */
	char    Order_Jan_Cnt[8];                  	/* 주문잔량             */
	char    Order_Price[9];                     /* 주문가격             */
	char    JumunFlag[1];                       /* 주문조건             */
                                                /* F ,FOK               */
                                                /* I ,IOC               */
                                                /* X ,없음              */
	char    OrderType[1];                       /* 주문유형             */
                                                /* 'B', '최유리지정가'  */
                                                /* 'C', '조건부지정가'  */
                                                /* 'L', '지정가'        */
                                                /* 'M', '시장가'        */
                                                /* '0' ,원주문이 있을때 */
	char	tmp[10];							/* 예비					*/
}	MICHE;

/*************************************************************************
	MM Jumun Data Struct
*************************************************************************/
typedef struct {
	int		auto_run;							/* 자동기동여부			*/
	int		tot_money;							/* 총한도금액			*/
	int		tot_op_cnt;							/* 옵션종목 총 수량		*/
	int		fu_dan_cnt;							/* 선물 단위 수량		*/
	int		curr_op_or;							/* 현재 옵션주문현황	*/

	/* 총주문 = 체결수량 + 미체결수량 + 잔주문수량						*/
    struct  MM_ARRY
    {
		int		Jong_Seq;						/* 종목 일련번호		*/
		int		Meme_Flg;						/* 매매구분				*/
												/* 1:매도, 2:매수		*/
		int		Tot_Order_Cnt;					/* 총주문수량			*/
		int		Nu_Che_Cnt;						/* 누적체결수량			*/
		/* 지금은 사용하지 않지만 나중에(분산주문시) 사용할수도 있다)	*/
		int		Jan_Cnt;						/* 잔주문수량			*/
		/* 지금은 사용하지 않지만 나중에(분산주문시) 사용할수도 있다)	*/
		int		Ju_Gum;							/* 주문금액				*/
												/* 예, 222.22 => 22222	*/
		int		F_Che_Ga;						/* 선물체결가격(종목별)	*/	
												/* 예, 222.22 => 22222	*/
		int		Che_Gum;						/* 체결금액				*/
												/* 예, 222.22 => 22222	*/
		int		Avg_Che_Ga;						/* 해당종목 평균 체결가격	*/
		char	End_Flag[1];					/* Sub Set End 여부 	*/
												/* 0:신규주문대상,		*/
												/* 1:자동정정주문대상	*/
												/* 5:주문나간상태(미응답)	*/
												/*   정정주문 내면안됨	*/
												/* 1과 5가 페어임.		*/
												/* 2:SUB종료			*/
												/* 3:자동정정만 종료	*/
												/* 9:전체종료			*/
   	 	char    Item_Cd[8];                     /* 종목코드             */
   	 	char    OrderNo[7];                     /* 주문번호             */
   	 	char    OriginalOrderNo[7];             /* 원주문번호           */
   	 	char    PriceFlag[1];                   /* 정정취소구분         */
   	                                         	/* (0:신규,1:정정,2:취소)   */
   	 	char    TradeFlag[1];                   /* 매도매수구분         */
                                                /* 1 ,매도              */
                                                /* 2 ,매수              */
		char	Order_Cnt[8];					/* 주문수량				*/
		char    Order_Price[9];                 /* 주문가격             */
		char	Client_Moniter_Key[4];			/* Client 화면키		*/
												/* 주문체결에서 사용	*/
    }   apno[20];								/* 종목수량 선물포함 Max 20	*/
}   JU_HISTORY;

/*************************************************************************
	장개시전 Jumun Data Struct
*************************************************************************/
typedef struct {
	int		auto_run;							/* 자동기동여부			*/
	int		strike_cnt;							/* 총 행사 수량			*/

	/* 총주문 = 체결수량 + 미체결수량 + 잔주문수량						*/
    struct  BJ_ARRY
    {
		int		sub_auto_run;					/* sub 주문상황			*/
												/* 주문,응답중,응답,체결중,체결	*/
												/* 000 : 0				*/
												/* 100 or 010 or 001 or */
												/* 110 or 011 or 101 : 1*/
												/* 111 : 1				*/
												/* 911 or 191 or 119 or */
												/* 991 or 199 or 919 : 1*/
												/* 999 : 9 				*/ 
		int		hmd;							/* 합성매도 계산값		*/
		int		hms;							/* 합성매수 계산값		*/

		/* 0:Call, 1:Put, 2:Future */
		struct	BJ_J_ARRY
		{
			int		Jong_Seq;					/* 종목 일련번호		*/
			int		Tot_Order_Cnt;				/* 총주문수량			*/
			int		Nu_Che_Cnt;					/* 누적체결수량			*/
			char	End_Flag[1];				/* Sub Set End 여부 	*/
												/* 0:신규주문대상,		*/
												/* 1:자동정정주문대상	*/
												/* 5:주문나간상태(미응답)	*/
												/*   정정주문 내면안됨	*/
												/* 1과 5가 페어임.		*/
												/* 9:종료				*/
            char    Item_Cd[8];                 /* 종목코드             */
   	 		char    OrderNo[7];                 /* 주문번호             */
   	 		char    OriginalOrderNo[7];         /* 원주문번호           */
   	 		char    TradeFlag[1];               /* 매도매수구분         */
       		                                    /* 1 ,매도              */
       		                                    /* 2 ,매수              */
			char	Order_Cnt[8];				/* 주문수량				*/
			char    Order_Price[9];             /* 주문가격             */
		}	ju_set[3];

		char	Client_Moniter_Key[4];			/* Client 화면키		*/
												/* 주문체결에서 사용	*/
    }   sub_set[10];							/* 총 10개의 SubSet 존재*/
}   JU_S_HISTORY;

/*************************************************************************
	서버 전자동 매매 2010.10 Struct (선물주문만)
*************************************************************************/
typedef struct {
	int		auto_run;							/* 자동기동여부			*/

	int		send_cnt;							/* 주문송신 횟수		*/
	int		curr_s_cnt;							/* 현재 주문송신 횟수	*/
	int		fu_jugum;							/* 매주문시 선물주문한도 */
	int		ju_stat;							/* 주문상황				*/
												/* 0 : 신규주문 가능	*/
												/* 1 : 주문송신			*/
											/* 2 : 응답처리 ~ 취소송신	*/
												/* 3 : 취소결과 처리중	*/
												/* 8 : 문제발생			*/
												/* 9 : 주문횟수 충족	*/
												/*     신규주문 금지	*/
	int		che_cnt;					/* 체결된 현재 포지션 갯수(Max,9)*/
	int		che_max;							/* 최대 포지션갯수(Max,9)*/
	int		get_cnt;					/* 보유한 포지션 갯수(음있음)	*/

	/* 신규 주문 발주시 3으로 나눠서 주문발주 10(2,4,4) */
	struct	SA_JU_ARRY
	{
		int		ju_flag;					/* 서브 주문현황		*/
											/* 0 : 초기				*/
											/* 1 : 주문				*/
											/* 2 : 주문응답			*/
											/* 3 : 취소주문완료 	*/
		int		Order_Int;					/* 주문수량				*/
		int		Che_Int;					/* 체결수량				*/

   		char    OrderNo[7];                 /* 주문번호             */
   		char    TradeFlag[1];               /* 매도매수구분         */
   		                                    /* 1 ,매도              */
   		                                    /* 2 ,매수              */
		char    Order_Price[9];             /* 주문가격             */
	}	nju_set[3];

	/* 총주문 = 체결수량 + 미체결수량 + 잔주문수량					*/
    struct  SA_CHE_ARRY
    {
		int		Order_Int;					/* 주문수량				*/
		int		Che_Int;					/* 체결수량				*/
		int		Che_Avg;					/* 평균체결가격			*/
		char    End_Flag[1];                /* Sub Set End 여부     */
											/* 0:신규주문대상,      */
											/* 1:자동정정주문대상   */
											/* 2:주문3개 모두 취소주문 확인 */
											/* 5:주문나간상태(미응답)   */
											/*   정정주문 내면안됨  */
											/* 1과 5가 페어임.      */
											/* 6:주문나가있는 상태	*/
											/* 6과 2가 페어임.		*/
											/* 9:종료               */
		char    OrderNo[7];                 /* 주문번호             */
		char    OriginalOrderNo[7];         /* 원주문번호           */
		char    TradeFlag[1];               /* 매도매수구분         */
											/* 1 ,매도              */
											/* 2 ,매수              */
		char    Order_Price[9];             /* 주문가격             */

    }   che_set[9];							/* 행사가2개(콜2+풋2)	*/
											/* 총 2개의 SubSet 존재	*/
	char	Client_Moniter_Key[4];			/* Client 화면키		*/
											/* 주문체결에서 사용	*/
}	JU_A_HISTORY;

