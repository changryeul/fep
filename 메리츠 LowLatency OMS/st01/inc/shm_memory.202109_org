	SIO_G7		Options_CURR_Arry[30];  /* 최근 시세내역 30개 기억      */
	SIO_G7      Options_CHE_Arry[1000]; /* 체결(A3형태로만 기억)		*/
}	SHM_OPTIONS;	/* 지수옵션 시세 Shared Memory  */

