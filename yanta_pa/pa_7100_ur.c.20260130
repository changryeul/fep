#define		_GLOBAL
/*------------------------------------------------------------------------
#	Module	: 파생 시세수신 (UDP)
#	File	: pa_7100_ur.c
------------------------------------------------------------------------*/

/*------------------------------------------------------------------------
	Header Files
------------------------------------------------------------------------*/
#include    "pa_struct.h"
#include	"fep_fepp.h"

/* 기본정보 채권KTS 시세 */
/*
#    A701K : 68  장운영TS
#    M401K : 83, 장운영스캐쥴
#
#    B601K : 462 일반채권, 국고채권 우선호가
#    A301K : 223 채권 체결
#    G701K : 643 일반채권, 국고채권 체결 + 우선호가
#    A601K : 57  채권 종목마감
#    I2000 : 10  Polling, Log만 File은 처리안함
*/
#if defined A7102
#define     DATA_SIZE       700
#elif defined A7103
#define     DATA_SIZE       100
/* 파생종목정보 사이즈 1318 (A006F), 7291(재처리) */
/*
#	A001F(10301/11301) : 1318, 종목정보
#	H001F(10301/11301) : 63, 정산가
*/
#elif defined A7201 || A7291 || A7301 || A7391
#define     DATA_SIZE       1400
/*
#    A301F : 173, 파생체결
#    G701F : 431, 파생체결G7 (우선호가  5단계) 04F & 05F(제외)
#    B601F : 324, 파생우선호가 (우선호가  5단계) 04F & 05F(제외)
#    A601F : 78, 파생종목마감
#    A701F : 68,  장운영정보(모든 A7공통.. All)
#    R101F : 359, 파생 장운영TS + 우선호가 (우선호가  5단계) 단일가 세션, 04F, 05F 제외
*/
#elif defined A7202 || A7302
#define     DATA_SIZE       500
/*
#    M401A : 83,  장운영스캐쥴
*/
#elif defined A7203 || A7303
#define     DATA_SIZE       100
#endif

#include    "buf_struct.h"

/*------------------------------------------------------------------------
	Constants and Structures
------------------------------------------------------------------------*/
#define		SVR_PORT_NO		UDP_PORT(D_K,P_K,0)
#define		READ_BUF_SIZE	2048

/* 시세 Seq 위치 Size */
#define		S_H_SIZE		5								/* TR(5)	*/
/* 기본마스터 Seq 위치 Size */
#define		M_H_SIZE		27	/* TR(5) + SEQ(8) + JCNT(6) + DATE(8)	*/

/*------------------------------------------------------------------------
	Global Variables
------------------------------------------------------------------------*/
int		Sockfd, FIFO_fd, tot_cq;
int		Idx, Che_Gbn, W_Flag;
struct	ip_mreq     mreq;
char	TrCode[8], ApType[10], Order_St[512];
struct sockaddr_in	SvrAddr, ClntAddr;

/*------------------------------------------------------------------------
	Function Prototypes
------------------------------------------------------------------------*/
void	PA_7100_UR (void);
int     Init_Parameters (void);
int		Socket_Connect (void);
int		Recv_Data (char *);
int		Add_Count_UR (void);
int		Add_Count_DD (char *);
void	Set_Sise (char *);
void	Write_Read_Fifo (int);

/*----------------------------------------------------------------------*/
int		main (int argc, char *argv[])
/*----------------------------------------------------------------------*/
{
	Init_Proc (argc, argv);
	PA_7100_UR ();
	Exit_Process ();
}	/* End of main ()	*/

/*----------------------------------------------------------------------*/
void	PA_7100_UR (void)
/*----------------------------------------------------------------------*/
{
	char	m_time[24];
	char	Wdt[30], W2_Fmt[512];
	char 	r_buf[READ_BUF_SIZE];
	int		tr_gbn, rt, len, skip_rt;

	BUFF_RW_HEAD		f_head;
	FILE_BUFF_FORMAT    W_Fmt;

	rt = Init_Parameters ( );
	if (rt == NOTOK)
		return;

	rt = Socket_Connect ();
	if (rt == NOTOK)
		return;

	SLog (USR_OK, "socket connected:port[%d]", SVR_PORT_NO);

	while (START_S != JOB_END)
	{
/* 20211022
		Stat_Save ();
*/
		memset (r_buf, 0, sizeof (r_buf));

		rt = Recv_Data (r_buf);

		if (rt == 0)
		{
			SLog (USR_OK, "poll timeout");
			continue;
		}
		else if (rt < 0)
		{
			SLog (UDP_ERROR, "receive fail {%d:%s}", SYS_NO, SYS_STR);
			close (Sockfd);

			rt = Socket_Connect ();

			if (rt == NOTOK)
				return;

			continue;
		}

#if	0
Log (USR_OK, "HONG [%.10s]", r_buf);
		memset (TrCode, 0, sizeof (TrCode));			/* TRCODE 저장	*/
		sprintf (TrCode, "%-5.5s", r_buf);

		Che_Gbn = Idx = 0;
		Set_Sise (r_buf);
		
		/* 체결관련시 평가손익 && 자동전략 처리위한 전달 */
		if (Che_Gbn > 0)
		{
#if defined A7102
			if (Shm_Risk[0].S_Sise[0][Idx].auto_use > 0)			/* 기동중인 자동이 해당종목을 설정했을때 전달 */
				Write_Read_Fifo (1);
#elif defined A7202
			if (Shm_Risk[0].S_Sise[1][Idx].auto_use > 0)			/* 기동중인 자동이 해당종목을 설정했을때 전달 */
				Write_Read_Fifo (1);
#endif
		}
		else if (Che_Gbn < 0)
		{
#if 0
			/* polling data */
			if (memcmp (r_buf, "I2", 2) == 0)
			{
				SLog (USR_OK, "I2 [%.5s]", r_buf);
			}
			else
				SLog (USR_OK, "Other [%.5s]", r_buf);
#endif
			continue;
		}
#endif

/* 지금은 필요 없을 듯
	    len = Add_Count_UR ();
*/

		/* 운영장비에서는 File Write를 하지않고 개발기나 테스트장비에서 File Write한다.		*/
		/* 해당 파일은 비상시 또는 장종류후 전략시뮬레이션을 위한 통자료로만 사용을 한다.	*/
/* 20220222 체결,호가데이터 필요없다하여 저장하는기능 제거
		if ((memcmp(r_buf, "A0", 2) == 0)	||
			(Che_Gbn > 0	&& 
			 (memcmp ((char *)getenv ("_FEP_DIV"), "TEST", 4) == 0)) )
*/
		/* polling data */
		W_Flag = 0;
		if (memcmp (r_buf, "I2", 2) == 0)
		{
#if		1		/* polling data log */
				SLog (USR_OK, "I2 [%.5s]", r_buf);
#endif
				continue;
		}
#if defined A7201 || A7291
		else if ((memcmp(r_buf, "A006F", 5) == 0)		||		// 종목정보,  port 11301
				(memcmp (r_buf, "H306F",   5) == 0))			// 정산가, port 11301
		{
			W_Flag = 1;
		}
#elif defined A7301 || A7391
		else if (memcmp(r_buf, "A006V", 5) == 0)				// 종목정보,  port 11301
//				(memcmp (r_buf, "H306V",   5) == 0)				// 정산가, port 11301 없음
		{
			W_Flag = 1;
		}
#endif
#if defined A7202
		else if ((memcmp (r_buf, "A306F",   5) == 0)    ||      // 체결, port 11305, size 173
				 (memcmp (r_buf, "G706F",   5) == 0)    ||      // 체결+우선호가 port 11305, size 431
				 (memcmp (r_buf, "B606F",   5) == 0)	||		// 우선호가 port 11305, size 324
				 (memcmp (r_buf, "A606F",   5) == 0)	||		// 종목마감, port 11305
				 (memcmp (r_buf, "A706F",   5) == 0)	||		// 장운영TS(종목장운영정보) port 11305
				 (memcmp (r_buf, "R106F",   5) == 0))			// 장운영TS+호가 port 11305
		{
			W_Flag = 2;
		}
#elif defined A7302
		else if ((memcmp (r_buf, "A306V",   5) == 0)    ||      // 체결, port 11305, size 173
				 (memcmp (r_buf, "G706V",   5) == 0)    ||      // 체결+우선호가 port 11305, size 431
				 (memcmp (r_buf, "B606V",   5) == 0)	||		// 우선호가 port 11305, size 324
				 (memcmp (r_buf, "A606V",   5) == 0)	||		// 종목마감, port 11305
				 (memcmp (r_buf, "A706V",   5) == 0)	||		// 장운영TS(종목장운영정보) port 11305
				 (memcmp (r_buf, "R106V",   5) == 0))			// 장운영TS+호가 port 11305
		{
			W_Flag = 2;
		}
#endif
#if defined A7203
		else if (memcmp (r_buf, "M406F",   5) == 0)				// 장운영스케줄 port 11315
		{
			W_Flag = 3;
		}
#elif defined A7303
		else if (memcmp (r_buf, "M406V",   5) == 0)				// 장운영스케줄 port 11315
		{
			W_Flag = 3;
		}
#endif
		else
		{
//			Log (USR_OK, "Else Case Receive RecvPkt[%5.5s]", r_buf);
			continue;
		}

		if (W_Flag > 0)
		{
			memset (m_time, 0, sizeof (m_time));
			Get_MicroTime (m_time);

			/* File Write */
			memset (&W_Fmt, 0x20, sizeof (FILE_BUFF_FORMAT));

			/* write to DD file	*/
			ItoAf (O_W_CNT1 + 1, W_Fmt.If_Seq,	sizeof (W_Fmt.If_Seq));
			memcpy (W_Fmt.ApType, ApType,		sizeof (W_Fmt.ApType));
			memcpy (W_Fmt.ResponseCode, RES_NORMAL, strlen (RES_NORMAL));
			memcpy (W_Fmt.RecvTime1, m_time,	sizeof (W_Fmt.RecvTime1));
			memcpy (W_Fmt.RecvTime2, &m_time[sizeof(W_Fmt.RecvTime1)],
												sizeof (W_Fmt.RecvTime2));

			memset (W_Fmt.DataHeader, 0x20, 20+DATA_SIZE);
			memcpy (W_Fmt.Data, r_buf, strlen(r_buf));
			W_Fmt.LineFeed[0] = '\n';

			if (W_Flag == 1)
				rt = F_W (TS_W1_1, (void *)&W_Fmt, 1);
			else if (W_Flag == 2)
				rt = F_W (TS_W1_2, (void *)&W_Fmt, 1);
			else if (W_Flag == 3)
				rt = F_W (TS_W1_3, (void *)&W_Fmt, 1);

			if (rt != 1)
			{
				SLog (SAM_FATAL, "file write fail[%s] rt[%d]", OFN(D_K,P_K,W_Flag-1), rt);
				close (Sockfd);
				return;
			}

//			Add_Count_DD (TrCode);
		}

//		Set_TR_Time ();
//		INT_SEQ ++;
	}

	return;
}	/* End of PA_7100_UR ()	*/

