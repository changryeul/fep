/** ***************************************************************************
**  @fu         int CmdFunction( int argc, char *argv[])
**  @param      int argc - argument count
**  @param      char *argv[] - argument
**  @return     1 - 성공
**  @retval     -1 - 실패
**  @brief      
**  message queue create
***************************************************************************** */
int CmdCreate( int argc, char *argv[])
{
	if( argc < 1)
	{
		printf( "argument error.\n");
		Cmd_HelpCommand( Cmd, argv[ 0]);
		return 0;
	}

	if( Msg != NULL)
	{
		LogCri( "Msg != NULL. already open or create. Msg=[%p]", Msg);
		return 0;
	}

	Msg = Msg_Create( Param->key);
	if( Msg == NULL)
	{
		LogErr( "Msg_Create error. key=[0x%08x]", Param->key);
		return 0;
	}
	LogMsg( "message queue create success. id=[%d]", Msg->id);


	return 1;
}

/** ***************************************************************************
**  @fu         int CmdFunction( int argc, char *argv[])
**  @param      int argc - argument count
**  @param      char *argv[] - argument
**  @return     1 - 성공
**  @retval     -1 - 실패
**  @brief      
**  message queue delete
***************************************************************************** */
int CmdRemove( int argc, char *argv[])
{
	int		rtn;

	if( argc < 1)
	{
		printf( "argument error.\n");
		Cmd_HelpCommand( Cmd, argv[ 0]);
		return 0;
	}

	if( Msg == NULL)
	{
		LogMsg( "message queue not opened. Msg=[%p]", Msg);
		rtn = Msg_RemoveByKey( Param->key);
		if( rtn < 0)
		{
			LogErr( "Msg_RemoveByKey error. key=[0x%08x]", Param->key);
			return 0;
		}
		LogMsg( "message queue remove success. key=[0x%08x]", Param->key);

		return 0;
	}

	rtn = Msg_Remove( Msg);
	if( rtn < 0)
	{
		LogErr( "Msg_Remove error. Msg=[%p]", Msg);
		return 1;
	}
	LogMsg( "message queue remove success. id=[%d]", Msg->id);
	Msg = NULL;

	return 1;
}

