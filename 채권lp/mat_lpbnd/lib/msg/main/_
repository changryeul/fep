/** ***************************************************************************
**  @fu         int CmdFunction( int argc, char *argv[])
**  @param      int argc - argument count
**  @param      char *argv[] - argument
**  @return     1 - 성공
**  @retval     -1 - 실패
**  @brief      
**  message queue delete
***************************************************************************** */
int CmdSend( int argc, char *argv[])
{
	int		rtn;

	if( argc < 2)
	{
		printf( "argument error.\n");
		Cmd_HelpCommand( Cmd, argv[ 0]);
		return 0;
	}

	if( Msg == NULL)
	{
		LogMsg( "message queue not opened. Msg=[%p]", Msg);
		return 0;
	}

	rtn = Msg_Send( Msg, argv[ 1], strlen( argv[ 1]));
	if( rtn <= 0)
	{
		LogCri( "Msg_Send error. Msg=[%p] data=[%d:%s]", Msg, strlen( argv[ 1]), argv[ 1]);
		return 0;
	}

	LogDump( argv[ 1], strlen( argv[ 1]), "message send success.");

	return rtn;
}

/** ***************************************************************************
**  @fu         int CmdFunction( int argc, char *argv[])
**  @param      int argc - argument count
**  @param      char *argv[] - argument
**  @return     1 - 성공
**  @retval     -1 - 실패
**  @brief      
**  message queue delete
***************************************************************************** */
int CmdRecv( int argc, char *argv[])
{
	int		rtn;
	char	rcv_data[ 8192];
	int		rcv_size;
	int		cnt = 0, timeout;


	if( argc < 1)
	{
		printf( "argument error.\n");
		Cmd_HelpCommand( Cmd, argv[ 0]);
		return 0;
	}

	if( Msg == NULL)
	{
		LogMsg( "message queue not opened. Msg=[%p]", Msg);
		return 0;
	}

	switch( argc)
	{
		default:
		case 3:
			timeout = atoi( argv[ 2]);
		case 2:
			cnt = atoi( argv[ 1]);
		case 1:
			break;
	}

	while( cnt > 0)
	{
		rtn = Msg_RecvT( Msg, rcv_data, sizeof( rcv_data), timeout);
		if( rtn < 0)
		{
			LogCri( "Msg_Recv error. Msg=[%p] data=[%d:%s]", Msg, strlen( argv[ 1]), argv[ 1]);
			return 0;
		}
		if( rtn == 0) break;
	}
	LogDump( rcv_data, rtn, "message receive success. data=[%d:%s]", rtn, rcv_data);
}

