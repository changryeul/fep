		A.ORDN_PRC_CNCD,
		A.FX_ORDN_PRC,
		A.MRKT_SPOT_PRC,
		A.MRKT_SWAP_PRC,
		A.FX_MRKT_PRC,
		A.CVR_SPR,
		A.SLS_SPR,
		A.FX_ORCY_PRC,
		A.SPR_UT_DCD,
		A.CUS_SPR,
		A.SLPPG_PRC,
		A.MNRC_CRCD,
		A.MNRC_CRNC_ACN,
		A.DROT_CRCD,
		A.DROT_CRNC_ACN,
		A.DASTL_YN,
		A.STLM_CRCD,
		A.FX_GRNY_PTRN_DCD,
		A.GRMN_APLY_RT,
		A.NMNL_GRNY_CRCD,
		A.NMNL_GRNY_AMT,
		A.GRMN_ACN,
		A.GRMN_CRCD,
		A.GRMN_WTMN_AMT,
		A.LMT_ACN,
		A.LMT_CRCD,
		A.FX_LMUS_AMT,
		A.NMNL_GRNY_CRNC_TLCH_SELL_RT,
		A.NMNL_GRNY_CRNC_TSCN_RT,
		A.GRLM_CRNC_TSCN_RT,
		A.FWEX_PSRN_NO,
		A.FWEX_PSRN_DTLS_NO,
		A.FX_CCTN_CHNL_DCD,
		A.ORDN_TRMS_DCD,
		A.ORDN_STTS_DCD,
		A.ERCD_CONV_ID,
		A.ERCD_CONV_CON,
		A.ORDN_TRMS_PNTM_CON,
		A.ORDN_RCIP_PNTM_CON,
		A.LAST_CNTT_PNTM_CON,
		A.FDM_ORDN_RCIP_PNTM_CON,
		A.FX_EXTL_REF_NO,
		A.ENAM_STFS_YN,
		A.EXTL_LNK_ID,
		A.FX_MDIA_DCD,
		A.FX_SYS_MAIN_USER_ID,
		A.FX_SYS_SUB_USER_ID,
		A.ORDE_OFRC_IP,
		A.ORDE_INDV_IP,
		A.MAC_ADR,
		A.RULE_ID,
		A.PCSN_BRCD,
		A.FDM_ORDN_NO,
		A.ADD_CON,
		A.BOB_EMN,
		A.IMDR_YN,
		A.USE_YN,
		A.FX_SYS_LSMD_ID,
		A.FX_SYS_LSMD_TS,
		A.FND_NO
	FROM TB_FXB_TRG001L A
	WHERE	1 = 1
	AND A.ORDN_STTS_DCD IN ('0', '1', '2')
	AND A.ORDN_ORGN_DCD IN ('1')  --(1-고객거래, 2-내부거래, 3-대행거래, 4-대량거래, 5-시장거래)
	-- AND A.ORDN_ORGN_DCD IN ('1', '2', '3', '4', '5')  --(1-고객거래, 2-내부거래, 3-대행거래, 4-대량거래, 5-시장거래)
	AND A.ORDN_VALD_YMD >= TO_CHAR(SYSDATE, 'YYYYMMDD')
	AND A.FX_ORDN_BALN_QTY >= 0
	AND A.USE_YN = 'Y'
	;
	
	if (SQLCODE != 0)
	{
		LogCri( "TB_FXB_OPR_TRG001L_C1 CURSOR DECLARE Error = [%d]", SQLCODE);
		return -1;
	}

	EXEC SQL OPEN TB_FXB_OPR_TRG001L_C1;
	if (SQLCODE != 0)
	{
   		if (SQLCODE == NO_DATA_FOUND)
   		{
			LogCri( "건수없음 SQLCODE=[%d]=================", SQLCODE);
   			return(RET_FAILURE);
   		}
		else
		{
			LogCri( "TB_FXB_OPR_TRG001L_C1 CURSOR OPEN Error = [%d]", SQLCODE);
			return(RET_FAILURE);
		}
   	}

	for (ii = 0; ;ii++)
	{
		//출력값 메모리 초기화
		memset( db_order, 0x00, sizeof( DB_ORDER));

	 	EXEC SQL 
		FETCH TB_FXB_OPR_TRG001L_C1
		INTO
			:db_order->ORDN_NO                         ,
			:db_order->ORTR_ORDN_NO                    ,
			:db_order->OUST_ORDN_NO                    ,
			:db_order->GRP_ORDN_NO                     ,
			:db_order->ORDN_YMD                        ,
			:db_order->ORDN_DCD                        ,
			:db_order->PRAS_ID                         ,
			:db_order->FDM_ID                          ,
			:db_order->ORDN_ORGN_DCD                   ,
			:db_order->ORDN_ORGN_SUB_DCD               ,
			:db_order->FX_TRN_TCD                      ,
			:db_order->AUON_DCD                        ,
			:db_order->ORDE_ID                         ,
			:db_order->WBCS_RLNM_ALTR_NO               ,
			:db_order->PU_CD                           ,
			:db_order->FXBK_ID                         ,
			:db_order->MNGM_BRCD                       ,
			:db_order->HDOM_APLY_GRP_ID                ,
			:db_order->FX_PDCD                         ,
			:db_order->CRNC_PAIR_ID                    ,
			:db_order->TNR_PTRN_DCD                    ,
			:db_order->TNR_ID                          ,
			:db_order->EXPI_STTG_YMD                   ,
			:db_order->EXPI_FNSH_YMD                   ,
			:db_order->FX_ITMS_ID                      ,
			:db_order->BYSEL_DCD                       ,
			:db_order->CNTT_CNDT_DCD                   ,
			:db_order->ORDN_VALD_YMD                   ,
			:db_order->TXCR_DCD                        ,
			:db_order->BASE_CRCD                       ,
			:db_order->FX_SDCU_AMT                     ,
			:db_order->COCU_CD                         ,
			:db_order->FX_COCU_AMT                     ,
			:db_order->FX_ORDN_QTY                     ,
			:db_order->FX_CRCT_QTY                     ,
			:db_order->FX_CNCL_QTY                     ,
			:db_order->FX_CNTT_QTY                     ,
			:db_order->FX_ORDN_BALN_QTY                ,
			:db_order->FX_ORDN_PNTM_PRC                ,
			:db_order->ORDN_PRC_CNCD                   ,
			:db_order->FX_ORDN_PRC                     ,
			:db_order->MRKT_SPOT_PRC                   ,
			:db_order->MRKT_SWAP_PRC                   ,
			:db_order->FX_MRKT_PRC                     ,
			:db_order->CVR_SPR                         ,
			:db_order->SLS_SPR                         ,
			:db_order->FX_ORCY_PRC                     ,
			:db_order->SPR_UT_DCD                      ,
			:db_order->CUS_SPR                         ,
			:db_order->SLPPG_PRC                       ,
			:db_order->MNRC_CRCD                       ,
			:db_order->MNRC_CRNC_ACN                   ,
			:db_order->DROT_CRCD                       ,
			:db_order->DROT_CRNC_ACN                   ,
			:db_order->DASTL_YN                        ,
			:db_order->STLM_CRCD                       ,
			:db_order->FX_GRNY_PTRN_DCD                ,
			:db_order->GRMN_APLY_RT                    ,
			:db_order->NMNL_GRNY_CRCD                  ,
			:db_order->NMNL_GRNY_AMT                   ,
			:db_order->GRMN_ACN                        ,
			:db_order->GRMN_CRCD                       ,
			:db_order->GRMN_WTMN_AMT                   ,
			:db_order->LMT_ACN                         ,
			:db_order->LMT_CRCD                        ,
			:db_order->FX_LMUS_AMT                     ,
			:db_order->NMNL_GRNY_CRNC_TLCH_SELL_RT     ,
			:db_order->NMNL_GRNY_CRNC_TSCN_RT          ,
			:db_order->GRLM_CRNC_TSCN_RT               ,
			:db_order->FWEX_PSRN_NO                    ,
			:db_order->FWEX_PSRN_DTLS_NO               ,
			:db_order->FX_CCTN_CHNL_DCD                ,
			:db_order->ORDN_TRMS_DCD                   ,
			:db_order->ORDN_STTS_DCD                   ,
			:db_order->ERCD_CONV_ID                    ,
			:db_order->ERCD_CONV_CON                   ,
			:db_order->ORDN_TRMS_PNTM_CON              ,
			:db_order->ORDN_RCIP_PNTM_CON              ,
			:db_order->LAST_CNTT_PNTM_CON              ,
			:db_order->FDM_ORDN_RCIP_PNTM_CON          ,
			:db_order->FX_EXTL_REF_NO                  ,
			:db_order->ENAM_STFS_YN                    ,
			:db_order->EXTL_LNK_ID                     ,
			:db_order->FX_MDIA_DCD                     ,
			:db_order->FX_SYS_MAIN_USER_ID             ,
			:db_order->FX_SYS_SUB_USER_ID              ,
			:db_order->ORDE_OFRC_IP                    ,
			:db_order->ORDE_INDV_IP                    ,
			:db_order->MAC_ADR                         ,
			:db_order->RULE_ID                         ,
			:db_order->PCSN_BRCD                       ,
			:db_order->FDM_ORDN_NO                     ,
			:db_order->ADD_CON                         ,
			:db_order->BOB_EMN                         ,
			:db_order->IMDR_YN                         ,
			:db_order->USE_YN                          ,
			:db_order->FX_SYS_LSMD_ID                  ,
			:db_order->FX_SYS_LSMD_TS                  ,
			:db_order->FND_NO                  
			;
		if (SQLCODE != 0)
		{
			if (SQLCODE == NO_DATA_FOUND )
			{
				break;
			}
			else
			{
				LogCri( "TB_FXB_OPR_TRG001L_C1 CURSOR Fetch Error = [%d]", SQLCODE);
				EXEC SQL CLOSE TB_FXB_OPR_TRG001L_C1;
				return(RET_FAILURE);
			}
		}
		else
		{
			//APLog(content->rkey, APLOG_DEBUG, "[%-15s][%4d] 에러코드	[%s]", __FUNCTION__, __LINE__, c_errCd );
			//APLog(content->rkey, APLOG_DEBUG, "[%-15s][%4d] 에러메시지  [%s]", __FUNCTION__, __LINE__, c_errMsg);
			;
		}	

		/* DB_ORDER_Print( db_order); */
		Convert_DbOrder( obook, db_order);
		ORDER_Print( obook);
		Proc_OrderInsert( Mat, obook);
	}

	EXEC SQL CLOSE TB_FXB_OPR_TRG001L_C1;

	//--------------------------------------------------------------
	// 정상 처리 세팅 (0:정상, 1:비정상)
	//--------------------------------------------------------------
	LogMsg( "유효 주문을 DB에서 LOAD 했습니다.. tbl=[%s] 그리드건수=[%d]", "TB_FXB_TRG001L", ii);
	return(RET_SUCCESS);
}

/** ***************************************************************************
**	
***************************************************************************** */
/** ***************************************************************************
**  @fn         int Proc_()
**  @param      int argc     - 프로그램 인수 갯수
**  @return     프로그램 수행 결과
**  @retval     음수 실패
**  @retval     양수 성공
**  @exception
**  @remark
**  @brief
**  convert ORDER_RECV to ORDER
***************************************************************************** */
int Convert_DbOrder( ORDER *order, DB_ORDER *db_order)
{
	char		space[ 512];
	time_t		cur_time;
	struct tm	*tp;
	char		today[ 32];

	memset( space, ' ', sizeof( space));

	if( db_order->ORDN_DCD[ 0] == 'N')				order->MsgType[ 0] = 'D';
	else
	if( db_order->ORDN_DCD[ 0] == 'M')				order->MsgType[ 0] = 'G';
	else
	if( db_order->ORDN_DCD[ 0] == 'C')				order->MsgType[ 0] = 'F';

	memcpy( order->OrdStatus       , "0"						, sizeof( order->OrdStatus       ));
	memcpy( order->CustID          , db_order->WBCS_RLNM_ALTR_NO, sizeof( order->CustID          ));
	memcpy( order->FundNO          , db_order->FND_NO      		, sizeof( order->FundNO          ));
	memcpy( order->ExecType        , db_order->FX_TRN_TCD		, sizeof( order->ExecType        ));
	memcpy( order->LgenNo          , db_order->ORDE_ID			, sizeof( order->LgenNo          ));
	memcpy( order->OrgnGb          , db_order->ORDN_ORGN_DCD	, sizeof( order->OrgnGb          ));
	memcpy( order->BkNo            , space /*db_order->BkNo */	, sizeof( order->BkNo            ));
	memset( order->FxBkId          , ' '						, sizeof( order->FxBkId          ));
	memcpy( order->ClOrdID         , db_order->ORDN_NO			, sizeof( order->ClOrdID         ));
	memcpy( order->OrigClOrdID     , db_order->ORTR_ORDN_NO		, sizeof( order->OrigClOrdID     ));
	memcpy( order->Currency        , db_order->BASE_CRCD		, sizeof( order->Currency        ));
	        order->OrderQty        = db_order->FX_ORDN_QTY;

	if( db_order->ORDN_PRC_CNCD[ 0] == 'L')				order->OrdType[ 0] = '2';
	else
	if( db_order->ORDN_PRC_CNCD[ 0] == 'M')				order->OrdType[ 0] = '1';

	        order->SlipCmpPrice    = db_order->FX_ORDN_PNTM_PRC;
	        order->SlipPip         = db_order->SLPPG_PRC;
	        order->CumQty          = 0.0D;
	        order->LastQty         = 0.0D;
	        order->LeavesQty       = 0.0D;
	memcpy( order->OrdID           , db_order->FDM_ORDN_NO		, sizeof( order->OrdID           ));
	memset( order->ExecID          , 0x20         		        , sizeof( order->ExecID          ));
	        order->Price           = db_order->FX_ORDN_PRC;
	        order->PriceSpr        = db_order->CUS_SPR;
			order->OrdSprPrc       = 0.0D;
	        order->LastPx          = 0.0D;
	        order->LastSprPx       = 0.0D;

	if( db_order->BYSEL_DCD[ 0] == 'B')					order->Side[ 0] = '1';
	else 
	if( db_order->BYSEL_DCD[ 0] == 'S')					order->Side[ 0] = '2';

	if( !memcmp( db_order->CNTT_CNDT_DCD, "DAY", 3))	order->TimeInForce[ 0] = '0';
	else
	if( !memcmp( db_order->CNTT_CNDT_DCD, "IOC", 3))	order->TimeInForce[ 0] = '3';
	else
	if( !memcmp( db_order->CNTT_CNDT_DCD, "FOK", 3))	order->TimeInForce[ 0] = '4';
	else												order->TimeInForce[ 0] = '0';

	memcpy( order->RefuslCd        , "0000000000"          			, sizeof( order->RefuslCd        ));
	memset( order->Text            , ' '                   			, sizeof( order->Text            ));

	memcpy( order->TransactTime    , db_order->FDM_ORDN_RCIP_PNTM_CON, sizeof( order->TransactTime    ));
	memcpy( order->SettType        , db_order->FX_PDCD				, sizeof( order->SettType        ));

	memcpy( order->TnrId           , db_order->TNR_ID				, sizeof( order->TnrId           ));
	memcpy( order->TnrPtrnDcd      , db_order->TNR_PTRN_DCD			, sizeof( order->TnrPtrnDcd      ));
	
	memcpy( order->Symbol          , db_order->CRNC_PAIR_ID			, sizeof( order->Symbol          ));
	/* TOD일 경우 만기종료년월일,만기시작년월일을 오늘 날짜로 */
	if( !memcmp( order->TnrId, "TOD", 3))
	{
		time( &cur_time);
		tp = localtime( &cur_time);
		sprintf( today, "%04d%02d%02d", tp->tm_year +1900, tp->tm_mon +1, tp->tm_mday);
		memcpy( order->ValueDate1      , today						, sizeof( order->ValueDate1      ));
		memcpy( order->ValueDate2      , today						, sizeof( order->ValueDate2      ));
	}
	else
	{
		memcpy( order->ValueDate1      , db_order->EXPI_STTG_YMD		, sizeof( order->ValueDate1      ));
		memcpy( order->ValueDate2      , db_order->EXPI_FNSH_YMD		, sizeof( order->ValueDate2      ));
	}
	memset( order->OfprKeyVal      , ' '							, sizeof( order->OfprKeyVal      ));
	

#if 0
	memcpy( order->NearSettType    , db_order->NearSettType    		, sizeof( order->NearSettType    ));
	memcpy( order->NearTnrId       , db_order->NearTnrId    		, sizeof( order->NearTnrId       ));
	memcpy( order->NearTnrPtrnDcd  , db_order->NearTnrPtrnDcd   	, sizeof( order->NearTnrPtrnDcd  ));

	memcpy( order->NearLegSide     , db_order->NearLegSide     		, sizeof( order->NearLegSide     ));
	memcpy( order->NearLegSettlDate, db_order->NearLegSettlDate		, sizeof( order->NearLegSettlDate));

	        order->NearLegMktPrc   = AtoD( db_order->NearLegMktPrc  , sizeof( db_order->NearLegMktPrc    ));
	        order->NearLegCvPrc    = AtoD( db_order->NearLegCvPrc   , sizeof( db_order->NearLegCvPrc     ));
	        order->NearLegCoPrc    = AtoD( db_order->NearLegCoPrc   , sizeof( db_order->NearLegCoPrc     ));

			order->NearLegMktPrc   = 0.0D;
        	order->NearLegCvPrc    = 0.0D;
        	order->NearLegCoPrc    = 0.0D;
	        order->NearLegCusPrc   = AtoD( db_order->NearLegPrice   , sizeof( db_order->NearLegPrice     ));
	        order->NearLegCusSpr   = AtoD( db_order->NearLegPriceSprd, sizeof( db_order->NearLegPriceSprd));

	memcpy( order->FarSettType     , db_order->FarSettType     		, sizeof( order->FarSettType     ));
	memcpy( order->FarTnrId        , db_order->FarTnrId     		, sizeof( order->FarTnrId     ));
	memcpy( order->FarTnrPtrnDcd   , db_order->FarTnrPtrnDcd     	, sizeof( order->FarTnrPtrnDcd     ));
	
	memcpy( order->FarLegSide      , db_order->FarLegSide      		, sizeof( order->FarLegSide      ));
	memcpy( order->FarLegSettlDate , db_order->FarLegSettlDate 		, sizeof( order->FarLegSettlDate ));

	        order->FarLegMktPrc    = AtoD( db_order->FarLegMktPrc   , sizeof( db_order->FarLegMktPrc     ));
	        order->FarLegCvPrc     = AtoD( db_order->FarLegCvPrc    , sizeof( db_order->FarLegCvPrc      ));
	        order->FarLegCoPrc     = AtoD( db_order->FarLegCoPrc    , sizeof( db_order->FarLegCoPrc      ));

			order->FarLegMktPrc    = 0.0D;
			order->FarLegCvPrc     = 0.0D;
			order->FarLegCoPrc     = 0.0D;
	        order->FarLegCusPrc    = AtoD( db_order->FarLegPrice   , sizeof( db_order->FarLegPrice       ));
	        order->FarLegCusSpr    = AtoD( db_order->FarLegPriceSprd, sizeof( db_order->FarLegPriceSprd  ));
#else
	memcpy( order->NearSettType    , space							, sizeof( order->NearSettType    ));
	memcpy( order->NearTnrId       , space							, sizeof( order->NearTnrId       ));
	memcpy( order->NearTnrPtrnDcd  , space						   	, sizeof( order->NearTnrPtrnDcd  ));

	memcpy( order->NearLegSide     , space  			     		, sizeof( order->NearLegSide     ));
	memcpy( order->NearLegSettlDate, space							, sizeof( order->NearLegSettlDate));

	        order->NearLegMktPrc   = 0.0D;
	        order->NearLegCvPrc    = 0.0D;
	        order->NearLegCoPrc    = 0.0D;

			order->NearLegMktPrc   = 0.0D;
        	order->NearLegCvPrc    = 0.0D;
        	order->NearLegCoPrc    = 0.0D;
	        order->NearLegCusPrc   = 0.0D;
	        order->NearLegCusSpr   = 0.0D;

	memcpy( order->FarSettType     , space					 		, sizeof( order->FarSettType     ));
	memcpy( order->FarTnrId        , space							, sizeof( order->FarTnrId     ));
	memcpy( order->FarTnrPtrnDcd   , space						  	, sizeof( order->FarTnrPtrnDcd     ));
	
	memcpy( order->FarLegSide      , space							, sizeof( order->FarLegSide      ));
	memcpy( order->FarLegSettlDate , space							, sizeof( order->FarLegSettlDate ));

	        order->FarLegMktPrc    = 0.0D;
	        order->FarLegCvPrc     = 0.0D;
	        order->FarLegCoPrc     = 0.0D;

			order->FarLegMktPrc    = 0.0D;
			order->FarLegCvPrc     = 0.0D;
			order->FarLegCoPrc     = 0.0D;
	        order->FarLegCusPrc    = 0.0D;
	        order->FarLegCusSpr    = 0.0D;
#endif
			
	memcpy( order->TranPtrnCd      , db_order->FX_TRN_TCD           , sizeof( order->TranPtrnCd      ));
	memcpy( order->GrpOrdnNo       , db_order->GRP_ORDN_NO			, sizeof( order->GrpOrdnNo       ));
#if 0
	memcpy( order->GrpOrdnCnt      , db_order->GrpOrdnCnt           , sizeof( order->GrpOrdnCnt      ));
	memcpy( order->GrpOrdnSeq      , db_order->GrpOrdnSeq           , sizeof( order->GrpOrdnSeq      ));
#endif

	/* 임시 - 보류, 그룹주문에 해당하는 2개 컬럼은 아직 준비되어 있지 않음 */
	memcpy( order->GrpFxPdcd       , space							, sizeof( order->GrpFxPdcd      ));
	memcpy( order->TrdTypeDcd      , "1"							, sizeof( order->TrdTypeDcd      ));
#if 0

	memcpy( order->TrdTypeDcd      , db_order->TrdTypeDcd           , sizeof( order->TrdTypeDcd      ));
	        order->SpotPrc         = AtoD( db_order->SpotPrc        , sizeof( db_order->SpotPrc     ));
#endif

	memset( order->filler          , ' '          					, sizeof( order->filler          ));
			order->Eof[ 0]         = 0x00;

	/*
	ORDER_Print( order);
	*/

	return 1;
}


int DB_ORDER_Print( DB_ORDER* ptr)
{
    LogRaw( "%s", "----[ DB_ORDER ]------------------------------------------------------------------------\n");
    LogRaw( "주문번호                      ORDN_NO               31    0 = [%.31s]\n", 	ptr->ORDN_NO);
    LogRaw( "원거래주문번호                ORTR_ORDN_NO          31   31 = [%.31s]\n", 	ptr->ORTR_ORDN_NO);
    LogRaw( "당초주문번호                  OUST_ORDN_NO          31   62 = [%.31s]\n", 	ptr->OUST_ORDN_NO);
    LogRaw( "그룹주문번호                  GRP_ORDN_NO           31   93 = [%.31s]\n", 	ptr->GRP_ORDN_NO);
    LogRaw( "주문년월일                    ORDN_YMD               9  124 = [%.9s]\n", 	ptr->ORDN_YMD);
    LogRaw( "주문구분코드                  ORDN_DCD               2  133 = [%.2s]\n", 	ptr->ORDN_DCD);
    LogRaw( "호가ID                        PRAS_ID               61  135 = [%.61s]\n", 	ptr->PRAS_ID);
    LogRaw( "외환중개사ID                  FDM_ID                11  196 = [%.11s]\n", 	ptr->FDM_ID);
    LogRaw( "주문원천구분코드              ORDN_ORGN_DCD          2  207 = [%.2s]\n", 	ptr->ORDN_ORGN_DCD);
    LogRaw( "CHAR                          ORDN_ORGN_SUB_DCD      2  209 = [%.2s]\n", 	ptr->ORDN_ORGN_SUB_DCD);
    LogRaw( "FX거래유형코드                FX_TRN_TCD             2  211 = [%.2s]\n", 	ptr->FX_TRN_TCD);
    LogRaw( "자동거래구분코드              AUON_DCD               2  213 = [%.2s]\n", 	ptr->AUON_DCD);
    LogRaw( "VARCHAR2                      ORDE_ID               21  215 = [%.21s]\n", 	ptr->ORDE_ID);
    LogRaw( "전행고객실명대체번호          WBCS_RLNM_ALTR_NO     17  236 = [%.17s]\n", 	ptr->WBCS_RLNM_ALTR_NO);
    LogRaw( "PU코드                        PU_CD                  6  253 = [%.6s]\n", 	ptr->PU_CD);
    LogRaw( "FX북ID                        FXBK_ID               21  259 = [%.21s]\n", 	ptr->FXBK_ID);
    LogRaw( "관리부점코드                  MNGM_BRCD              5  280 = [%.7s]\n", 	ptr->MNGM_BRCD);
    LogRaw( "본점마진적용그룹ID            HDOM_APLY_GRP_ID       4  285 = [%.4s]\n", 	ptr->HDOM_APLY_GRP_ID);
    LogRaw( "FX상품코드                    FX_PDCD                4  289 = [%.4s]\n", 	ptr->FX_PDCD);
    LogRaw( "통화페어ID                    CRNC_PAIR_ID           8  293 = [%.8s]\n", 	ptr->CRNC_PAIR_ID);
    LogRaw( "TENOR유형구분코드             TNR_PTRN_DCD           2  301 = [%.2s]\n", 	ptr->TNR_PTRN_DCD);
