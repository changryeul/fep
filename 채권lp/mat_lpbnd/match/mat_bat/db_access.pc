/*******************************************************************************
* Function Name : TEST00A01()
* Description   : 에러코드조회/등록/수정/삭제
*******************************************************************************/
int Db_Process()
{
	int		rtn;

	rtn = l_dbconnect();
	if( rtn != RET_SUCCESS)
	{
		LogCri( "DB CONNECT ERROR. rtn=[%d] ", rtn);
		return -1;
	}
	LogDbg( "DB CONNECT SUCCESS. rtn=[%d] ", rtn);


	/* 통화쌍 정보 */
	LogMsg( "Table %s에서 외환 거래 정보를 load합니다.", "COD_FXPAIR");
	rtn = Db_GetCodFxPair();
	if( rtn != RET_SUCCESS)
	{
		rtn = -1;
		goto error;
	}

	/* 시세 유효시간 정보 */
	LogMsg( "Table %s에서 시세 유효시간 정보를 load합니다.", "TB_FXB_CMC003D");
	Db_GetCmc003C();
	if( rtn != RET_SUCCESS)
	{
		rtn = -1;
		goto error;
	}

	/* 에러 메세지 */
	/*
	Db_GetSyg001M();
	*/

	/* 장시간 정보 */
	rtn = Db_GetTbFxbCmc001M();
	if( rtn != RET_SUCCESS)
	{
		rtn = -2;
		goto error;
	}

	/* 주문중지 시간 정보 */
	rtn = Db_GetTbFxbCmc003D();
	if( rtn != RET_SUCCESS)
	{
		rtn = -3;
		goto error;
	}

	/* 통화별 장운영 정보 */
	rtn = Db_GetCmg039M();
	if( rtn != RET_SUCCESS)
	{
		rtn = -4;
		goto error;
	}

	/* 유효 주문 Load */
	rtn = Db_Order();
	if( rtn != RET_SUCCESS)
	{
		rtn = -5;
		goto error;
	}


	rtn = l_dbdisconnect();
	if( rtn != RET_SUCCESS)
	{
		LogCri( "DB DISCONNECT ERROR. rtn=[%d] ", rtn);
		return -6;
	}
	LogDbg( "DB DISCONNECT SUCCESS. rtn=[%d] ", rtn);


	// 처리 결과를 보낸다.
  	return rtn;

	error:
		LogCri( "DB Process fail. rtn=[%d] ", rtn);
		l_dbdisconnect();
		return rtn;
}

/*******************************************************************************
* Function Name : Db_GetCodFxPair()
* Description   : 통화쌍 정보 upload
********************************************************************************/
int Db_GetCodFxPair()
{
	int		i, cnt;
	int		ii;

	EXEC SQL BEGIN DECLARE SECTION;
	TB_FXB_CMG004M			_cmg004m; 
	TB_FXB_CMG004M			*cmg004m = &_cmg004m;
	EXEC SQL END DECLARE SECTION;

	//---------------------------------------------------------------------
	// 4.조회 
	//--------------------------------------------------------------------
	EXEC SQL DECLARE TB_FXB_OPR_CMG004M CURSOR FOR
	SELECT 
		CRNC_PAIR_ID,
		BASE_CRCD,
		COCU_CD,
		EMP_CLCL_DCPU_RCN,
		EMP_CLCL_DCPU_VL,
		CUS_CLCL_DCPU_RCN,
		CUS_CLCL_DCPU_VL,
		PL_CRNC_PAIR_ID,
		FX_PRLOC_DCD,
		FX_PCRR_UT,
		DCPN_PCSN_DCD,
		SPOT_DT_CDNC_VL,
		RPSN_SQC,
		USE_YN,
		FX_SYS_LSMD_ID,
		TO_CHAR( FX_SYS_LSMD_TS, 'YYYYMMDDHH24MISS')
	FROM TB_FXB_CMG004M
	ORDER BY RPSN_SQC
	;

	if (SQLCODE != 0)
	{
		LogCri( "SAMPLE  CURSOR DECLARE Error = [%d]", SQLCODE);
		return -1;
	}

	EXEC SQL OPEN TB_FXB_OPR_CMG004M;
	if (SQLCODE != 0)
	{
   		if (SQLCODE == NO_DATA_FOUND)
   		{
			LogCri( "건수없음 SQLCODE=[%d]=================", SQLCODE);
   			return(RET_FAILURE);
   		}
		else
		{
			LogCri( "SAMPLE CURSOR OPEN Error = [%d]", SQLCODE);
			return(RET_FAILURE);
		}
   	}

	for (ii = 0; ;ii++)
	{
		//출력값 메모리 초기화
		memset( cmg004m, 0x00, sizeof( TB_FXB_CMG004M));

	 	EXEC SQL 
		FETCH TB_FXB_OPR_CMG004M
		INTO
			:cmg004m->CRNC_PAIR_ID		,
			:cmg004m->BASE_CRCD			,
			:cmg004m->COCU_CD			,
			:cmg004m->EMP_CLCL_DCPU_RCN	,
			:cmg004m->EMP_CLCL_DCPU_VL	,
			:cmg004m->CUS_CLCL_DCPU_RCN	,
			:cmg004m->CUS_CLCL_DCPU_VL	,
			:cmg004m->PL_CRNC_PAIR_ID	,
			:cmg004m->FX_PRLOC_DCD		,
			:cmg004m->FX_PCRR_UT		,
			:cmg004m->DCPN_PCSN_DCD		,
			:cmg004m->SPOT_DT_CDNC_VL	,
			:cmg004m->RPSN_SQC			,
			:cmg004m->USE_YN			,
			:cmg004m->FX_SYS_LSMD_ID	,
			:cmg004m->FX_SYS_LSMD_TS
			;
		if (SQLCODE != 0)
		{
			if (SQLCODE == NO_DATA_FOUND )
			{
				break;
			}
			else
			{
				LogCri( "SAMPLE CURSOR Fetch Error = [%d]", SQLCODE);
				EXEC SQL CLOSE TB_FXB_OPR_CMG004M;
				return(RET_FAILURE);
			}
		}
		else
		{
			//APLog(content->rkey, APLOG_DEBUG, "[%-15s][%4d] 에러코드	[%s]", __FUNCTION__, __LINE__, c_errCd );
			//APLog(content->rkey, APLOG_DEBUG, "[%-15s][%4d] 에러메시지  [%s]", __FUNCTION__, __LINE__, c_errMsg);
			;
		}	

		/* TB_FXB_CMG004M_Print( cmg004m); */
		//로그출력 Level DEBUG
		LogRaw( "[%s][%d][%d][%3d][%2d][%s][%s][%s]\n",
			cmg004m->CRNC_PAIR_ID,
			( int)cmg004m->EMP_CLCL_DCPU_RCN,
			( int)cmg004m->CUS_CLCL_DCPU_RCN,
			( int)cmg004m->FX_PCRR_UT,
			( int)cmg004m->RPSN_SQC,
			cmg004m->USE_YN,
			cmg004m->FX_SYS_LSMD_ID,
			cmg004m->FX_SYS_LSMD_TS
			);
		if( cmg004m->USE_YN[ 0] != 'Y') continue;
		Mat_AddIndex( Mat, cmg004m->CRNC_PAIR_ID, 
				( int)cmg004m->EMP_CLCL_DCPU_RCN, 
				( int)cmg004m->FX_PCRR_UT);
	}

	EXEC SQL CLOSE TB_FXB_OPR_CMG004M;

	//--------------------------------------------------------------
	// 정상 처리 세팅 (0:정상, 1:비정상)
	//--------------------------------------------------------------
	LogMsg( "그리드건수 = [%d]", ii);
	return(RET_SUCCESS);
}

/*******************************************************************************
* Function Name : Db_GetCmc003C()
* Description   : 시세유효시간 정보 upload
********************************************************************************/
int Db_GetCmc003C()
{
	int			i, cnt;
	int			ii;
	int			base, cont;
	MAT_INDEX	*index;

	EXEC SQL BEGIN DECLARE SECTION;
	PRICE_TIME			_price_time; 
	PRICE_TIME			*price_time = &_price_time;
	EXEC SQL END DECLARE SECTION;

	//---------------------------------------------------------------------
	// 4.조회 
	//--------------------------------------------------------------------
	EXEC SQL DECLARE TB_FXB_PRICE_TIME_C1 CURSOR FOR
	SELECT 
		CMCD_VL,
		CMCD_VL_REF_CON1,
		USE_YN
	FROM TB_FXB_CMC003D
	WHERE COM_CD_NM = 'MCTX_DLY_ALWN_TIM'
	;
	

	if (SQLCODE != 0)
	{
		LogCri( "SAMPLE  CURSOR DECLARE Error = [%d]", SQLCODE);
		return -1;
	}

	EXEC SQL OPEN TB_FXB_PRICE_TIME_C1;
	if (SQLCODE != 0)
	{
   		if (SQLCODE == NO_DATA_FOUND)
   		{
			LogCri( "건수없음 SQLCODE=[%d]=================", SQLCODE);
   			return(RET_FAILURE);
   		}
		else
		{
			LogCri( "SAMPLE CURSOR OPEN Error = [%d]", SQLCODE);
			return(RET_FAILURE);
		}
   	}

	for (ii = 0; ;ii++)
	{
		//출력값 메모리 초기화
		memset( price_time, 0x00, sizeof( PRICE_TIME));

	 	EXEC SQL 
		FETCH TB_FXB_PRICE_TIME_C1
		INTO
			:price_time->vl					,
			:price_time->ref_con1			,
			:price_time->vl_use_yn			
			;
		if (SQLCODE != 0)
		{
			if (SQLCODE == NO_DATA_FOUND )
			{
				break;
			}
			else
			{
				LogCri( "SAMPLE CURSOR Fetch Error = [%d]", SQLCODE);
				EXEC SQL CLOSE TB_FXB_PRICE_TIME_C1;
				return(RET_FAILURE);
			}
		}
		else
		{
			//APLog(content->rkey, APLOG_DEBUG, "[%-15s][%4d] 에러코드	[%s]", __FUNCTION__, __LINE__, c_errCd );
			//APLog(content->rkey, APLOG_DEBUG, "[%-15s][%4d] 에러메시지  [%s]", __FUNCTION__, __LINE__, c_errMsg);
			;
		}	

		//로그출력 Level DEBUG
		LogRaw( "[%.7s][%.7s][%s]\n",
			price_time->vl,
			price_time->ref_con1,
			price_time->vl_use_yn
			);
		base  = Mat_GetCurrentInt( Mat, &price_time->vl[ 0]);
		cont  = Mat_GetCurrentInt( Mat, &price_time->vl[ 4]);
		index = Mat_GetIndex( Mat, base, cont);
		if( index == NULL)
		{
			LogCri( "index not found. vl=[%s]", price_time->vl);
			continue;
		}
		if( price_time->vl_use_yn[ 0] == 'Y')
		{
			index->price_time = AtoI( price_time->ref_con1, sizeof( price_time->ref_con1));
		}
		else
		{
			index->price_time = 0;
		}

		/*
		TB_FXB_CMG004M_Print( dh_pare);
		*/
	}

	EXEC SQL CLOSE TB_FXB_PRICE_TIME_C1;

	//--------------------------------------------------------------
	// 정상 처리 세팅 (0:정상, 1:비정상)
	//--------------------------------------------------------------
	LogMsg( "그리드건수 = [%d]", ii);
	return(RET_SUCCESS);
}

/*******************************************************************************
* Function Name : Db_GetCmg039M()
* Description   : 통화 장운영 정보 upload
********************************************************************************/
int Db_GetCmg039M()
{
	int				i, cnt;
	int				ii;
	int				base, cont;
	MAT_INDEX		*index;

	time_t			cur_time;
	struct tm		_tm, *tp = &_tm;
	int				int_today;
	int				int_stime, int_etime;
	int				int_hour, int_min, int_sec;
	int				s_day, e_day;
	MAT_JANG		*jang;
	MAT_JANG_REC	*jp;		/* jang_pointer */

	EXEC SQL BEGIN DECLARE SECTION;
	JANG_DB_REC			_jang_rec; 
	JANG_DB_REC			*jang_rec = &_jang_rec;
	EXEC SQL END DECLARE SECTION;

	time( &cur_time);
	localtime_r( &cur_time, tp);
	int_today = ( tp->tm_year +1900) * 10000
			+ ( tp->tm_mon +1) * 100
			+ tp->tm_mday;
	LogDbg( "today=[%d]", int_today);

	//---------------------------------------------------------------------
	// 4.조회 
	//--------------------------------------------------------------------
	EXEC SQL DECLARE TB_FXB_CMG039M_C1 CURSOR FOR
	SELECT 
		CRCD           ,
		FX_PDCD        ,
		PDF_TNR_CLSF_ID,
		APSR_YMD       ,
		FNAP_YMD       ,
		LMT_STTG_HMS   ,
		LMT_FNSH_HMS   ,
		MKT_STTG_HMS   ,
		MKT_FNSH_HMS   ,
		USE_YN         ,
		FX_SYS_LSMD_ID ,
		TO_CHAR( FX_SYS_LSMD_TS, 'YYYYMMDDHH24MISS')
	FROM TB_FXB_CMG039M
	;

	if (SQLCODE != 0)
	{
		LogCri( "TB_FXB_CMG039M_C1 CURSOR DECLARE Error = [%d]", SQLCODE);
		return -1;
	}

	EXEC SQL OPEN TB_FXB_CMG039M_C1;
	if (SQLCODE != 0)
	{
   		if (SQLCODE == NO_DATA_FOUND)
   		{
			LogCri( "건수없음 SQLCODE=[%d]=================", SQLCODE);
   			return(RET_FAILURE);
   		}
		else
		{
			LogCri( "TB_FXB_CMG039M_C1 CURSOR OPEN Error = [%d]", SQLCODE);
			return(RET_FAILURE);
		}
   	}


	/* 공유메모리 장운영 assign */
	jang = &Mat->map->jang;
	jang->cnt = 1;	/* 장운영 초기화 ... 0번 record는 쓰지 않음 */

	for (ii = 0; ;ii++)
	{
		//출력값 메모리 초기화
		memset( jang_rec, 0x00, sizeof( JANG_DB_REC));

	 	EXEC SQL 
		FETCH TB_FXB_CMG039M_C1
		INTO
			:jang_rec->CRCD           ,
			:jang_rec->FX_PDCD        ,
			:jang_rec->PDF_TNR_CLSF_ID,
			:jang_rec->APSR_YMD       ,
			:jang_rec->FNAP_YMD       ,
			:jang_rec->LMT_STTG_HMS   ,
			:jang_rec->LMT_FNSH_HMS   ,
			:jang_rec->MKT_STTG_HMS   ,
			:jang_rec->MKT_FNSH_HMS   ,
			:jang_rec->USE_YN         ,
			:jang_rec->FX_SYS_LSMD_ID ,
			:jang_rec->FX_SYS_LSMD_TS
			;
		if (SQLCODE != 0)
		{
			if (SQLCODE == NO_DATA_FOUND )
			{
				break;
			}
			else
			{
				LogCri( "TB_FXB_CMG039M_C1 CURSOR Fetch Error = [%d]", SQLCODE);
				EXEC SQL CLOSE TB_FXB_CMG039M_C1;
				return(RET_FAILURE);
			}
		}
		else
		{
			;
		}	

		// JANG_DB_REC_Print( jang_rec);
		LogRaw( "[%s]", jang_rec->CRCD);
		LogRaw( "[%s]", jang_rec->FX_PDCD);
		LogRaw( "[%s]", jang_rec->PDF_TNR_CLSF_ID);
		LogRaw( "[%s]", jang_rec->APSR_YMD);
		LogRaw( "[%s]", jang_rec->FNAP_YMD);
		LogRaw( "[%s]", jang_rec->USE_YN);

		/* 적용 시작일 */
		if( int_today < atoi( jang_rec->APSR_YMD)) 
		{
			LogMsg( "장운영 적용 시작일이 아닙니다. today=[%08d] start=[%08d]", int_today, atoi( jang_rec->APSR_YMD));
			continue;
		}

		/* 적용 종료일 */
		if( int_today > atoi( jang_rec->FNAP_YMD)) 
		{
			LogMsg( "장운영 적용 종료일이 지났습니다. today=[%08d] start=[%08d]", int_today, atoi( jang_rec->FNAP_YMD));
			continue;
		}

		/* 사용여부 */
		if( jang_rec->USE_YN[ 0] != 'Y')
		{
			LogMsg( "사용하지 않는 record 입니다. USE_YN=[%s]", jang_rec->USE_YN);
			continue;
		}

		LogRaw( " ->\n");

		/* 시장가 */
		jp = &jang->rec[ jang->cnt];
		sprintf( jp->key, "%s%s%s%s", jang_rec->CRCD, "M", jang_rec->FX_PDCD, jang_rec->PDF_TNR_CLSF_ID);
		jp->start = Mat_JangHtoT( Mat, jang_rec->MKT_STTG_HMS);
		jp->end   = Mat_JangHtoT( Mat, jang_rec->MKT_FNSH_HMS);
		if( jp->start > jp->end)	jp->end += 24 * 3600;
		jp->used  = 1;
		jang->cnt++;
		if( jang->cnt >= MAT_MAX_JANG)
		{
			LogCri( "장운영 record full. curr:max=[%d:%d]", jang->cnt, MAT_MAX_JANG);
			return -1;
		}
		LogRaw( "    ");
		LogRaw( "[%s]", jp->key);
		LogRaw( "[%s]", TtoS( jp->start));
		LogRaw( "[%s]", TtoS( jp->end));
		LogRaw( "\n");

		/* 지정가 */
		jp = &jang->rec[ jang->cnt];
		sprintf( jp->key, "%s%s%s%s", jang_rec->CRCD, "F", jang_rec->FX_PDCD, jang_rec->PDF_TNR_CLSF_ID);
		jp->start = Mat_JangHtoT( Mat, jang_rec->LMT_STTG_HMS);
		jp->end   = Mat_JangHtoT( Mat, jang_rec->LMT_FNSH_HMS);
		if( jp->start >= jp->end)	jp->end += 24 * 3600;
		jp->used  = 1;
		jang->cnt++;
		if( jang->cnt >= MAT_MAX_JANG)
		{
			LogCri( "장운영 record full. curr:max=[%d:%d]", jang->cnt, MAT_MAX_JANG);
			return -1;
		}
		LogRaw( "    ");
		LogRaw( "[%s]", jp->key);
		LogRaw( "[%s]", TtoS( jp->start));
		LogRaw( "[%s]", TtoS( jp->end));
		LogRaw( "\n");
	}

	EXEC SQL CLOSE TB_FXB_CMG039M_C1;

	//--------------------------------------------------------------
	// 정상 처리 세팅 (0:정상, 1:비정상)
	//--------------------------------------------------------------
	LogMsg( "그리드건수 = [%d]", ii);
	LogMsg( "장운영건수 = [%d]", jang->cnt);
	LogMsg( "jang size  = [%d]", sizeof( MAT_JANG));
	return(RET_SUCCESS);
}

#if 0
/*******************************************************************************
* Function Name : Db_GetCmg039M()
* Description   : 통화페어 정운영 정보 upload
********************************************************************************/
int Db_GetCmg039M_Not()
{
	int				i, cnt;
	int				ii;
	int				base, cont;
	MAT_INDEX		*index;

	time_t			cur_time;
	struct tm		_tm, *tp = &_tm;
	int				int_today;
	int				int_stime, int_etime;
	int				int_hour, int_min, int_sec;
	int				s_day, e_day;
	MAT_JANG_REC	_jang, *jang = &_jang;

	EXEC SQL BEGIN DECLARE SECTION;
	MAT_JANG			_jang_pair; 
	MAT_JANG			*jang_pair = &_jang_pair;
	EXEC SQL END DECLARE SECTION;

	time( &cur_time);
	localtime_r( &cur_time, tp);
	int_today = ( tp->tm_year +1900) * 10000
			+ ( tp->tm_mon +1) * 100
			+ tp->tm_mday;
	LogDel( "today=[%d]", int_today);

	//---------------------------------------------------------------------
	// 4.조회 
	//--------------------------------------------------------------------
	EXEC SQL DECLARE TB_FXB_CMG039M_C1 CURSOR FOR
	SELECT 
		CRNC_PAIR_ID     ,
		PDF_TNR_CLSF_ID  ,
		APSR_YMD         ,
		FNAP_YMD         ,
		STTG_HMS         ,
		FNSH_HMS         ,
		USE_YN           ,
		FX_SYS_LSMD_ID   ,
		TO_CHAR( FX_SYS_LSMD_TS, 'YYYYMMDDHH24MISS')
	FROM TB_FXB_CMG039M
	;

	if (SQLCODE != 0)
	{
		LogCri( "TB_FXB_CMG039M_C1 CURSOR DECLARE Error = [%d]", SQLCODE);
		return -1;
	}

	EXEC SQL OPEN TB_FXB_CMG039M_C1;
	if (SQLCODE != 0)
	{
   		if (SQLCODE == NO_DATA_FOUND)
   		{
			LogCri( "건수없음 SQLCODE=[%d]=================", SQLCODE);
   			return(RET_FAILURE);
   		}
		else
		{
			LogCri( "TB_FXB_CMG039M_C1 CURSOR OPEN Error = [%d]", SQLCODE);
			return(RET_FAILURE);
		}
   	}

	for (ii = 0; ;ii++)
	{
		//출력값 메모리 초기화
		memset( jang_pair, 0x00, sizeof( MAT_JANG));

	 	EXEC SQL 
		FETCH TB_FXB_CMG039M_C1
		INTO
			:jang_pair->CRNC_PAIR_ID     ,
			:jang_pair->PDF_TNR_CLSF_ID  ,
			:jang_pair->APSR_YMD         ,
			:jang_pair->FNAP_YMD         ,
			:jang_pair->STTG_HMS         ,
			:jang_pair->FNSH_HMS         ,
			:jang_pair->USE_YN           ,
			:jang_pair->FX_SYS_LSMD_ID   ,
			:jang_pair->FX_SYS_LSMD_TS   
			;
		if (SQLCODE != 0)
		{
			if (SQLCODE == NO_DATA_FOUND )
			{
				break;
			}
			else
			{
				LogCri( "TB_FXB_CMG039M_C1 CURSOR Fetch Error = [%d]", SQLCODE);
				EXEC SQL CLOSE TB_FXB_CMG039M_C1;
				return(RET_FAILURE);
			}
		}
		else
		{
			;
		}	

#if 0
		JANG_PAIR_Print( jang_pair);
#endif

		s_day = AtoI( jang_pair->APSR_YMD, sizeof( jang_pair->APSR_YMD));
		e_day = AtoI( jang_pair->FNAP_YMD, sizeof( jang_pair->FNAP_YMD));

		LogDel( "s_day=[%d] e_day=[%d]", s_day, e_day);

		if( s_day > int_today) continue;
		if( e_day < int_today) continue;
		if( jang_pair->USE_YN[ 0] != 'Y') continue;

		LogRaw( "[%.7s][%.3s][%.8s][%.8s][%.6s][%.6s]\n",
			jang_pair->CRNC_PAIR_ID,
			jang_pair->PDF_TNR_CLSF_ID,
			jang_pair->APSR_YMD,
			jang_pair->FNAP_YMD,
			jang_pair->STTG_HMS,
			jang_pair->FNSH_HMS
		);

		memcpy( jang->start_day,	jang_pair->APSR_YMD,	sizeof( jang->start_day));
		memcpy( jang->end_day,		jang_pair->FNAP_YMD,	sizeof( jang->end_day));
		memcpy( jang->start_time,	jang_pair->STTG_HMS,	sizeof( jang->start_time));
		memcpy( jang->end_time,		jang_pair->FNSH_HMS,	sizeof( jang->end_time));
		jang->used = 1;

		time( &cur_time);
		localtime_r( &cur_time, tp);

		int_stime = AtoI( jang_pair->STTG_HMS, sizeof( jang_pair->STTG_HMS));
		int_etime = AtoI( jang_pair->FNSH_HMS, sizeof( jang_pair->FNSH_HMS));
		tp->tm_hour = int_stime / 10000;
		tp->tm_min  = ( int_stime % 10000) / 100;
		tp->tm_sec  = int_stime % 100;
		jang->s_time = mktime( tp);

		if( int_stime >= int_etime)			/* 다음날 장종료 */
		{
			LogDel( "다음날 set");
			time( &cur_time);
			cur_time += ( 24 * 3600);
			localtime_r( &cur_time, tp);
		}
		tp->tm_hour = int_etime / 10000;
		tp->tm_min  = ( int_etime % 10000) / 100;
		tp->tm_sec  = int_etime % 100;
		jang->e_time = mktime( tp);
		LogDel( "jang->e_time=[%s]", TtoS( jang->e_time));

		if( !memcmp( jang_pair->PDF_TNR_CLSF_ID, "MAR", 3))				jang->id = 1;
		else if( !memcmp( jang_pair->PDF_TNR_CLSF_ID, "TOD", 3))		jang->id = 2;
		else if( !memcmp( jang_pair->PDF_TNR_CLSF_ID, "TOM", 3))		jang->id = 3;
		else if( !memcmp( jang_pair->PDF_TNR_CLSF_ID, "SPT", 3))		jang->id = 4;
		else if( !memcmp( jang_pair->PDF_TNR_CLSF_ID, "FWD", 3))		jang->id = 5;
		else if( !memcmp( jang_pair->PDF_TNR_CLSF_ID, "SWP", 3))		jang->id = 6;
		else															
		{
			LogCri( "unknown order type. type=[%s]", jang_pair->PDF_TNR_CLSF_ID);
			jang->id = 0;
		}
		LogDel( "jang->id=[%d]", jang->id);

		Mat_SetJang( Mat, jang_pair->CRNC_PAIR_ID, jang);

	}

	EXEC SQL CLOSE TB_FXB_CMG039M_C1;

	//--------------------------------------------------------------
	// 정상 처리 세팅 (0:정상, 1:비정상)
	//--------------------------------------------------------------
	LogMsg( "그리드건수 = [%d]", ii);
	return(RET_SUCCESS);
}
#endif

/*******************************************************************************
* Function Name : Db_GetTbFxbCmc001M()
* Description   : 장 시작시간, 장 마감시간 정보 GET
********************************************************************************/
int Db_GetTbFxbCmc001M()
{
	time_t		cur_time;
	int			s_time, e_time;
	struct tm	_tm, *tp = &_tm;

	EXEC SQL BEGIN DECLARE SECTION;
	TB_FXB_CMG001M	_tb_fxb_cmg001m;
	TB_FXB_CMG001M	*tb_fxb_cmg001m = &_tb_fxb_cmg001m;
	EXEC SQL END DECLARE SECTION;

	//---------------------------------------------------------------------
	// 4.조회 
	//--------------------------------------------------------------------
	//출력값 메모리 초기화
	memset( tb_fxb_cmg001m, 0x00, sizeof( TB_FXB_CMG001M));

 	EXEC SQL SELECT
		FDM_ID,
		FDM_NM,
		OPN_YMD,
		FNSH_YMD,
		OPRT_YN,
		HLDD_YN,
		TRN_STTG_HMS,
		TRN_FNSH_HMS,
		TRNM_TRN_TGIS_ID,
		TRNM_TRN_SUB_TGIS_ID,
		RCTX_TGIS_ID,
		RCTX_SUB_TGIS_ID,
		USE_YN,
		FX_SYS_LSMD_ID,
		TO_CHAR( FX_SYS_LSMD_TS, 'YYYYMMDDHH24MISS')
	INTO
		:tb_fxb_cmg001m->FDM_ID,
		:tb_fxb_cmg001m->FDM_NM,
		:tb_fxb_cmg001m->OPN_YMD,
		:tb_fxb_cmg001m->FNSH_YMD,
		:tb_fxb_cmg001m->OPRT_YN,
		:tb_fxb_cmg001m->HLDD_YN,
		:tb_fxb_cmg001m->TRN_STTG_HMS,
		:tb_fxb_cmg001m->TRN_FNSH_HMS,
		:tb_fxb_cmg001m->TRNM_TRN_TGIS_ID,
		:tb_fxb_cmg001m->TRNM_TRN_SUB_TGIS_ID,
		:tb_fxb_cmg001m->RCTX_TGIS_ID,
		:tb_fxb_cmg001m->RCTX_SUB_TGIS_ID,
		:tb_fxb_cmg001m->USE_YN,
		:tb_fxb_cmg001m->FX_SYS_LSMD_ID,
		:tb_fxb_cmg001m->FX_SYS_LSMD_TS
	FROM TB_FXB_CMG001M
	WHERE
		FDM_ID = 'FRX'
		AND USE_YN = 'Y'
		AND OPRT_YN = 'Y'
		AND HLDD_YN = 'N'
		;
	if (SQLCODE != 0)
	{
		if (SQLCODE == NO_DATA_FOUND )
		{
			return NO_DATA_FOUND;
		}
		else
		{
			LogCri( "SAMPLE CURSOR Fetch Error = [%d]", SQLCODE);
			return(RET_FAILURE);
		}
	}
	else
	{
		//APLog(content->rkey, APLOG_DEBUG, "[%-15s][%4d] 에러코드	[%s]", __FUNCTION__, __LINE__, c_errCd );
		//APLog(content->rkey, APLOG_DEBUG, "[%-15s][%4d] 에러메시지  [%s]", __FUNCTION__, __LINE__, c_errMsg);
		;
	}	

	TB_FXB_CMG001M_Print( tb_fxb_cmg001m);

	time( &cur_time);
	localtime_r( &cur_time, tp);

	s_time = atoi( tb_fxb_cmg001m->TRN_STTG_HMS);
	e_time = atoi( tb_fxb_cmg001m->TRN_FNSH_HMS);

	tp->tm_hour = s_time / 10000;
	tp->tm_min  = ( s_time % 10000) / 100;
	tp->tm_sec  = s_time % 100;
	Mat->map->stat.start = mktime( tp);

	if( e_time < s_time)
	{
		cur_time += 24 *3600;
		localtime_r( &cur_time, tp);
	}

	tp->tm_hour = e_time / 10000;
	tp->tm_min  = ( e_time % 10000) / 100;
	tp->tm_sec  = e_time % 100;
	Mat->map->stat.end = mktime( tp);

	LogMsg( "장시작시간  =[%s]", TtoS( Mat->map->stat.start));
	LogMsg( "장마감시간  =[%s]", TtoS( Mat->map->stat.end));

	//--------------------------------------------------------------
	// 정상 처리 세팅 (0:정상, 1:비정상)
	//--------------------------------------------------------------
	return(RET_SUCCESS);
}

/*******************************************************************************
* Function Name : Db_GetTbFxbCmc003D()
* Description   : 주문 중지 시간 
********************************************************************************/
int Db_GetTbFxbCmc003D()
{
	time_t		cur_time;
	struct tm	_tm, *tp = &_tm;
	int			cancel_start;
	int			cancel_end;

	EXEC SQL BEGIN DECLARE SECTION;
	char		start  [ 32 +1];
	char		end    [ 32 +1];
	EXEC SQL END DECLARE SECTION;

	//---------------------------------------------------------------------
	// 4.조회 
	//--------------------------------------------------------------------
	//출력값 메모리 초기화
	memset( start, 0x00, sizeof( start));
	memset( end  , 0x00, sizeof( end  ));

 	EXEC SQL SELECT
		CMCD_VL_REF_CON1,
		CMCD_VL_REF_CON2
	INTO
		:start,
		:end
	FROM TB_FXB_CMC003D
	WHERE
		COM_CD_NM = 'TRN_CNTL_TIM'
	AND	CMCD_VL = '0'
		;
	if (SQLCODE != 0)
	{
		if (SQLCODE == NO_DATA_FOUND )
		{
			return NO_DATA_FOUND;
		}
		else
		{
			LogCri( "SQL ERROR. SQLCODE = [%d]", SQLCODE);
			return(RET_FAILURE);
		}
	}
	else
	{
		//APLog(content->rkey, APLOG_DEBUG, "[%-15s][%4d] 에러코드	[%s]", __FUNCTION__, __LINE__, c_errCd );
		//APLog(content->rkey, APLOG_DEBUG, "[%-15s][%4d] 에러메시지  [%s]", __FUNCTION__, __LINE__, c_errMsg);
		;
	}	

	LogMsg( "start = [%s]", start);
	LogMsg( "end   = [%s]", end  );


	time( &cur_time);
	localtime_r( &cur_time, tp);

	cancel_start = atoi( start);
	cancel_end   = atoi( end  );

	tp->tm_hour = cancel_start / 10000;
	tp->tm_min  = ( cancel_start % 10000) / 100;
	tp->tm_sec  = cancel_start % 100;
	Mat->map->stat.cancel_start = mktime( tp);

	if( cancel_end < cancel_start)
	{
		cur_time += 24 *3600;
		localtime_r( &cur_time, tp);
	}

	tp->tm_hour = cancel_end / 10000;
	tp->tm_min  = ( cancel_end % 10000) / 100;
	tp->tm_sec  = cancel_end % 100;
	Mat->map->stat.cancel_end = mktime( tp);

	LogMsg( "주문중지 시작시간  =[%s]", TtoS( Mat->map->stat.cancel_start));
	LogMsg( "주문중지 종료시간  =[%s]", TtoS( Mat->map->stat.cancel_end));

	//--------------------------------------------------------------
	// 정상 처리 세팅 (0:정상, 1:비정상)
	//--------------------------------------------------------------
	return(RET_SUCCESS);
}

/*******************************************************************************
* Function Name : Db_GetSyg001M()
* Description   : 에러 메세지 upload
********************************************************************************/
int Db_GetSyg001M()
{
	int			i, cnt;
	int			ii;
	MAT_MESSAGE	*msg;

	EXEC SQL BEGIN DECLARE SECTION;
	ERR_MESSAGE			_err_msg; 
	ERR_MESSAGE			*err_msg = &_err_msg;
	EXEC SQL END DECLARE SECTION;

	//---------------------------------------------------------------------
	// 4.조회 
	//--------------------------------------------------------------------
	EXEC SQL DECLARE TB_FXB_ERR_MSG_C1 CURSOR FOR
	SELECT *
	FROM TB_FXB_SYG001M
	ORDER BY FX_ERR_CD
	;
	

	if (SQLCODE != 0)
	{
		LogCri( "SAMPLE  CURSOR DECLARE Error = [%d]", SQLCODE);
		return -1;
	}

	EXEC SQL OPEN TB_FXB_ERR_MSG_C1;
	if (SQLCODE != 0)
	{
   		if (SQLCODE == NO_DATA_FOUND)
   		{
			LogCri( "건수없음 SQLCODE=[%d]=================", SQLCODE);
   			return(RET_FAILURE);
   		}
		else
		{
			LogCri( "SAMPLE CURSOR OPEN Error = [%d]", SQLCODE);
			return(RET_FAILURE);
		}
   	}

	for (ii = 0; ;ii++)
	{
		//출력값 메모리 초기화
		memset( err_msg, 0x00, sizeof( ERR_MESSAGE));

	 	EXEC SQL 
		FETCH TB_FXB_ERR_MSG_C1
		INTO
			:err_msg->fx_err_cd			,
			:err_msg->lngg_dcd			,
			:err_msg->err_cd_con		,
			:err_msg->fx_sys_lsmd_id	,
			:err_msg->fx_sys_lsmd_ts	
			;
		if (SQLCODE != 0)
		{
			if (SQLCODE == NO_DATA_FOUND )
			{
				break;
			}
			else
			{
				LogCri( "SAMPLE CURSOR Fetch Error = [%d]", SQLCODE);
				EXEC SQL CLOSE TB_FXB_ERR_MSG_C1;
				return(RET_FAILURE);
			}
		}
		else
		{
			//APLog(content->rkey, APLOG_DEBUG, "[%-15s][%4d] 에러코드	[%s]", __FUNCTION__, __LINE__, c_errCd );
			//APLog(content->rkey, APLOG_DEBUG, "[%-15s][%4d] 에러메시지  [%s]", __FUNCTION__, __LINE__, c_errMsg);
			;
		}	

		/* 
		메칭 엔진용 메세지는 따로 정의 ... 
		msg = &Mat->map->msg[ Mat->map->msg_cnt];
		msg->code = AtoI( err_msg->fx_err_cd, sizeof( err_msg->fx_err_cd));
		memcpy( msg->msg, err_msg->err_cd_con, sizeof( msg->msg));
		TrimNR( msg->msg, sizeof( msg->msg));
		Mat->map->msg_cnt++;
		*/

		//로그출력 Level DEBUG
		LogRaw( "[%3d][%s][%s][%.75s][%.6s][%.10s]\n",
			ii,
			err_msg->fx_err_cd,
			err_msg->lngg_dcd			,
			err_msg->err_cd_con			,
			err_msg->fx_sys_lsmd_id	,
			err_msg->fx_sys_lsmd_ts	
			);
		/*
		TB_FXB_CMG004M_Print( dh_pare);
		*/

	}

	EXEC SQL CLOSE TB_FXB_ERR_MSG_C1;

	//--------------------------------------------------------------
	// 정상 처리 세팅 (0:정상, 1:비정상)
	//--------------------------------------------------------------
	LogMsg( "그리드건수 = [%d]", ii);
	return(RET_SUCCESS);
}

/*******************************************************************************
* Function Name : Db_GetSyg001M()
* Description   : 에러 메세지 upload
********************************************************************************/
int Db_GetFixHoliday( MAT_HOLIDAY *holiday)
{
	int			i, cnt;
	int			ii;
	time_t		cur_time;
	struct tm	*tp;
	int			year;
	char		buf[ 128];
	MAT_HOLIDAY_REC *rec;

	EXEC SQL BEGIN DECLARE SECTION;
	FIX_HOLIDAY	_fix_holiday, *fix_holiday = &_fix_holiday;
	EXEC SQL END DECLARE SECTION;

	time( &cur_time);
	tp = localtime( &cur_time);
	year = tp->tm_year + 1900;

	//---------------------------------------------------------------------
	// 4.조회 
	//--------------------------------------------------------------------
	EXEC SQL DECLARE TB_FXB_HOLIDAY_C1 CURSOR FOR
	SELECT
		FDM_ID,
		CRCD,
		FXNG_HLDD_MD,
		FX_HLDD_NM,
		COMNT_CON,
		FX_SYS_LSMD_ID,
		FX_SYS_LSMD_TS
	FROM TB_FXB_CMG010M
	WHERE	CRCD = 'KRW'
	;
	if (SQLCODE != 0)
	{
		LogCri( "TB_FXB_HOLIDAY_C1 CURSOR DECLARE Error = [%d]", SQLCODE);
		return -1;
	}

	EXEC SQL OPEN TB_FXB_HOLIDAY_C1;
	if (SQLCODE != 0)
	{
   		if (SQLCODE == NO_DATA_FOUND)
   		{
			LogCri( "건수없음 SQLCODE=[%d]=================", SQLCODE);
   			return(RET_FAILURE);
   		}
		else
		{
			LogCri( "TB_FXB_HOLIDAY_C1 CURSOR OPEN Error = [%d]", SQLCODE);
			return(RET_FAILURE);
		}
   	}

	for (ii = 0; ;ii++)
	{
		//출력값 메모리 초기화
		memset( fix_holiday, 0x00, sizeof( FIX_HOLIDAY));

	 	EXEC SQL 
		FETCH TB_FXB_HOLIDAY_C1
		INTO
			:fix_holiday->FDM_ID,
			:fix_holiday->CRCD,
			:fix_holiday->FXNG_HLDD_MD,
			:fix_holiday->FX_HLDD_NM,
			:fix_holiday->COMNT_CON,
			:fix_holiday->FX_SYS_LSMD_ID,
			:fix_holiday->FX_SYS_LSMD_TS
			;
		if (SQLCODE != 0)
		{
			if (SQLCODE == NO_DATA_FOUND )
			{
				break;
			}
			else
			{
				LogCri( "TB_FXB_HOLIDAY_C1 CURSOR Fetch Error = [%d]", SQLCODE);
				EXEC SQL CLOSE TB_FXB_HOLIDAY_C1;
				return(RET_FAILURE);
			}
		}

		rec = &holiday->rec[ holiday->cnt];
		sprintf( buf, "%04d%s", year -1, fix_holiday->FXNG_HLDD_MD);
		rec->day = atoi( buf);
		memcpy( rec->str, 		buf, 						strlen( buf));
		memcpy( rec->comment,	fix_holiday->FX_HLDD_NM,	sizeof( rec->comment));
		holiday->cnt++;

		rec = &holiday->rec[ holiday->cnt];
		sprintf( buf, "%04d%s", year, fix_holiday->FXNG_HLDD_MD);
		rec->day = atoi( buf);
		memcpy( rec->str, 		buf, 						strlen( buf));
		memcpy( rec->comment,	fix_holiday->FX_HLDD_NM,	sizeof( rec->comment));
		holiday->cnt++;

		rec = &holiday->rec[ holiday->cnt];
		sprintf( buf, "%04d%s", year +1, fix_holiday->FXNG_HLDD_MD);
		rec->day = atoi( buf);
		memcpy( rec->str, 		buf, 						strlen( buf));
		memcpy( rec->comment,	fix_holiday->FX_HLDD_NM,	sizeof( rec->comment));
		holiday->cnt++;
	}
	LogMsg( "그리드건수 = [%d]", ii);

	EXEC SQL CLOSE TB_FXB_HOLIDAY_C1;

	//--------------------------------------------------------------
	// 정상 처리 세팅 (0:정상, 1:비정상)
	//--------------------------------------------------------------
	return(RET_SUCCESS);
}

/*******************************************************************************
* Function Name : Db_GetSyg001M()
* Description   : 에러 메세지 upload
********************************************************************************/
int Db_GetFltHoliday( MAT_HOLIDAY *holiday)
{
	int			i, cnt;
	int			ii;
	time_t		cur_time;
	struct tm	*tp;
	char		buf[ 128];
	MAT_HOLIDAY_REC *rec;

	EXEC SQL BEGIN DECLARE SECTION;
	char		s_date[ 32], e_date[ 32];
	FIX_HOLIDAY	_fix_holiday, *fix_holiday = &_fix_holiday;
	FLT_HOLIDAY	_flt_holiday, *flt_holiday = &_flt_holiday;
	EXEC SQL END DECLARE SECTION;

	time( &cur_time);
	tp = localtime( &cur_time);
	sprintf( s_date, "%04d", tp->tm_year + 1900 -1);
	sprintf( e_date, "%04d", tp->tm_year + 1900 +2);


	EXEC SQL DECLARE TB_FXB_HOLIDAY_C2 CURSOR FOR
	SELECT
		FDM_ID,
		CRCD,
		FLCT_HLDD_YMD,
		FX_HLDD_NM,
		COMNT_CON,
		FX_SYS_LSMD_ID,
		FX_SYS_LSMD_TS
	FROM TB_FXB_CMG011M
	WHERE	CRCD = 'KRW'
	AND		FLCT_HLDD_YMD > :s_date
	AND		FLCT_HLDD_YMD < :e_date
	;
	if (SQLCODE != 0)
	{
		LogCri( "TB_FXB_HOLIDAY_C2 CURSOR DECLARE Error = [%d]", SQLCODE);
		return -1;
	}

	EXEC SQL OPEN TB_FXB_HOLIDAY_C2;
	if (SQLCODE != 0)
	{
   		if (SQLCODE == NO_DATA_FOUND)
   		{
			LogCri( "건수없음 SQLCODE=[%d]=================", SQLCODE);
   			return(RET_FAILURE);
   		}
		else
		{
			LogCri( "TB_FXB_HOLIDAY_C2 CURSOR OPEN Error = [%d]", SQLCODE);
			return(RET_FAILURE);
		}
   	}

	for (ii = 0; ;ii++)
	{
		//출력값 메모리 초기화
		memset( fix_holiday, 0x00, sizeof( FIX_HOLIDAY));

	 	EXEC SQL 
		FETCH TB_FXB_HOLIDAY_C2
		INTO
			:flt_holiday->FDM_ID,
			:flt_holiday->CRCD,
			:flt_holiday->FLCT_HLDD_YMD,
			:flt_holiday->FX_HLDD_NM,
			:flt_holiday->COMNT_CON,
			:flt_holiday->FX_SYS_LSMD_ID,
			:flt_holiday->FX_SYS_LSMD_TS
			;
		if (SQLCODE != 0)
		{
			if (SQLCODE == NO_DATA_FOUND )
			{
				break;
			}
			else
			{
				LogCri( "TB_FXB_HOLIDAY_C2 CURSOR Fetch Error = [%d]", SQLCODE);
				EXEC SQL CLOSE TB_FXB_HOLIDAY_C2;
				return(RET_FAILURE);
			}
		}

		rec = &holiday->rec[ holiday->cnt];
		sprintf( buf, "%s", flt_holiday->FLCT_HLDD_YMD);
		rec->day = atoi( buf);
		memcpy( rec->str, 		buf, 						strlen( buf));
		memcpy( rec->comment,	flt_holiday->FX_HLDD_NM,	sizeof( rec->comment) -1);
		holiday->cnt++;
	}
	LogMsg( "그리드건수 = [%d]", ii);

	EXEC SQL CLOSE TB_FXB_HOLIDAY_C2;

	//--------------------------------------------------------------
	// 정상 처리 세팅 (0:정상, 1:비정상)
	//--------------------------------------------------------------
	return(RET_SUCCESS);
}

/*******************************************************************************
* Function Name : Db_GetCodFxPair()
